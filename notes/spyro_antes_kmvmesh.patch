+"""ParaView files of the models of a parameter grid.
+
+The models of an inversion are written as one VTK image per iterate and a
+``.pvd`` collection that lists them with the iteration as the time, so
+ParaView plays the iterates as a time series. The collection is rewritten
+after every iterate: *File > Reload Files* in ParaView shows the new ones
+while the inversion runs.
+
+AI assistance: written by Claude (Anthropic), reviewed by the author.
+"""
+from __future__ import annotations
+
+from collections.abc import Sequence
+from pathlib import Path
+
+import numpy as np
+
+from .fwi_functional import ParameterGrid
+
+
+def write_vti(file: Path, grid: ParameterGrid, values: np.ndarray,
+              name: str = "velocity") -> Path:
+    """Write a model of the parameter grid as a VTK image.
+
+    The image lies in the plane of ParaView's X (horizontal position) and Y
+    (depth, negative downwards) axes, in km.
+
+    Parameters
+    ----------
+    file : pathlib.Path
+        File to write, with the ``.vti`` suffix.
+    grid : ParameterGrid
+        Grid of the model.
+    values : numpy.ndarray
+        Model of shape ``grid.shape`` (depth, horizontal position).
+    name : str, optional
+        Name of the field in ParaView.
+
+    Returns
+    -------
+    pathlib.Path
+        The file written.
+    """
+    values = np.asarray(values, dtype=float).reshape(grid.shape)
+    rows, columns = grid.shape
+    z0, x0 = grid.origin
+    if grid.element == "Q1":
+        # Values at the nodes: points of the image.
+        extent = f"0 {columns - 1} 0 {rows - 1} 0 0"
+        origin = f"{x0!r} {z0!r} 0"
+        kind = "PointData"
+    else:
+        # Values at the cell centres: cells of the image.
+        extent = f"0 {columns} 0 {rows} 0 0"
+        origin = f"{x0 - 0.5 * grid.dx!r} {z0 - 0.5 * grid.dz!r} 0"
+        kind = "CellData"
+    # VTK orders the values with X varying fastest, as values.ravel() does.
+    numbers = " ".join(f"{v:.7g}" for v in values.ravel())
+    file = Path(file)
+    file.parent.mkdir(parents=True, exist_ok=True)
+    file.write_text(
+        '<?xml version="1.0"?>\n'
+        '<VTKFile type="ImageData" version="1.0" byte_order="LittleEndian">\n'
+        f'  <ImageData WholeExtent="{extent}" Origin="{origin}" '
+        f'Spacing="{grid.dx!r} {grid.dz!r} 1">\n'
+        f'    <Piece Extent="{extent}">\n'
+        f'      <{kind} Scalars="{name}">\n'
+        f'        <DataArray type="Float64" Name="{name}" format="ascii">\n'
+        f'          {numbers}\n'
+        '        </DataArray>\n'
+        f'      </{kind}>\n'
+        '    </Piece>\n'
+        '  </ImageData>\n'
+        '</VTKFile>\n')
+    return file
+
+
+def write_pvd(file: Path, entries: Sequence[tuple[float, Path]]) -> Path:
+    """Write a ParaView collection of files indexed by time.
+
+    Parameters
+    ----------
+    file : pathlib.Path
+        Collection to write, with the ``.pvd`` suffix.
+    entries : sequence of (float, pathlib.Path)
+        Time of each file and the file, relative to the collection or
+        absolute.
+
+    Returns
+    -------
+    pathlib.Path
+        The file written.
+    """
+    file = Path(file)
+    lines = ['<?xml version="1.0"?>',
+             '<VTKFile type="Collection" version="1.0" '
+             'byte_order="LittleEndian">',
+             '  <Collection>']
+    for time, path in entries:
+        path = Path(path)
+        if path.is_absolute():
+            path = path.relative_to(file.parent.resolve())
+        lines.append(f'    <DataSet timestep="{time:g}" part="0" '
+                     f'file="{path.as_posix()}"/>')
+    lines += ['  </Collection>', '</VTKFile>']
+    # Write then rename, so ParaView never reads half a collection.
+    partial = file.with_suffix(".pvd.part")
+    partial.write_text("\n".join(lines) + "\n")
+    partial.replace(file)
+    return file
