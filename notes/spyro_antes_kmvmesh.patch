+def test_observed_data_resampling() -> None:
+    """Resampling on the own time axis of the record returns the record."""
+    rng = np.random.default_rng(2)
+    record = rng.standard_normal((40, 3))
+    observed = ObservedData([record], 2e-3)
+    assert np.allclose(observed.at(0, 40, 2e-3), record)
+    half = observed.at(0, 80, 1e-3)
+    assert np.allclose(half[1::2], record)
+
+
+@pytest.mark.parametrize("element, cutoff, transfer", [
+    ("Q1", None, "projection"), ("DG0", 6.0, "projection"), ("Q1", None, "sampling")])
+def test_fwi_functional_taylor(tmp_path, element: str, cutoff, transfer: str) -> None:
+    """Second-order Taylor remainder of the complete chain."""
+    data = dictionary()
+    observed = synthesize_observations(
+        data, two_layer, cpw_mesh(tmp_path / "observed.msh", 4.0))
+    grid = ParameterGrid(DOMAIN, 0.05, element)
+    Z, X = grid_positions(grid)
+    model = 1.5 + 0.8 * (Z < -0.35) + 0.1 * np.sin(6 * X)
+    functional = FWIFunctional(
+        data, cpw_mesh(tmp_path / "inversion.msh", 3.0), grid, model, observed,
+        TraceOperator(late_window, cutoff), upper_bound=3.0, transfer=transfer)
+    value = functional(grid.function(model))
+    derivative = functional.derivative_array()
+    assert functional.forwards == 2 and functional.adjoints == 2
+    direction = 0.2 * np.random.default_rng(3).standard_normal(grid.shape)
+    slope = np.sum(derivative * direction)
+    remainders = []
+    for step in (1e-2, 5e-3, 2.5e-3):
+        perturbed = functional(grid.function(model + step * direction))
+        remainders.append(abs(perturbed - value - step * slope))
+    rates = np.log2(np.array(remainders[:-1]) / np.array(remainders[1:]))
+    assert np.all(rates > 1.9)
+    # The time step is the one of the upper bound: fixed for every model.
+    assert functional.steps == int(0.6 / functional.dt) + 1
+
+
+@pytest.mark.parametrize("discontinuous", [False, True])
+def test_fwi_functional_taylor_fixed_layer(tmp_path, discontinuous: bool) -> None:
+    """With a fixed water layer and the gradient mask the chain stays exact."""
+    data = dictionary()
+    observed = synthesize_observations(
+        data, two_layer, cpw_mesh(tmp_path / "observed.msh", 4.0))
+    grid = ParameterGrid(DOMAIN, 0.05, "Q1", fixed_layer=(INTERFACE, 1.5))
+    Z, X = grid_positions(grid)
+    water = grid.above_layer(Z)
+    model = np.where(water, 1.5, 2.2 + 0.1 * np.sin(6 * X))
+    functional = FWIFunctional(
+        data, cpw_mesh(tmp_path / "inversion.msh", 3.0), grid, model, observed,
+        TraceOperator(), upper_bound=3.0, gradient_mask=(~water).astype(float),
+        discontinuous_velocity=discontinuous)
+    value = functional(grid.function(model))
+    derivative = functional.derivative_array()
+    assert np.all(derivative[water] == 0.0)
+    assert np.any(derivative[~water] != 0.0)
+    # The direction also moves the water values, which J does not see.
+    direction = 0.2 * np.random.default_rng(5).standard_normal(grid.shape)
+    slope = np.sum(derivative * direction)
+    remainders = []
+    for step in (1e-2, 5e-3, 2.5e-3):
+        perturbed = functional(grid.function(model + step * direction))
+        remainders.append(abs(perturbed - value - step * slope))
+    rates = np.log2(np.array(remainders[:-1]) / np.array(remainders[1:]))
+    assert np.all(rates > 1.9)
+
