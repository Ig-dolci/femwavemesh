+def geometry(n_sources: int = N_SOURCES, n_receivers: int = N_RECEIVERS
+             ) -> tuple[RectangularDomain, list, list, float]:
+    """Domain and acquisition in the local positions of the tests.
+
+    Parameters
+    ----------
+    n_sources : int, optional
+        Sources at 50 m depth, one at the centre of each of ``n_sources``
+        equal parts of the window. Default ``N_SOURCES``.
+    n_receivers : int, optional
+        Receivers at 100 m depth, evenly from one end of the window to the
+        other. Default ``N_RECEIVERS``.
+
+    Returns
+    -------
+    tuple
+        Domain with the pad, sources, receivers (``(z, x)`` in km) and the
+        position of Marmousi2 subtracted from ``x``.
+    """
+    offset = X_RANGE[0] - PAD
+    x0, x1 = PAD, X_RANGE[1] - offset
+    domain = RectangularDomain(z_min=-DEPTH - PAD, x_min=0.0, x_max=x1 + PAD,
+                               pad=PAD)
+    sources = [(-0.05, x0 + (i + 0.5) * (x1 - x0) / n_sources)
+               for i in range(n_sources)]
+    receivers = [(-0.10, x) for x in np.linspace(x0, x1, n_receivers)]
+    return domain, sources, receivers, offset
+
+
+def shot_ensemble(args: argparse.Namespace) -> fire.Ensemble:
+    """Ensemble of the shots.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+
+    Returns
+    -------
+    firedrake.Ensemble
+        Members of ``--spatial`` processes each; their number must divide the
+        number of shots.
+    """
+    if fire.COMM_WORLD.size % args.spatial:
+        raise SystemExit("The number of processes must be a multiple of --spatial.")
+    if args.sources % (fire.COMM_WORLD.size // args.spatial):
+        raise SystemExit("The number of ensemble members must divide --sources.")
+    return fire.Ensemble(fire.COMM_WORLD, args.spatial)
+
