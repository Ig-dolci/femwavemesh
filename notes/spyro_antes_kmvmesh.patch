@@ -0,0 +1,668 @@
+"""Audit initial-model meshes under three size ceilings, without optimization.
+
+Notes
+-----
+Implemented with assistance from Codex (OpenAI) for the authorized layer test.
+The FWI loop and its default behavior are not modified.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import time
+from typing import Callable
+
+import numpy as np
+from scipy.interpolate import CubicSpline
+
+import marmousi_fwi as marm
+from spyro.adaptivity import MeshAdaptiveFWI, MeshPolicy, ObservedData, TraceOperator
+from spyro.adaptivity.mesh_generation import (
+    count_kmv_dofs, generate_mesh, read_triangulation)
+from spyro.adaptivity.size_fields import (
+    AdaptiveSizeField, VelocityGrid, adjoint_density, gradient_density,
+    size_perturbation)
+
+
+def digest(path: Path) -> str:
+    """Hash a file.
+
+    Parameters
+    ----------
+    path : pathlib.Path
+        Existing file.
+
+    Returns
+    -------
+    str
+        SHA256 digest.
+    """
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def setup(args: argparse.Namespace) -> tuple[MeshAdaptiveFWI, TraceOperator, dict]:
+    """Recreate the protocol's model, observations and policy.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Campaign, strategy and output paths.
+
+    Returns
+    -------
+    tuple
+        Audit driver, processing operator and original policy.
+    """
+    base = args.campaign
+    args.model = str(base / "experiments/kmv4_cpw_calibration/data/marmousi_window.npz")
+    args.initial_model = str(base / ("experiments/kmv4_cpw_calibration/data/"
+                                     "marmousi_window_s250.npz"))
+    args.sources, args.receivers, args.spatial = 8, 101, 1
+    args.frequency, args.final_time, args.degree = 5.0, 2.0, 4
+    args.grid_spacing, args.sigma = 0.05, 0.4
+    domain, sources, receivers, offset = marm.geometry(8, 101)
+    ensemble = marm.shot_ensemble(args)
+    grid, true, initial, water = marm.grid_models(
+        args, domain, offset, ensemble.comm)
+    operator = TraceOperator(marm.reflection_window(sources, receivers, 5.0, 0.12))
+    stored = np.load(base / "results/data_marmousi.npz")
+    records = [np.array(record) for record in stored["records"]]
+    dt = float(stored["dt"])
+    noise = [0.05 * operator.norm(operator.apply(d, dt, s), dt)
+             for s, d in enumerate(records)]
+    rng = np.random.default_rng(1)
+    for shot, record in enumerate(records):
+        sample = rng.standard_normal(record.shape)
+        norm = operator.norm(operator.apply(sample, dt, shot), dt)
+        record += noise[shot] / norm * sample
+    original = json.loads((base / "results/seed1/cpw_fixed/report_fwi.json")
+                          .read_text())["policy"]
+    if not np.array_equal(noise, original["noise_level"]):
+        raise RuntimeError("Noise differs from the seed-1 protocol policy")
+    values = dict(original, strategy=args.strategy)
+    policy = MeshPolicy(**values)
+    differences = {k: (v, asdict(policy)[k]) for k, v in values.items()
+                   if json.dumps(v) != json.dumps(asdict(policy)[k])}
+    if differences:
+        raise RuntimeError(f"Policy differences: {differences}")
+    args.output.mkdir(parents=True, exist_ok=True)
+    (args.output / "meshes").mkdir(exist_ok=True)
+    fwi = MeshAdaptiveFWI(
+        marm.model_dictionary(args, domain, sources, receivers),
+        domain, grid, initial, ObservedData(records, dt), [], policy,
+        bounds=(np.full(grid.shape, marm.WATER_VELOCITY),
+                np.where(water, marm.WATER_VELOCITY, 1.1 * float(true.max()))),
+        output_dir=args.output, window=operator.window,
+        audit_window=operator.window, conforming_depths=[marm.SEA_FLOOR],
+        gradient_mask=(~water).astype(float), discontinuous_velocity=True,
+        store_forward=False, ensemble=ensemble)
+    return fwi, operator, original
+
+
+def bracket_budget(generate: Callable[[float], int], history: list,
+                   target: int, tolerance: float, increasing: bool) -> int:
+    """Bracket a mesh budget when the multiplicative rescaling oscillates.
+
+    Parameters
+    ----------
+    generate : callable
+        Generate a mesh at a scalar CPW or adaptive scale and return its DOFs.
+    history : list
+        Measured ``(parameter, DOFs)`` pairs, extended by this search.
+    target : int
+        Requested DOFs.
+    tolerance : float
+        Allowed relative budget error.
+    increasing : bool
+        Whether increasing the scalar increases the expected DOF count.
+
+    Returns
+    -------
+    int
+        DOFs of the last generated mesh, within tolerance when attainable.
+    """
+    for attempt in range(40):
+        ordered = sorted(history)
+        brackets = [(a, b) for a, b in zip(ordered, ordered[1:])
+                    if (a[1] - target) * (b[1] - target) < 0]
+        if brackets:
+            a, b = min(brackets, key=lambda pair: math.log(pair[1][0] / pair[0][0]))
+            parameter = math.sqrt(a[0] * b[0])
+            if b[0] / a[0] - 1 < 1e-10:
+                # Escape a discontinuous mesher branch without altering its seed.
+                best = min(history, key=lambda item: abs(item[1] - target))
+                parameter = best[0] * math.exp(0.01 * math.sin(attempt + 1))
+        else:
+            _, dofs = min(history, key=lambda item: abs(item[1] - target))
+            direction = 1 if (dofs < target) == increasing else -1
+            # Advance beyond every tested candidate, including flat DOF plateaus.
+            extreme = max if direction > 0 else min
+            parameter = extreme(item[0] for item in history)
+            parameter *= math.exp(0.2 * direction)
+        dofs = generate(parameter)
+        history.append((parameter, dofs))
+        if abs(dofs / target - 1) <= tolerance:
+            return dofs
+    return dofs
+
+
+def designed_mesh(fwi: MeshAdaptiveFWI, tag: str, target: int,
+                  rule: str, seed: int = 0, attempts: int = 6,
+                  record_size: bool = False) -> tuple[Path, int]:
+    """Copy the protocol design, changing only the specified ceiling.
+
+    Parameters
+    ----------
+    fwi : MeshAdaptiveFWI
+        Initialized driver with the pilot density and CPW calibration.
+    tag : str
+        Mesh label.
+    target : int
+        DOF budget.
+    rule : str
+        A: protocol; B: lock layer to equivalent CPW; C: pilot ceiling.
+    seed : int, optional
+        Paired 3 percent size-field replica; zero is unperturbed.
+    attempts : int, optional
+        Maximum budget rescalings; six reproduces the protocol.
+    record_size : bool, optional
+        Persist the final size field and its active constraints.
+
+    Returns
+    -------
+    tuple
+        Mesh file and measured DOFs.
+    """
+    if rule not in ("A", "B", "C"):
+        raise ValueError(rule)
+    p = fwi.policy
+    path = fwi._new_name(tag)
+    velocity = fwi._velocity()
+    ceiling = velocity / (p.cpw_floor * 5.0)
+    design = fwi._design
+    equivalent = fwi._equivalent_cpw(target, 5.0)
+    factor = size_perturbation(velocity.shape, p.grid_spacing, seed)
+
+    def build() -> int:
+        """Generate a mesh under the selected size constraints.
+
+        Returns
+        -------
+        int
+            Measured DOFs. Matrix runs can bracket an oscillating budget;
+            the six-attempt protocol reproduction keeps its original path.
+        """
+        if p.strategy == "cpw":
+            cpw = max(equivalent, p.cpw_floor)
+            h, fitted = velocity, cpw
+            history = []
+
+            def uniform(value: float) -> int:
+                """Generate a CPW mesh at one candidate scalar.
+
+                Parameters
+                ----------
+                value : float
+                    Candidate cells per wavelength.
+
+                Returns
+                -------
+                int
+                    Measured degrees of freedom.
+                """
+                nonlocal h, fitted
+                fitted = value
+                h = np.minimum(velocity / (value * 5.0), ceiling)
+                if seed:
+                    h = h * factor
+                generate_mesh(path, fwi.domain, VelocityGrid(
+                    h, fwi.z[0], fwi.x[0], p.grid_spacing, p.grid_spacing),
+                    fwi.conforming_depths)
+                return count_kmv_dofs(read_triangulation(path)[1], fwi.degree)
+
+            for _ in range(attempts):
+                dofs = uniform(cpw)
+                history.append((cpw, dofs))
+                if abs(dofs / target - 1.0) <= p.dof_tolerance:
+                    break
+                cpw *= math.sqrt(target / dofs)
+            if attempts > 6 and abs(dofs / target - 1) > p.dof_tolerance:
+                dofs = bracket_budget(uniform, history, target, p.dof_tolerance, True)
+            if record_size:
+                np.savez_compressed(path.with_suffix(".size.npz"), h=h,
+                                    floor=h, ceiling=h, factor=factor,
+                                    equivalent_cpw=equivalent, fitted_cpw=fitted)
+                path.with_suffix(".budget.json").write_text(json.dumps(history))
+            return dofs
+        maximum = None if rule == "C" else ceiling.copy()
+        layer_size = velocity / (equivalent * 5.0)
+        if rule == "B":
+            maximum[~fwi.interior] = layer_size[~fwi.interior]
+        size = AdaptiveSizeField(design["density"], design["size"],
+                                 fwi.z, fwi.x, p.order, ceiling=maximum)
+        size.set_floor(velocity, 5.0, equivalent, p.cmax_ratio)
+        if rule == "B":
+            size.h_min[~fwi.interior] = layer_size[~fwi.interior]
+        scale = size.scale_for(target / design["calibration"])
+        history = []
+
+        def adaptive(value: float) -> int:
+            """Generate an adaptive mesh at one candidate scale.
+
+            Parameters
+            ----------
+            value : float
+                Candidate scale of the unchanged clipped size law.
+
+            Returns
+            -------
+            int
+                Measured degrees of freedom.
+            """
+            size.set_scale(value)
+            field = size.grid.scaled(factor) if seed else size.grid
+            generate_mesh(path, fwi.domain, field, fwi.conforming_depths)
+            return count_kmv_dofs(read_triangulation(path)[1], fwi.degree)
+
+        for _ in range(attempts):
+            dofs = adaptive(scale)
+            history.append((scale, dofs))
+            if abs(dofs / target - 1.0) <= p.dof_tolerance:
+                break
+            scale *= math.sqrt(dofs / target)
+        if attempts > 6 and abs(dofs / target - 1) > p.dof_tolerance:
+            dofs = bracket_budget(adaptive, history, target, p.dof_tolerance, False)
+        if record_size:
+            np.savez_compressed(path.with_suffix(".size.npz"),
+                                h=size.h * factor, floor=size.h_min * factor,
+                                ceiling=size.h_max * factor, factor=factor,
+                                equivalent_cpw=equivalent)
+            path.with_suffix(".budget.json").write_text(json.dumps(history))
+        return dofs
+
+    return path, fwi._on_root(build)
+
+
+def save_audit(fwi: MeshAdaptiveFWI, operator: TraceOperator,
+               mesh: Path, audit: object, label: str) -> dict:
+    """Persist audit numbers and native-time traces from all shots.
+
+    Parameters
+    ----------
+    fwi : MeshAdaptiveFWI
+        Driver with the cached audit propagations.
+    operator : TraceOperator
+        Common processing operator.
+    mesh : pathlib.Path
+        Audited mesh.
+    audit : Audit
+        Completed audit.
+    label : str
+        Output label.
+
+    Returns
+    -------
+    dict
+        Audit numbers, hashes and propagation cost.
+    """
+    entry = audit.summary()
+    traces = {}
+    for level in ("coarse", "half", "fine"):
+        functional = fwi._functional(mesh, operator, level)
+        gathered = fwi.pilot.gather_shots(
+            dict(zip(functional.shots, functional.records)))
+        if fwi._root:
+            for shot, record in gathered.items():
+                name = f"{level}_{shot}"
+                entry.setdefault("trace_sha256", {})[name] = hashlib.sha256(
+                    np.ascontiguousarray(record).tobytes()).hexdigest()
+                if level != "fine":
+                    traces[name] = record
+        if level == "coarse":
+            entry["steps"] = functional.steps
+            entry["propagation_work"] = functional.dofs * functional.steps * 8
+    if fwi._root:
+        entry["mesh_sha256"] = digest(mesh)
+        entry["cells"] = len(read_triangulation(mesh)[1])
+        traces["dt"] = audit.dt
+        np.savez_compressed(fwi.output_dir / f"{label}_traces.npz", **traces)
+        (fwi.output_dir / f"{label}.json").write_text(json.dumps(entry, indent=2))
+    # Keep workers from leaving while root is still compressing/writing traces.
+    return fwi._on_root(lambda: entry)
+
+
+def gate_zero(args: argparse.Namespace) -> None:
+    """Reproduce the seed-1 pilot and two designs of one strategy.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line paths and strategy.
+
+    Returns
+    -------
+    None
+        Gate evidence is saved before any reference or matrix runs.
+    """
+    started = time.perf_counter()
+    fwi, operator, original = setup(args)
+    historical = json.loads((args.campaign / "results/seed1"
+                             / f"{args.strategy}_fixed/report_fwi.json").read_text())
+    expected = [e for e in historical["events"]
+                if e["event"] in ("stage_pilot", "verification")][:3]
+    # The first mesh calibrates equivalent CPW in the original initial phase.
+    for cpw in (1.33, 1.995, 2.9925):
+        mesh, dofs = fwi._cpw_mesh(cpw, 5.0)
+    fwi.mesh, fwi.dofs = mesh, dofs
+    cache = args.output / "pilot_design.npz"
+    pilot_json = args.output / "pilot.json"
+    if args.resume_gate0 and cache.exists() and pilot_json.exists():
+        cached = json.loads(pilot_json.read_text())
+        if cached["mesh_sha256"] != digest(mesh):
+            raise RuntimeError("Cached pilot mesh changed")
+        design = np.load(cache)
+        fwi._design = {
+            "density": None if args.strategy == "cpw" else design["density"],
+            "size": design["size"], "calibration": float(design["calibration"])}
+        if float(design["cpw_calibration"]) != fwi._cpw_calibration:
+            raise RuntimeError("Cached CPW calibration changed")
+        entries = [cached]
+    else:
+        pilot = fwi._audit(mesh, operator, pilot=True,
+                           indicator=args.strategy == "adjoint")
+        size, dofs = fwi._mesh_size(mesh)
+        smoothing = fwi._smoothing(5.0)
+        density = None
+        if args.strategy == "adjoint":
+            result = pilot.result
+            density = fwi._on_root(lambda: adjoint_density(
+                result.centroids, result.indicators,
+                np.array(pilot.pilot_relative_errors) ** 2,
+                fwi.z, fwi.x, smoothing))
+        elif args.strategy == "gradient":
+            density = gradient_density(fwi._velocity(), fwi.policy.grid_spacing,
+                                       smoothing, fwi.interior)
+        calibration = dofs / float((size ** -2).sum() * fwi.policy.grid_spacing ** 2)
+        fwi._design = {"density": density, "size": size, "calibration": calibration}
+        if fwi._root:
+            np.savez_compressed(cache, size=size, density=density,
+                                calibration=calibration,
+                                cpw_calibration=fwi._cpw_calibration)
+        entries = [save_audit(fwi, operator, mesh, pilot, "pilot")]
+    for index, event in enumerate(expected[1:]):
+        mesh, dofs = designed_mesh(fwi, f"stage{index}", event["target_dofs"], "A")
+        cached_json = args.output / f"stage{index}.json"
+        if args.resume_gate0 and cached_json.exists():
+            cached = json.loads(cached_json.read_text())
+            if cached["mesh_sha256"] != digest(mesh):
+                raise RuntimeError("Cached stage mesh changed")
+            entries.append(cached)
+        else:
+            audit = fwi._audit(mesh, operator)
+            entries.append(save_audit(fwi, operator, mesh, audit, f"stage{index}"))
+    checks = []
+    for actual, event in zip(entries, expected):
+        old_mesh = (args.campaign / "results/seed1"
+                    / f"{args.strategy}_fixed/meshes" / event["mesh"])
+        ratio_change = abs(actual["worst_E_over_tau"]
+                           / event["worst_E_over_tau"] - 1.0)
+        checks.append({"mesh": actual["mesh"], "dofs": actual["dofs"],
+                       "expected_dofs": event["dofs"],
+                       "E_over_tau": actual["worst_E_over_tau"],
+                       "expected_E_over_tau": event["worst_E_over_tau"],
+                       "relative_ratio_change": ratio_change,
+                       "same_mesh_sha256": actual["mesh_sha256"] == digest(old_mesh),
+                       "passed": actual["dofs"] == event["dofs"]
+                       and ratio_change <= 0.01})
+    if fwi._root:
+        report = {"passed": all(c["passed"] for c in checks), "checks": checks,
+                  "policy_original": original, "policy_actual": asdict(fwi.policy),
+                  "store_forward": False, "fwi_iterations": 0,
+                  "elapsed_s": time.perf_counter() - started,
+                  "rank_affinity": fwi.ensemble.global_comm.gather(
+                      sorted(os.sched_getaffinity(0)), root=0)}
+        (args.output / "gate0.json").write_text(json.dumps(report, indent=2))
+    else:
+        fwi.ensemble.global_comm.gather(sorted(os.sched_getaffinity(0)), root=0)
+
+
+def reference(args: argparse.Namespace) -> None:
+    """Propagate the noiseless s250 reference with the protocol generator.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Reference mesh size and critical-time-step fraction.
+
+    Returns
+    -------
+    None
+        Resampled traces and provenance are saved alongside the mesh.
+    """
+    started = time.perf_counter()
+    fwi, operator, _ = setup(args)
+    _, _, _, offset = marm.geometry(8, 101)
+    velocity = marm.true_velocity(args.initial_model, offset)
+    pilot = marm.TwoLevelPilot(fwi.dictionary, velocity,
+                               discontinuous_velocity=True, ensemble=fwi.ensemble)
+    path = args.output / "meshes/reference.msh"
+    marm.data_mesh(args, fwi.domain, velocity, path, args.reference_size)
+    target_dt = 0.001
+    target = (np.arange(2000) + 1) * target_dt
+    if args.reference_dt_fraction == 0.5:
+        records, dt, dofs, elapsed = marm.records_on(pilot, path, target)
+    else:
+        mesh = pilot.load_meshes(str(path))[0]
+        dt = args.reference_dt_fraction * pilot.critical_time_step(mesh)
+        dofs = pilot._wave(0, mesh).function_space.dim()
+        propagation_started = time.perf_counter()
+        records = []
+        for record in pilot.shot_records(mesh, dt).values():
+            times = (np.arange(len(record)) + 1) * dt
+            records.append(CubicSpline(times, record, axis=0)(
+                np.clip(target, times[0], times[-1])))
+        elapsed = time.perf_counter() - propagation_started
+    if fwi._root:
+        records = np.array(records)
+        np.savez_compressed(args.output / "reference_traces.npz",
+                            records=records, dt=target_dt, native_dt=dt)
+        entry = {"size_km": args.reference_size,
+                 "dt_fraction": args.reference_dt_fraction,
+                 "native_dt": dt, "stored_dt": target_dt, "dofs": dofs,
+                 "propagation_s": elapsed,
+                 "elapsed_s": time.perf_counter() - started,
+                 "velocity": args.initial_model, "noise": False,
+                 "velocity_sha256": digest(Path(args.initial_model)),
+                 "mesh_sha256": digest(path),
+                 "traces_sha256": hashlib.sha256(records.tobytes()).hexdigest(),
+                 "windowed_norm_per_shot": [
+                     operator.norm(operator.apply(d, target_dt, s), target_dt)
+                     for s, d in enumerate(records)]}
+        (args.output / "reference.json").write_text(json.dumps(entry, indent=2))
+
+
+def region_masks(domain: object, z: np.ndarray, x: np.ndarray) -> dict:
+    """Partition points into physical water, two rock depths and the layer.
+
+    Parameters
+    ----------
+    domain : RectangularDomain
+        Physical window and absorbing pad.
+    z, x : numpy.ndarray
+        Point coordinates in the local geometry (km).
+
+    Returns
+    -------
+    dict
+        Disjoint masks whose union covers the domain.
+    """
+    inside = domain.in_interior(z, x)
+    return {"water": inside & (z > marm.SEA_FLOOR),
+            "rock_045_1": inside & (z <= marm.SEA_FLOOR) & (z >= -1.0),
+            "rock_1_16": inside & (z < -1.0), "layer": ~inside}
+
+
+def prepare_pilot(args: argparse.Namespace) -> None:
+    """Audit one prescribed pilot and persist both protocol densities.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Pilot name, campaign and output directory.
+
+    Returns
+    -------
+    None
+        The size, calibration, densities and regional masses are saved.
+    """
+    fwi, operator, _ = setup(args)
+    fwi._cpw_mesh(1.33, 5.0)
+    mesh, dofs = fwi._cpw_mesh(2.9925 if args.pilot == "P3" else 1.995, 5.0)
+    audit = fwi._audit(mesh, operator, pilot=True, indicator=True)
+    result = audit.result
+    size, dofs = fwi._mesh_size(mesh)
+    adjoint = fwi._on_root(lambda: adjoint_density(
+        result.centroids, result.indicators,
+        np.array(audit.pilot_relative_errors) ** 2,
+        fwi.z, fwi.x, fwi._smoothing(5.0)))
+    gradient = gradient_density(fwi._velocity(), fwi.policy.grid_spacing,
+                                fwi._smoothing(5.0), fwi.interior)
+    save_audit(fwi, operator, mesh, audit, "pilot")
+    if fwi._root:
+        calibration = dofs / float((size ** -2).sum() * fwi.policy.grid_spacing ** 2)
+        np.savez_compressed(args.output / "design.npz", size=size,
+                            adjoint=adjoint, gradient=gradient,
+                            calibration=calibration,
+                            cpw_calibration=fwi._cpw_calibration)
+        masks = region_masks(fwi.domain, fwi._Z, fwi._X)
+        masses = {name: {strategy: float(density[mask].sum() / density.sum())
+                         for strategy, density in (("adjoint", adjoint),
+                                                   ("gradient", gradient))}
+                  for name, mask in masks.items()}
+        combined = np.zeros(result.indicators.shape[1])
+        for weight, indicator in zip(np.array(audit.pilot_relative_errors) ** 2,
+                                     np.abs(result.indicators)):
+            if indicator.sum() > 0:
+                combined += weight * indicator / indicator.sum()
+        masks = region_masks(fwi.domain, result.centroids[:, 0],
+                             result.centroids[:, 1])
+        for name, mask in masks.items():
+            masses[name]["raw_adjoint_indicator"] = float(
+                combined[mask].sum() / combined.sum())
+        (args.output / "indicator_regions.json").write_text(json.dumps(masses, indent=2))
+
+
+def mesh_regions(fwi: MeshAdaptiveFWI, mesh: Path, velocity: object) -> dict:
+    """Measure area-weighted CPW and active size limits in disjoint regions.
+
+    Parameters
+    ----------
+    fwi : MeshAdaptiveFWI
+        Driver defining the design grid and physical window.
+    mesh : pathlib.Path
+        Mesh with its final size-grid sidecar.
+    velocity : VelocityGrid
+        Original s250 velocity, sampled at triangle centroids.
+
+    Returns
+    -------
+    dict
+        Regional CPW, area fractions and active-limit grid fractions.
+    """
+    points, triangles = read_triangulation(mesh)
+    vertices = points[triangles]
+    edges = vertices[:, 1:] - vertices[:, :1]
+    areas = 0.5 * np.abs(edges[:, 0, 0] * edges[:, 1, 1]
+                         - edges[:, 0, 1] * edges[:, 1, 0])
+    centers = vertices.mean(axis=1)
+    h = np.sqrt(4 * areas / np.sqrt(3.0))
+    cpw = velocity(centers[:, 0], centers[:, 1]) / (5.0 * h)
+    masks = region_masks(fwi.domain, centers[:, 0], centers[:, 1])
+    grids = region_masks(fwi.domain, fwi._Z, fwi._X)
+    field = np.load(mesh.with_suffix(".size.npz"))
+    output = {}
+    for name, mask in masks.items():
+        area = areas[mask].sum()
+        grid_mask = grids[name]
+        output[name] = {
+            "area_km2": float(area),
+            "mean_C": float((areas[mask] * cpw[mask]).sum() / area),
+            "area_fraction_C_le_1p5": float(areas[mask & (cpw <= 1.5)].sum() / area),
+            "area_fraction_C_le_1p7": float(areas[mask & (cpw <= 1.7)].sum() / area),
+            "floor_active_fraction": float(np.isclose(
+                field["h"][grid_mask], field["floor"][grid_mask],
+                rtol=1e-10, atol=1e-12).mean()),
+            "ceiling_active_fraction": float(np.isclose(
+                field["h"][grid_mask], field["ceiling"][grid_mask],
+                rtol=1e-10, atol=1e-12).mean())}
+    return output
+
+
+def matrix_case(args: argparse.Namespace) -> None:
+    """Design and audit one matrix or paired-replica mesh at the initial model.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Pilot, rule, strategy, budget, replica and directory paths.
+
+    Returns
+    -------
+    None
+        Audit traces and all mesh measurements are saved for final analysis.
+    """
+    started = time.perf_counter()
+    fwi, operator, _ = setup(args)
+    design = np.load(args.results / "pilots" / args.pilot / "design.npz")
+    fwi._cpw_calibration = float(design["cpw_calibration"])
+    fwi._design = {"size": design["size"],
+                   "calibration": float(design["calibration"]),
+                   "density": None if args.strategy == "cpw" else design[args.strategy]}
+    mesh, dofs = designed_mesh(fwi, "matrix", args.budget, args.rule,
+                               seed=args.seed, attempts=24, record_size=True)
+    if abs(dofs / args.budget - 1.0) > fwi.policy.dof_tolerance:
+        raise RuntimeError(f"Budget not reached within tolerance: {dofs}/{args.budget}")
+    audit = fwi._audit(mesh, operator)
+    entry = save_audit(fwi, operator, mesh, audit, "audit")
+    if fwi._root:
+        _, _, _, offset = marm.geometry(8, 101)
+        velocity = marm.true_velocity(args.initial_model, offset)
+        entry.update(pilot=args.pilot, strategy=args.strategy, rule=args.rule,
+                     budget=args.budget, replica=args.seed,
+                     regions=mesh_regions(fwi, mesh, velocity),
+                     elapsed_s=time.perf_counter() - started)
+        entry["budget_history"] = json.loads(mesh.with_suffix(".budget.json").read_text())
+        (args.output / "case.json").write_text(json.dumps(entry, indent=2))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--campaign", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--strategy", choices=("cpw", "adjoint", "gradient"),
+                        default="cpw")
+    parser.add_argument("--mode", choices=("gate0", "reference", "pilot", "case"),
+                        default="gate0")
+    parser.add_argument("--reference-size", type=float, default=0.0125)
+    parser.add_argument("--reference-dt-fraction", type=float, default=0.5)
+    parser.add_argument("--results", type=Path)
+    parser.add_argument("--pilot", choices=("P2", "P3"), default="P3")
+    parser.add_argument("--rule", choices=("A", "B", "C"), default="A")
+    parser.add_argument("--budget", type=int, default=4150)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--resume-gate0", action="store_true")
+    arguments = parser.parse_args()
+    if arguments.mode == "gate0":
+        gate_zero(arguments)
+    elif arguments.mode == "reference":
+        reference(arguments)
+    elif arguments.mode == "pilot":
+        prepare_pilot(arguments)
+    else:
+        matrix_case(arguments)
