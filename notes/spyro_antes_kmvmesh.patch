+++ b/demos/mesh_adaptive_fwi/compare_circle_cases.py
@@ -0,0 +1,309 @@
+"""Table and figures of the cases of ``run_circle_fwi.sh``, finished or running.
+
+Usage::
+
+    python compare_circle_cases.py <directory with one folder per case> [iteration]
+
+Writes ``comparison.md``, ``comparison_misfit.png`` (misfit and degrees of
+freedom by iteration) and ``comparison_models.png`` (true, starting and
+latest model of each case, with a horizontal profile through the disc) in
+that directory. A running case shows its latest saved iterate. With an
+iteration, the models of every case at that iteration are also drawn, in
+``comparison_models_iter<k>.png``.
+
+AI assistance: written by Claude (Anthropic), reviewed by the author.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+import numpy as np  # noqa: E402
+
+# This checkout of spyro, not an installed one, and the demo next to it.
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+CASES = ["uniform"] + [f"{strategy}_{mode}"
+                       for strategy in ("cpw", "gradient", "adjoint")
+                       for mode in ("fixed", "update")]
+#: One colour per case: a light and a dark shade of each strategy.
+COLOURS = {"uniform": "k", "cpw_fixed": "#74a9cf", "cpw_update": "#045a8d",
+           "gradient_fixed": "#a1d99b", "gradient_update": "#006d2c",
+           "adjoint_fixed": "#fdae6b", "adjoint_update": "#a63603"}
+
+
+def style(name: str) -> tuple[str, str, str]:
+    """Colour, line and marker of a case.
+
+    Parameters
+    ----------
+    name : str
+        Case name.
+
+    Returns
+    -------
+    tuple of str
+        Matplotlib colour, line style and marker: a colour of its own, a
+        dashed line with crosses for the fixed meshes, a solid line with
+        dots otherwise.
+    """
+    fixed = name.endswith("fixed")
+    return COLOURS[name], "--" if fixed else "-", "x" if fixed else "o"
+
+
+def load(root: Path) -> dict:
+    """Read the cases that have a report.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory with one folder per case.
+
+    Returns
+    -------
+    dict
+        By case: ``report``, ``summary`` (``None`` while it runs) and
+        ``latest`` (last saved model, with its iteration).
+    """
+    cases = {}
+    for name in CASES:
+        folder = root / name
+        if not (folder / "report_fwi.json").exists():
+            continue
+        iterates = sorted(folder.glob("model_iter*.npy"))
+        summary = folder / "summary.json"
+        cases[name] = {
+            "report": json.loads((folder / "report_fwi.json").read_text()),
+            "summary": json.loads(summary.read_text()) if summary.exists() else None,
+            "latest": (np.load(iterates[-1]),
+                       int(iterates[-1].stem.removeprefix("model_iter")))
+            if iterates else None}
+    return cases
+
+
+def reference_models(root: Path) -> tuple[np.ndarray, np.ndarray]:
+    """True and starting models on the grid.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+
+    Returns
+    -------
+    tuple of numpy.ndarray
+        From a finished case, or rebuilt from ``circle_fwi.py`` otherwise.
+    """
+    finished = sorted(root.glob("*/model_true.npy"))
+    if finished:
+        return np.load(finished[0]), np.load(finished[0].with_name("model_initial.npy"))
+    import circle_fwi
+    from types import SimpleNamespace
+    import firedrake as fire
+    domain, _, _ = circle_fwi.geometry()
+    args = SimpleNamespace(grid_spacing=1.0 / circle_fwi.DEMO_CELLS)
+    _, true, initial = circle_fwi.grid_models(args, domain, fire.COMM_SELF)
+    return true, initial
+
+
+def write_table(root: Path, cases: dict, true: np.ndarray) -> Path:
+    """Write the table of the cases.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`load`.
+    true : numpy.ndarray
+        True model on the grid.
+
+    Returns
+    -------
+    pathlib.Path
+        The Markdown file.
+    """
+    lines = ["| case | state | iterations | meshes | last DOFs | J last / first | "
+             "model RMS error (km/s) | final E/tau | time (min) |",
+             "|---|---|---|---|---|---|---|---|---|"]
+    for name, case in cases.items():
+        history = case["report"]["history"]
+        if not history:
+            lines.append(f"| {name} | designing the first mesh | 0 | | | | | | |")
+            continue
+        model, _ = case["latest"]
+        rms = float(np.sqrt(np.mean((model - true) ** 2)))
+        s = case["summary"]
+        audit = s and s["final_audit_E_over_tau"]
+        elapsed = case["report"]["events"][-1]["elapsed_s"] / 60
+        lines.append(
+            f"| {name} | {'finished' if s else 'running'} | {len(history)} | "
+            f"{len(dict.fromkeys(h['mesh'] for h in history))} | {history[-1]['dofs']} | "
+            f"{history[-1]['J'] / history[0]['J']:.2e} | {rms:.4f} | "
+            f"{'' if audit is None else f'{audit:.2f}'} | {elapsed:.0f} |")
+    lines += ["", "J: misfit of the full traces against the data of the true model "
+              "on the uniform mesh, on the mesh of each iteration.",
+              "uniform: inversion on the uniform mesh of the data.",
+              "Final E/tau: two-level estimate of the error of the last mesh at "
+              "the final model, over its tolerance (above 1 fails)."]
+    file = root / "comparison.md"
+    file.write_text("\n".join(lines) + "\n")
+    return file
+
+
+def plot_misfit(root: Path, cases: dict) -> Path:
+    """Misfit and degrees of freedom by iteration.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`load`.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    fig, (top, bottom) = plt.subplots(2, 1, figsize=(8, 7), sharex=True)
+    for name, case in cases.items():
+        history = case["report"]["history"]
+        if not history:
+            continue
+        colour, line, marker = style(name)
+        iterations = [h["iteration"] for h in history]
+        top.semilogy(iterations, [h["J"] for h in history], color=colour,
+                     linestyle=line, marker=marker, markersize=4, label=name)
+        bottom.step(iterations, [h["dofs"] for h in history], where="post",
+                    color=colour, linestyle=line, label=name)
+    top.set_ylabel("J (on the mesh of the iteration)")
+    top.legend(ncol=2, fontsize=8)
+    top.grid(alpha=0.3)
+    bottom.set_yscale("log")
+    bottom.set_ylabel("degrees of freedom")
+    bottom.set_xlabel("iteration")
+    bottom.grid(alpha=0.3)
+    fig.tight_layout()
+    file = root / "comparison_misfit.png"
+    fig.savefig(file, dpi=130)
+    plt.close(fig)
+    return file
+
+
+def at_iteration(root: Path, cases: dict, iteration: int) -> dict:
+    """The cases with their model of one iteration in place of the latest.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`load`.
+    iteration : int
+        Iteration to show.
+
+    Returns
+    -------
+    dict
+        The cases that have reached the iteration.
+    """
+    chosen = {}
+    for name, case in cases.items():
+        file = root / name / f"model_iter{iteration:03d}.npy"
+        if file.exists():
+            chosen[name] = {**case, "latest": (np.load(file), iteration)}
+    return chosen
+
+
+def plot_models(root: Path, cases: dict, true: np.ndarray,
+                initial: np.ndarray, file_name: str = "comparison_models.png") -> Path:
+    """True, starting and latest models, and a profile through the disc.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`load`.
+    true, initial : numpy.ndarray
+        True and starting models on the grid.
+    file_name : str, optional
+        File name of the figure in ``root``.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    panels = [("true", true), ("initial", initial)] + [
+        (f"{name} (it. {case['latest'][1]})", case["latest"][0])
+        for name, case in cases.items() if case["latest"] is not None]
+    columns = 3
+    rows = int(np.ceil((len(panels) + 1) / columns))
+    fig, axes = plt.subplots(rows, columns, figsize=(4.2 * columns, 3.8 * rows))
+    axes = axes.ravel()
+    extent = [0.0, 1.0, -1.0, 0.0]
+    for ax, (title, model) in zip(axes, panels):
+        image = ax.imshow(model, origin="lower", extent=extent, vmin=1.5, vmax=2.0,
+                          cmap="viridis")
+        rms = np.sqrt(np.mean((model - true) ** 2))
+        ax.set_title(f"{title}\nRMS {rms:.4f} km/s", fontsize=9)
+        ax.plot(np.linspace(0.3, 0.7, 3), [-0.1] * 3, "r*", ms=6)
+        ax.plot(np.linspace(0.2, 0.8, 20), [-0.9] * 20, "wv", ms=3)
+        ax.set_xlabel("x (km)")
+        ax.set_ylabel("z (km)")
+    # A colour bar of its own, right of every panel, so it covers none.
+    fig.subplots_adjust(right=0.9, hspace=0.45, wspace=0.35)
+    fig.colorbar(image, cax=fig.add_axes([0.92, 0.3, 0.015, 0.4]), label="km/s")
+    profile = axes[len(panels)]
+    row = true.shape[0] // 2
+    x = np.linspace(0.0, 1.0, true.shape[1])
+    profile.plot(x, true[row], "k", lw=2, label="true")
+    profile.plot(x, initial[row], "k:", label="initial")
+    for name, case in cases.items():
+        if case["latest"] is not None:
+            colour, line, _ = style(name)
+            profile.plot(x, case["latest"][0][row], color=colour, linestyle=line,
+                         label=name)
+    profile.set_title("profile at z = -0.5 km", fontsize=9)
+    profile.set_xlabel("x (km)")
+    profile.set_ylabel("km/s")
+    profile.legend(fontsize=7)
+    profile.grid(alpha=0.3)
+    for ax in axes[len(panels) + 1:]:
+        ax.axis("off")
+    file = root / file_name
+    fig.savefig(file, dpi=130)
+    plt.close(fig)
+    return file
+
+
+def main() -> None:
+    """Write the table and the figures of the directory of the command line.
+
+    Returns
+    -------
+    None
+        The files are written in that directory.
+    """
+    root = Path(sys.argv[1])
+    cases = load(root)
+    true, initial = reference_models(root)
+    for file in (write_table(root, cases, true), plot_misfit(root, cases),
+                 plot_models(root, cases, true, initial)):
+        print(file)
+    if len(sys.argv) > 2:
+        iteration = int(sys.argv[2])
+        print(plot_models(root, at_iteration(root, cases, iteration), true, initial,
+                          f"comparison_models_iter{iteration:03d}.png"))
+
+
+if __name__ == "__main__":
+    main()
