+def test_broken_velocity_jumps_on_the_conforming_interface(tmp_path) -> None:
+    """Element by element, each side of the sea floor keeps its own value."""
+    data = dictionary()
+    pilot = TwoLevelPilot(data, two_layer, discontinuous_velocity=True)
+    mesh = pilot.load_meshes(cpw_mesh(tmp_path / "mesh.msh", 3.0))[0]
+    layered = VelocityGrid(np.array([[2.2, 2.2], [2.2, 2.2]]), -1.0, 0.0, 1.0, 1.2,
+                           fixed_layer=(INTERFACE, 1.5))
+    wave = pilot._wave(0, mesh)
+    c = broken_velocity(wave.function_space, layered)
+    centres = fire.Function(fire.VectorFunctionSpace(mesh, "DG", 0)).interpolate(
+        fire.SpatialCoordinate(mesh)).dat.data_ro
+    values = c.dat.data_ro.reshape(len(centres), -1)
+    water = centres[:, 0] > INTERFACE
+    assert np.all(values[water] == 1.5) and np.allclose(values[~water], 2.2)
+    # The continuous sampling cannot: the nodes on the interface take the
+    # sediment value, so the water elements that touch it ramp.
+    nodes = fire.Function(fire.VectorFunctionSpace(
+        mesh, wave.function_space.ufl_element())).interpolate(mesh.coordinates)
+    on_interface = np.isclose(nodes.dat.data_ro[:, 0], INTERFACE)
+    nodal = nodal_velocity(wave.function_space, layered).dat.data_ro
+    assert on_interface.any() and np.allclose(nodal[on_interface], 2.2)
+    assert pilot._wave(0, mesh).initial_velocity_model.function_space().ufl_element() \
+        == fire.BrokenElement(wave.function_space.ufl_element())
+
