+#!/bin/bash
+# FWI at 5 Hz on the smoothed Marmousi2 window: six cases.
+#
+#   cpw, gradient, adjoint  x  fixed mesh, mesh updated during the iterations
+#
+# Usage (from any folder):
+#
+#   bash run_marmousi_fwi.sh
+#
+# Settings, as environment variables:
+#
+#   OUT=...         directory of the results   (default: results/marmousi_5hz here)
+#   JOBS=3          cases run at the same time (each one uses one core)
+#   ITERATIONS=30   TAO iterations of each case
+#   SIGMA=0.4       km, Gaussian smoothing of the starting model
+#   CASES="cpw_fixed adjoint_update"   run only some of the cases
+#   VENV=...        Firedrake virtual environment
+#   DATA=...        observed data (default: $OUT/data_5hz.npz, generated by
+#                   --prepare when missing; reference_data.py writes others)
+#   REFERENCE_MESH=...  mesh on which the data were computed, recorded in
+#                   summary.json (default: <data>.msh)
+#
+# A case that already has summary.json is skipped, so the script can be run
+# again after an interruption. Delete the folder of a case to repeat it.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+SPYRO="$(cd "$HERE/../.." && pwd)"
+VENV="${VENV:-/Users/ddolci/dev_code/venv-firedrake}"
+OUT="${OUT:-$HERE/results/marmousi_5hz}"
+JOBS="${JOBS:-3}"
+ITERATIONS="${ITERATIONS:-30}"
+SIGMA="${SIGMA:-0.4}"
+CASES="${CASES:-cpw_fixed cpw_update gradient_fixed gradient_update adjoint_fixed adjoint_update}"
+
+# shellcheck disable=SC1091
+source "$VENV/bin/activate"
+export PYTHONPATH="$SPYRO"
+# One thread per case: the cases are the parallelism.
+export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
+
+mkdir -p "$OUT"
+cd "$HERE"
+
+# Keep the Mac awake while this script runs.
+if command -v caffeinate >/dev/null 2>&1; then
+    caffeinate -i -w $$ &
+fi
+
+DATA="${DATA:-$OUT/data_5hz.npz}"
+REFERENCE_MESH="${REFERENCE_MESH:-${DATA%.npz}.msh}"
+if [ ! -f "$DATA" ]; then
+    echo "[run] observed data and check of the starting model (about 10 min)"
+    python marmousi_fwi.py --prepare --data "$DATA" --sigma "$SIGMA" \
+        > "$OUT/prepare.log" 2>&1
+    grep "^\[prepare\]" "$OUT/prepare.log" || true
+fi
+if ! grep -q '"below_half_period": true' "${DATA%.npz}.check.json"; then
+    echo "[run] the starting model may cycle-skip: lower SIGMA and delete $DATA"
+    exit 1
+fi
+
+run_case() {
+    name="$1"
+    strategy="${name%_*}"
+    mode="${name#*_}"
+    if [ -f "$OUT/$name/summary.json" ]; then
+        echo "[run] $name: already done, skipped"
+        return 0
+    fi
+    extra=""
+    if [ "$mode" = "fixed" ]; then
+        extra="--fixed-mesh"
+    fi
+    echo "[run] $name: started $(date '+%H:%M'), log $OUT/$name.log"
+    # shellcheck disable=SC2086
+    if python marmousi_fwi.py --data "$DATA" --sigma "$SIGMA" \
+        --strategy "$strategy" $extra --iterations "$ITERATIONS" \
+        --reference-mesh "$REFERENCE_MESH" \
+        --output "$OUT/$name" > "$OUT/$name.log" 2>&1; then
+        echo "[run] $name: finished $(date '+%H:%M')"
+    else
+        echo "[run] $name: FAILED, see $OUT/$name.log"
+    fi
+}
+export -f run_case
+export OUT DATA SIGMA ITERATIONS REFERENCE_MESH
+
+# shellcheck disable=SC2086
+printf '%s\n' $CASES | xargs -P "$JOBS" -I {} bash -c 'run_case {}'
+
+python compare_marmousi_cases.py "$OUT"
