+def broken_nodes(function_space: fire.FunctionSpace
+                 ) -> tuple[fire.FunctionSpace, np.ndarray]:
+    """Element-wise copy of a space and the points where its values sit.
+
+    The broken space has the same element as ``function_space`` but no
+    continuity: a node shared by several elements has one value in each. To
+    tell them apart, each value is placed a tiny step from its node towards
+    the centre of its element, so a model with a jump on an edge of the mesh
+    (an interface the mesh conforms to) gives each side its own value.
+
+    Parameters
+    ----------
+    function_space : firedrake.FunctionSpace
+        Scalar Lagrange-type space (e.g. KMV).
+
+    Returns
+    -------
+    tuple
+        The broken space and the points ``(n_values, 2)`` in ``(z, x)``,
+        locally owned values and halos.
+    """
+    mesh = function_space.mesh()
+    element = fire.BrokenElement(function_space.ufl_element())
+    broken = fire.FunctionSpace(mesh, element)
+    vector = fire.VectorFunctionSpace(mesh, element)
+    nodes = fire.Function(vector).interpolate(mesh.coordinates)
+    centres = fire.Function(vector).interpolate(
+        fire.Function(fire.VectorFunctionSpace(mesh, "DG", 0)).interpolate(
+            fire.SpatialCoordinate(mesh)))
+    points = nodes.dat.data_ro_with_halos
+    inward = centres.dat.data_ro_with_halos - points
+    return broken, points + 1e-6 * inward
+
+
+def broken_velocity(function_space: fire.FunctionSpace,
+                    velocity: Callable[[np.ndarray, np.ndarray], np.ndarray]
+                    ) -> fire.Function:
+    """Sample a material callable element by element.
+
+    Like :func:`nodal_velocity`, in the broken copy of the space (see
+    :func:`broken_nodes`): on a mesh that conforms to an interface the
+    velocity jumps exactly there instead of ramping over the elements that
+    touch it, which keeps the high order of the elements.
+
+    Parameters
+    ----------
+    function_space : firedrake.FunctionSpace
+        Scalar Lagrange-type space (e.g. KMV).
+    velocity : callable
+        ``velocity(z, x)``; for a jump to be sharp it must itself be sharp
+        at the interface (see ``VelocityGrid``'s ``fixed_layer``).
+
+    Returns
+    -------
+    firedrake.Function
+        The property in the broken space.
+    """
+    broken, points = broken_nodes(function_space)
+    c = fire.Function(broken, name="velocity")
+    c.dat.data_with_halos[:] = velocity(points[:, 0], points[:, 1])
+    return c
+
+
+def cell_averaged_velocity(
+    function_space: fire.FunctionSpace, material: Mapping[str, Field],
+    tolerance: float = 0.01,
+) -> tuple[dict[str, fire.Function], tuple[int, int]]:
+    """Replace poorly represented material by effective constants per cell.
+
+    Parameters
+    ----------
+    function_space : firedrake.FunctionSpace
+        Scalar nodal KMV space on affine triangles.
+    material : mapping of str to callable
+        Either acoustic velocity or elastic density and both wave speeds.
+        Each callable evaluates the underlying model at the sampling points.
+    tolerance : float, optional
+        Maximum relative interpolation error at the quadrature points.
+        One failing property marks the cell for all properties.
+
+    Returns
+    -------
+    fields : dict of str to firedrake.Function
+        Broken interpolants with effective constants in the marked cells.
+    counts : tuple of int
+        Global number of marked cells and total cells.
+
+    Raises
+    ------
+    ValueError
+        If the tolerance, material fields or mesh type are unsupported.
+    """
+    if not np.isfinite(tolerance) or tolerance < 0:
+        raise ValueError("The cell average tolerance must be finite and nonnegative.")
+    acoustic = set(material) == {"velocity"}
+    if not acoustic and set(material) != {"density", "p_wave_velocity", "s_wave_velocity"}:
+        raise ValueError("Cell averaging requires acoustic velocity or elastic density and velocities.")
+    mesh = function_space.mesh()
+    if mesh.ufl_cell().cellname != "triangle" or mesh.coordinates.ufl_element().degree() != 1:
+        raise ValueError("Cell averaging requires affine triangles.")
+    degree = function_space.ufl_element().degree()
+    quadrature = fire.FunctionSpace(mesh, "Quadrature", 2 * degree + 2,
+                                    quad_scheme="default")
+    qnodes = quadrature.cell_node_map().values
+    z, x = (fire.Function(quadrature).interpolate(coord).dat.data_ro_with_halos[qnodes]
+            for coord in fire.SpatialCoordinate(mesh))
+    weights = fire.Function(quadrature).interpolate(
+        QuadratureWeight(mesh)).dat.data_ro_with_halos[qnodes]
+    weights /= weights.sum(axis=1, keepdims=True)
+
+    broken, points = broken_nodes(function_space)
+    nodes = broken.cell_node_map().values
+    marked = np.zeros(len(nodes), dtype=bool)
+    fields = {}
+    samples = {}
+    for name, evaluate in material.items():
+        field = fire.Function(broken, name=name)
+        field.dat.data_with_halos[:] = evaluate(points[:, 0], points[:, 1])
+        values = np.broadcast_to(evaluate(z, x), z.shape).astype(float, copy=False)
+        interpolated = fire.Function(quadrature).interpolate(field).dat.data_ro_with_halos[qnodes]
+        marked |= np.any(np.abs(interpolated - values) > tolerance * np.abs(values), axis=1)
+        fields[name] = field
+        samples[name] = values
+
+    local_count = int(marked.sum())
+    if local_count:
+        def mean(values: np.ndarray) -> np.ndarray:
+            """Integrate values over the marked cells.
+
+            Parameters
+            ----------
+            values : numpy.ndarray
+                Values at the quadrature points of the marked cells.
+
+            Returns
+            -------
+            numpy.ndarray
+                One mean per marked cell.
+            """
+            return np.sum(weights[marked] * values, axis=1)
+
+        if acoustic:
+            equivalent = {"velocity": mean(samples["velocity"][marked] ** -2.0) ** -0.5}
+        else:
+            rho = samples["density"][marked]
+            density = mean(rho)
+            equivalent = {"density": density}
+            for name in ("p_wave_velocity", "s_wave_velocity"):
+                compliance = mean(1.0 / (rho * samples[name][marked] ** 2))
+                equivalent[name] = 1.0 / np.sqrt(density * compliance)
+        for name, values in equivalent.items():
+            fields[name].dat.data[nodes[marked]] = values[:, None]
+    return fields, (mesh.comm.allreduce(local_count), mesh.comm.allreduce(len(nodes)))
+
