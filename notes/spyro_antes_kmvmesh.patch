+@lru_cache(maxsize=None)
+def kmv_edge_quadrature_rule(degree: int) -> finat.quadrature.QuadratureRule:
+    """Build a positive interpolatory rule at a triangular KMV edge's nodes.
+
+    Parameters
+    ----------
+    degree : int
+        Nominal degree of the triangular KMV element.
+
+    Returns
+    -------
+    finat.quadrature.QuadratureRule
+        Rule on [0, 1], exact for polynomials through ``degree``.
+
+    Raises
+    ------
+    ValueError
+        If the edge does not have ``degree + 1`` distinct nodes or an
+        interpolatory weight is nonpositive or nonfinite.
+
+    Notes
+    -----
+    KMV bubbles vanish on an edge. Sampling its nodal basis at these points
+    therefore diagonalizes the boundary mass. Shifted Legendre moments avoid
+    solving a monomial Vandermonde system. The rule is independent of the
+    velocity coefficient, which remains in UFL for differentiation.
+
+    AI assistance: Codex (OpenAI), implementation and validation.
+    """
+    from FIAT.kong_mulder_veldhuizen import KongMulderVeldhuizenDualSet
+
+    dual = KongMulderVeldhuizenDualSet(FIAT.ufc_simplex(2), degree)
+    nodes = np.asarray([next(iter(node.pt_dict)) for node in dual.get_nodes()])
+    edge = np.sort(nodes[np.abs(nodes[:, 1]) < 1e-14, 0])
+    if len(edge) != degree + 1 or np.any(np.diff(edge) <= 0):
+        raise ValueError(f"KMV{degree} has unexpected edge nodes: {edge}")
+    moments = np.zeros(degree + 1)
+    moments[0] = 1.0
+    vandermonde = np.polynomial.legendre.legvander(2.0 * edge - 1.0, degree)
+    weights = np.linalg.solve(vandermonde.T, moments)
+    if not np.all(np.isfinite(weights)) or np.any(weights <= 0.0):
+        raise ValueError(f"KMV{degree} has nonpositive edge quadrature weights: {weights}")
+    return finat.quadrature.QuadratureRule(
+        finat.point_set.PointSet(edge[:, None]), weights)
+
+
