+@pytest.mark.parametrize("discontinuous", [False, True])
+def test_grid_projection(tmp_path, discontinuous: bool) -> None:
+    """The projection keeps constants, is the transpose of its transpose, and
+    weights every grid node by its area, on a mesh coarser than the grid."""
+    mesh = fire.Mesh(cpw_mesh(tmp_path / "coarse.msh", 2.0))
+    space = fire.FunctionSpace(mesh, "KMV", 2)
+    if discontinuous:
+        space = fire.FunctionSpace(mesh, fire.BrokenElement(space.ufl_element()))
+    grid = ParameterGrid(DOMAIN, 0.02, "Q1")
+    projection = GridProjection(grid, space)
+    assert np.allclose(projection.apply(np.full(grid.shape, 2.0)), 2.0)
+    rng = np.random.default_rng(6)
+    model = rng.standard_normal(grid.shape)
+    dual = rng.standard_normal(len(fire.Function(space).dat.data_ro))
+    assert np.dot(projection.apply(model), dual) == pytest.approx(
+        np.dot(model.ravel(), projection.transpose(dual)), rel=1e-10)
+    # A uniform field in the wave space reaches every interior grid node with
+    # the area of its cell, the way sampling at the nodes does not.
+    mass = fire.assemble(fire.TestFunction(space) * fire.dx).dat.data_ro
+    weights = projection.transpose(mass).reshape(grid.shape)[2:-2, 2:-2]
+    assert np.allclose(weights / (grid.dz * grid.dx), 1.0, atol=0.1)
+
