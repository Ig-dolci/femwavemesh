new file mode 100644
index 0000000..0499c90
--- /dev/null
+++ b/demos/mesh_adaptive_fwi/plot_results.py
@@ -0,0 +1,183 @@
+"""Figures of a run of ``two_layer_fwi.py``.
+
+Usage::
+
+    python plot_results.py <output directory of two_layer_fwi.py>
+
+Writes ``models.png``, ``history.png`` and ``meshes.png`` in that directory.
+"""
+import json
+import sys
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+import meshio  # noqa: E402
+import numpy as np  # noqa: E402
+
+from two_layer_fwi import DOMAIN, RECEIVERS, SOURCES  # noqa: E402
+from two_layer_fwi import initial_velocity, true_velocity  # noqa: E402
+
+
+def grid_axes(grid: dict) -> tuple[np.ndarray, np.ndarray]:
+    """Coordinates of the values of the parameter grid.
+
+    Parameters
+    ----------
+    grid : dict
+        Entry ``grid`` of the report: ``element`` and ``shape``.
+
+    Returns
+    -------
+    tuple of numpy.ndarray
+        Depths and horizontal positions (km): nodes for ``Q1``, cell centres
+        for ``DG0``.
+    """
+    rows, columns = grid["shape"]
+    if grid["element"] == "Q1":
+        return (np.linspace(DOMAIN.z_min, 0.0, rows),
+                np.linspace(DOMAIN.x_min, DOMAIN.x_max, columns))
+    dz, dx = -DOMAIN.z_min / rows, (DOMAIN.x_max - DOMAIN.x_min) / columns
+    return (DOMAIN.z_min + dz * (np.arange(rows) + 0.5),
+            DOMAIN.x_min + dx * (np.arange(columns) + 0.5))
+
+
+def plot_models(output: Path, report: dict) -> Path:
+    """True, initial and inverted models, and the error of the last one.
+
+    Parameters
+    ----------
+    output : pathlib.Path
+        Directory of the run.
+    report : dict
+        Content of ``report_fwi.json``.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    shape = tuple(report["grid"]["shape"])
+    z, x = grid_axes(report["grid"])
+    Z, X = np.meshgrid(z, x, indexing="ij")
+    true, initial = true_velocity(Z, X), initial_velocity(Z, X)
+    stages = sorted(output.glob("model_stage*.npy"))
+    panels = [("verdadeiro", true), ("inicial", initial)]
+    panels += [(f"após estágio {k}", np.load(f).reshape(shape))
+               for k, f in enumerate(stages)]
+    extent = [x[0], x[-1], z[0], z[-1]]
+    fig, axes = plt.subplots(1, len(panels) + 1, figsize=(4 * (len(panels) + 1), 3.6),
+                             constrained_layout=True)
+    for ax, (title, model) in zip(axes, panels):
+        image = ax.imshow(model, origin="lower", extent=extent, cmap="viridis",
+                          vmin=1.4, vmax=2.6, aspect="equal")
+        ax.set_title(title)
+    fig.colorbar(image, ax=axes[:-1], label="velocidade (km/s)", shrink=0.8)
+    last = panels[-1][1]
+    error = axes[-1].imshow(last - true, origin="lower", extent=extent, cmap="RdBu_r",
+                            vmin=-0.5, vmax=0.5, aspect="equal")
+    axes[-1].set_title("último − verdadeiro")
+    fig.colorbar(error, ax=axes[-1], label="km/s", shrink=0.8)
+    for ax in axes:
+        ax.plot([s[1] for s in SOURCES], [s[0] for s in SOURCES], "r*", ms=7)
+        ax.plot([r[1] for r in RECEIVERS], [r[0] for r in RECEIVERS], "w.", ms=2)
+        ax.set_xlabel("x (km)")
+    axes[0].set_ylabel("z (km)")
+    file = output / "models.png"
+    fig.savefig(file, dpi=140)
+    return file
+
+
+def plot_history(output: Path, report: dict) -> Path:
+    """Misfit and number of degrees of freedom along the iterations.
+
+    Parameters
+    ----------
+    output : pathlib.Path
+        Directory of the run.
+    report : dict
+        Content of ``report_fwi.json``.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    history = report["history"]
+    iteration = np.array([h["iteration"] for h in history])
+    misfit = np.array([h["J"] for h in history])
+    dofs = np.array([h["dofs"] for h in history])
+    stage = np.array([h["stage"] for h in history])
+    mesh = [h["mesh"] for h in history]
+    fig, (top, bottom) = plt.subplots(2, 1, figsize=(7.5, 6), sharex=True,
+                                      constrained_layout=True)
+    for k in np.unique(stage):
+        chosen = stage == k
+        top.semilogy(iteration[chosen], misfit[chosen], "o-", label=f"estágio {k}")
+    for n in range(1, len(history)):
+        if mesh[n] != mesh[n - 1]:
+            for ax in (top, bottom):
+                ax.axvline(iteration[n] - 0.5, color="0.6", ls="--", lw=1)
+    top.set_ylabel("J (norma do estágio)")
+    top.legend()
+    top.grid(alpha=0.3)
+    bottom.step(iteration, dofs, where="mid", color="C3")
+    bottom.plot(iteration, dofs, "o", color="C3")
+    bottom.set_ylabel("graus de liberdade")
+    bottom.set_xlabel("iteração (tracejado: troca de malha)")
+    bottom.grid(alpha=0.3)
+    file = output / "history.png"
+    fig.savefig(file, dpi=140)
+    return file
+
+
+def plot_meshes(output: Path, report: dict) -> Path:
+    """Meshes used by the optimiser, in the order of use.
+
+    Parameters
+    ----------
+    output : pathlib.Path
+        Directory of the run.
+    report : dict
+        Content of ``report_fwi.json``.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    used = list(dict.fromkeys(h["mesh"] for h in report["history"]))
+    dofs = {h["mesh"]: h["dofs"] for h in report["history"]}
+    fig, axes = plt.subplots(1, len(used), figsize=(4 * len(used), 3.6),
+                             constrained_layout=True, squeeze=False)
+    for ax, name in zip(axes[0], used):
+        mesh = meshio.read(output / "meshes" / name)
+        triangles = mesh.cells_dict["triangle"]
+        ax.triplot(mesh.points[:, 1], mesh.points[:, 0], triangles, lw=0.3, color="k")
+        ax.set_aspect("equal")
+        ax.set_title(f"{name}\n{dofs[name]} GL", fontsize=9)
+        ax.set_xlabel("x (km)")
+    axes[0][0].set_ylabel("z (km)")
+    file = output / "meshes.png"
+    fig.savefig(file, dpi=140)
+    return file
+
+
+def main() -> None:
+    """Write the figures of the run given in the command line.
+
+    Returns
+    -------
+    None
+        The figures are written in the directory of the run.
+    """
+    output = Path(sys.argv[1])
+    report = json.loads((output / "report_fwi.json").read_text())
+    for plot in (plot_models, plot_history, plot_meshes):
+        print(plot(output, report))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/demos/mesh_adaptive_fwi/reference_data.py b/demos/mesh_adaptive_fwi/reference_data.py
new file mode 100644
index 0000000..ed6bc35
--- /dev/null
+++ b/demos/mesh_adaptive_fwi/reference_data.py
@@ -0,0 +1,164 @@
+"""Observed data of the Marmousi FWI on a given mesh, one process per shot.
+
+``marmousi_fwi.py --prepare`` generates its own uniform mesh for the data.
+This script uses an existing, verified mesh instead, such as the conforming
+acoustic reference of the mesh tests
+(``demos/automatic_mesh_adaptation/references/acoustic_s250_10hz/C12.msh``),
+and runs each shot in its own process. Two steps::
+
+    python reference_data.py --mesh C12.msh --shot 0 --output shots/   # 0..5
+    python reference_data.py --merge --output shots/ --data data_ref.npz \\
+        --like data_5hz.npz
+
+Each shot is propagated at half the critical time step of the mesh and
+resampled (cubic spline) onto the time axis of ``--like``, so the data file
+has the format and the time axis of the one ``--prepare`` writes. The check of
+the starting model is copied from ``--like``: it compares arrival times, which
+the mesh of the data does not change.
+
+AI assistance: written by Claude (Anthropic), reviewed by the author.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+from scipy.interpolate import CubicSpline
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parents[1]))
+sys.path.insert(0, str(HERE))
+
+
+def parse_arguments() -> argparse.Namespace:
+    """Read the command line.
+
+    Returns
+    -------
+    argparse.Namespace
+        The settings.
+    """
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    parser.add_argument("--output", required=True, help="folder of the shots")
+    parser.add_argument("--mesh", help="mesh of the data (one shot per run)")
+    parser.add_argument("--shot", type=int, help="shot to propagate")
+    parser.add_argument("--merge", action="store_true",
+                        help="write the data file from the shots of --output")
+    parser.add_argument("--data", help="data file written by --merge")
+    parser.add_argument("--like", required=True,
+                        help="data file of marmousi_fwi.py --prepare: time axis, "
+                             "settings and check of the starting model")
+    return parser.parse_args()
+
+
+def propagate(mesh: str, shot: int, like: Path, output: Path) -> Path:
+    """Propagate one shot of the true model and resample it.
+
+    Parameters
+    ----------
+    mesh : str
+        Mesh file.
+    shot : int
+        Source index.
+    like : pathlib.Path
+        Data file whose time axis and settings are used.
+    output : pathlib.Path
+        Folder of the shots.
+
+    Returns
+    -------
+    pathlib.Path
+        ``<output>/shot<k>.npz`` with the resampled record.
+    """
+    from spyro.adaptivity import TwoLevelPilot
+    from spyro.adaptivity._firedrake_workarounds import speed_up_unique_names
+    from marmousi_fwi import geometry, model_dictionary, parse_arguments as demo
+    from marmousi_fwi import true_velocity
+
+    speed_up_unique_names()
+    stored = np.load(like)
+    sys.argv = [sys.argv[0], "--data", str(like),
+                "--frequency", str(float(stored["frequency"])),
+                "--final-time", str(float(stored["final_time"])),
+                "--degree", str(int(stored["degree"]))]
+    args = demo()
+    domain, sources, receivers, offset = geometry()
+    pilot = TwoLevelPilot(model_dictionary(args, domain, sources, receivers),
+                          true_velocity(args.model, offset),
+                          discontinuous_velocity=True)
+    loaded = pilot.load_meshes(mesh)[0]
+    dt = 0.5 * pilot.critical_time_step(loaded)
+    start = time.perf_counter()
+    record = np.asarray(pilot.shot_record(shot, loaded, dt))
+    elapsed = time.perf_counter() - start
+    # As in --prepare, sample n is at time (n + 1) dt.
+    times = (np.arange(len(record)) + 1) * dt
+    target = (np.arange(stored["records"].shape[1]) + 1) * float(stored["dt"])
+    resampled = CubicSpline(times, record, axis=0)(np.clip(target, times[0],
+                                                           times[-1]))
+    output.mkdir(parents=True, exist_ok=True)
+    file = output / f"shot{shot}.npz"
+    np.savez(file, record=resampled, dt=float(stored["dt"]), fine_dt=dt,
+             seconds=elapsed, mesh=str(mesh))
+    print(f"[reference] shot {shot}: dt {dt:.3e} s, {len(record)} steps, "
+          f"{elapsed:.0f} s", flush=True)
+    return file
+
+
+def merge(output: Path, data: Path, like: Path) -> Path:
+    """Write the data file from the shots.
+
+    Parameters
+    ----------
+    output : pathlib.Path
+        Folder of the shots.
+    data : pathlib.Path
+        Data file to write.
+    like : pathlib.Path
+        Data file whose settings and check are copied.
+
+    Returns
+    -------
+    pathlib.Path
+        The data file.
+    """
+    stored = np.load(like)
+    shots = len(stored["records"])
+    files = [np.load(output / f"shot{shot}.npz") for shot in range(shots)]
+    records = np.array([f["record"] for f in files])
+    np.savez(data, records=records, dt=stored["dt"], sigma=stored["sigma"],
+             frequency=stored["frequency"], final_time=stored["final_time"],
+             degree=stored["degree"])
+    check = json.loads(like.with_suffix(".check.json").read_text())
+    check["data_mesh"] = str(files[0]["mesh"])
+    check["check_computed_with"] = str(like)
+    difference = np.linalg.norm(records - stored["records"]) / np.linalg.norm(
+        stored["records"])
+    check["relative_difference_to_like"] = float(difference)
+    data.with_suffix(".check.json").write_text(json.dumps(check, indent=1))
+    print(f"[reference] {data}: {shots} shots; relative difference to {like.name}: "
+          f"{difference:.4f}", flush=True)
+    return data
+
+
+def main() -> None:
+    """Propagate one shot or merge them.
+
+    Returns
+    -------
+    None
+        The files are written in ``--output`` or ``--data``.
+    """
+    args = parse_arguments()
+    if args.merge:
+        merge(Path(args.output), Path(args.data), Path(args.like))
+    else:
+        propagate(args.mesh, args.shot, Path(args.like), Path(args.output))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/demos/mesh_adaptive_fwi/run_circle_fwi.sh b/demos/mesh_adaptive_fwi/run_circle_fwi.sh
new file mode 100644
index 0000000..f45312a
--- /dev/null
+++ b/demos/mesh_adaptive_fwi/run_circle_fwi.sh
@@ -0,0 +1,84 @@
+#!/bin/bash
+# FWI of the circle of Firedrake's FWI demo: the inversion on the uniform mesh
+# of the data (25 x 25, KMV4) and the six mesh designs, one case at a time, the shots in
+# parallel (one MPI process per shot).
+#
+#   uniform                 the 80 x 80 mesh the data were computed on
+#   cpw, gradient, adjoint  x  fixed mesh, mesh updated during the iterations
+#
+# Usage (from any folder):
+#
+#   bash run_circle_fwi.sh
+#
+# Settings, as environment variables:
+#
+#   OUT=...         directory of the results   (default: results/circle here)
+#   NP=3            MPI processes: the 3 shots in parallel (6 or 9 adds
+#                   spatial parallelism inside each shot)
+#   ITERATIONS=30   TAO iterations of each case
+#   UNIFORM_CELLS=25  squares a side of the uniform case (default: the 25 x 25
+#                   KMV4 mesh of the data, 13 951 DOFs)
+#   CASES="uniform adjoint_update"   run only some of the cases
+#   VENV=...        Firedrake virtual environment
+#
+# A case that already has summary.json is skipped, so the script can be run
+# again after an interruption. Delete the folder of a case to repeat it.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+SPYRO="$(cd "$HERE/../.." && pwd)"
+VENV="${VENV:-/Users/ddolci/dev_code/venv-firedrake}"
+OUT="${OUT:-$HERE/results/circle}"
+NP="${NP:-3}"
+ITERATIONS="${ITERATIONS:-30}"
+UNIFORM_CELLS="${UNIFORM_CELLS:-25}"
+CASES="${CASES:-uniform cpw_fixed cpw_update gradient_fixed gradient_update adjoint_fixed adjoint_update}"
+SPATIAL=$((NP / 3))
+
+# shellcheck disable=SC1091
+source "$VENV/bin/activate"
+export PYTHONPATH="$SPYRO"
+export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
+
+mkdir -p "$OUT"
+cd "$HERE"
+
+# Keep the Mac awake while this script runs.
+if command -v caffeinate >/dev/null 2>&1; then
+    caffeinate -i -w $$ &
+fi
+
+DATA="$OUT/data_circle.npz"
+if [ ! -f "$DATA" ]; then
+    echo "[run] observed data on the uniform mesh of the demo"
+    mpiexec -n "$NP" python circle_fwi.py --prepare --data "$DATA" \
+        --spatial "$SPATIAL" > "$OUT/prepare.log" 2>&1
+    grep "^\[prepare\]" "$OUT/prepare.log" || true
+fi
+
+for name in $CASES; do
+    if [ -f "$OUT/$name/summary.json" ]; then
+        echo "[run] $name: already done, skipped"
+        continue
+    fi
+    if [ "$name" = "uniform" ]; then
+        options="--strategy uniform --uniform-cells $UNIFORM_CELLS"
+    else
+        options="--strategy ${name%_*}"
+        if [ "${name#*_}" = "fixed" ]; then
+            options="$options --fixed-mesh"
+        fi
+    fi
+    echo "[run] $name: started $(date '+%H:%M'), log $OUT/$name.log"
+    # shellcheck disable=SC2086
+    if mpiexec -n "$NP" python circle_fwi.py --data "$DATA" $options \
+        --iterations "$ITERATIONS" --spatial "$SPATIAL" \
+        --output "$OUT/$name" > "$OUT/$name.log" 2>&1; then
+        echo "[run] $name: finished $(date '+%H:%M')"
+    else
+        echo "[run] $name: FAILED, see $OUT/$name.log"
+    fi
+    python compare_circle_cases.py "$OUT" > /dev/null 2>&1 || true
+done
+
+python compare_circle_cases.py "$OUT"
