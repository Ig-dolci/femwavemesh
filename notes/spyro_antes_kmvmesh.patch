+#!/bin/bash
+# Comparison protocol of the mesh strategies on the Marmousi2 window of the
+# mesh tests (9-11 km, 1.6 km deep, 0.3 km pad, known water above the sea
+# floor): the true model is the unsmoothed window, the starting model the
+# s250 window; NSOURCES sources and NRECEIVERS receivers; data on a uniform
+# reference mesh of REFERENCE_SIZE, checked against CONVERGENCE_SIZE.
+#
+# For each noise seed (white Gaussian noise of NOISE times the norm of each
+# shot in the window after the sea-floor reflection, the same realization in
+# every case of the seed):
+#
+#   oracle            uniform mesh of ORACLE_SIZE at half the usual time step
+#   uniform           uniform mesh of UNIFORM_SIZE (the usual a priori mesh)
+#   undersized        uniform mesh of UNDERSIZED_SIZE, never audited
+#                     (negative control)
+#   cpw|gradient|adjoint _fixed|_update   the six designs
+#   restart_control   adjoint_fixed with TAO restarted at the iterations where
+#                     adjoint_update started a new TAO solve; it waits for the
+#                     adjoint_update of its seed
+#
+# Misfit, noise level and audits use the same window (--misfit-window). Every
+# case stops at the discrepancy level (DISCREPANCY times the noise plus the
+# modelling error) or at MAX_ITERATIONS. Each case runs on NP = NSOURCES
+# processes (one per shot); JOBS cases run at the same time, the most
+# expensive first.
+#
+# Usage (from any folder):
+#
+#   bash run_marmousi_protocol.sh
+#
+# Settings, as environment variables:
+#
+#   OUT=...             results (default: results/marmousi_protocol here)
+#   DATA=...            noise-free data (default: $OUT/data_marmousi.npz,
+#                       prepared when missing)
+#   MODEL=..., INITIAL_MODEL=...   true and starting windows (defaults: the
+#                       unsmoothed and the s250 windows of the mesh tests)
+#   NSOURCES=8 NRECEIVERS=101 FREQUENCY=5 FINAL_TIME=2
+#   REFERENCE_SIZE=0.0125 CONVERGENCE_SIZE=0.025   km, meshes of the data
+#   ORACLE_SIZE=0.05 UNIFORM_SIZE=0.075 UNDERSIZED_SIZE=0.15   km
+#   SEEDS="1 2 3"       noise realizations
+#   NOISE=0.05          noise level relative to each shot in the window
+#   DISCREPANCY=1.1     tau_D of the stopping rule
+#   MAX_ITERATIONS=60   iteration limit of every case
+#   MAX_DOFS=50000      largest mesh of the designs
+#   XI=-1               gradient-error tolerance of the audits; negative drops
+#                       the gradient criterion. It is off by default here: its
+#                       refined adjoint stores every state of the refined mesh
+#                       at half the time step (16 times those of the mesh),
+#                       tens of GB per process on these meshes, and on the
+#                       circle it never decided a failure.
+#   CASES="..."         run only some of the cases
+#   PREPARE_ONLY=1      prepare the data and stop (one job before the
+#                       copies that run the cases)
+#   NP=$NSOURCES        MPI processes of each case
+#   JOBS=1              cases running at the same time (JOBS x NP processes)
+#   MPIEXEC=mpiexec     MPI launcher, e.g. "mpiexec --bind-to none"
+#   VENV=...            Firedrake virtual environment ("" for the active one)
+#   PYTHONPATH=...      kept after this checkout of spyro
+#
+# Several copies of the script (several Slurm jobs on one node) can share
+# OUT: each case is claimed by creating <OUT>/seed<k>/<case>.lock (mkdir is
+# atomic). A case that already has summary.json is skipped. To run again
+# after an interruption, delete the folder and the .lock of each unfinished
+# case.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+SPYRO="$(cd "$HERE/../.." && pwd)"
+VENV="${VENV-/Users/ddolci/dev_code/venv-firedrake}"
+OUT="${OUT:-$HERE/results/marmousi_protocol}"
+DATA="${DATA:-$OUT/data_marmousi.npz}"
+WINDOWS="$(cd "$HERE/../../.." && pwd)/experiments/kmv4_cpw_calibration/data"
+MODEL="${MODEL:-$WINDOWS/marmousi_window.npz}"
+INITIAL_MODEL="${INITIAL_MODEL:-$WINDOWS/marmousi_window_s250.npz}"
+NSOURCES="${NSOURCES:-8}"
+NRECEIVERS="${NRECEIVERS:-101}"
+FREQUENCY="${FREQUENCY:-5}"
+FINAL_TIME="${FINAL_TIME:-2}"
+REFERENCE_SIZE="${REFERENCE_SIZE:-0.0125}"
+CONVERGENCE_SIZE="${CONVERGENCE_SIZE:-0.025}"
+ORACLE_SIZE="${ORACLE_SIZE:-0.05}"
+UNIFORM_SIZE="${UNIFORM_SIZE:-0.075}"
+UNDERSIZED_SIZE="${UNDERSIZED_SIZE:-0.15}"
+MAX_DOFS="${MAX_DOFS:-50000}"
+XI="${XI:--1}"
+SEEDS="${SEEDS:-1 2 3}"
+NOISE="${NOISE:-0.05}"
+DISCREPANCY="${DISCREPANCY:-1.1}"
+MAX_ITERATIONS="${MAX_ITERATIONS:-60}"
+NP="${NP:-$NSOURCES}"
+JOBS="${JOBS:-1}"
+MPIEXEC="${MPIEXEC:-mpiexec}"
+CASES="${CASES:-oracle uniform undersized cpw_fixed cpw_update gradient_fixed gradient_update adjoint_fixed adjoint_update restart_control}"
+SPATIAL=$((NP / NSOURCES))
+if [ "$SPATIAL" -lt 1 ]; then SPATIAL=1; fi
+# Settings shared by the preparation and every case.
+COMMON="--model $MODEL --initial-model $INITIAL_MODEL --sources $NSOURCES --receivers $NRECEIVERS --frequency $FREQUENCY --final-time $FINAL_TIME --spatial $SPATIAL"
+
+if [ -n "$VENV" ]; then
+    # shellcheck disable=SC1091
+    source "$VENV/bin/activate"
+fi
+# This checkout first; a PYTHONPATH given from outside (extra dependencies)
+# is kept after it.
+export PYTHONPATH="$SPYRO${PYTHONPATH:+:$PYTHONPATH}"
+export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
+
+mkdir -p "$OUT"
+cd "$HERE"
+
+# Keep the Mac awake while this script runs; in a subshell, so that it is
+# not one of the jobs counted and waited for below.
+if command -v caffeinate >/dev/null 2>&1; then
+    (caffeinate -i -w $$ &)
+fi
+
+if [ ! -f "$DATA" ]; then
+    echo "[protocol] observed data on the uniform reference mesh ($REFERENCE_SIZE km), started $(date '+%d %H:%M')"
+    # shellcheck disable=SC2086
+    $MPIEXEC -n "$NP" python marmousi_fwi.py --prepare --data "$DATA" $COMMON \
+        --observed-size "$REFERENCE_SIZE" --convergence-size "$CONVERGENCE_SIZE" \
+        > "$OUT/prepare.log" 2>&1
+    grep "^\[prepare\]" "$OUT/prepare.log" || true
+    # The check of the starting model is recorded, not enforced: on the
+    # unsmoothed window the correlation of whole traces locks onto other
+    # events, so its largest shift is not a reliable sign of cycle skipping
+    # (decision of 17/11/2026: one band at 5 Hz).
+fi
+if [ "${PREPARE_ONLY:-0}" = "1" ]; then
+    exit 0
+fi
+
+# Iterations at which a case started a new TAO solve after the first.
+restarts_of() {
+    python - "$1" <<'EOF'
+import json, sys
+events = json.load(open(sys.argv[1]))["events"]
+history = 0
+starts = []
+for event in events:
+    if event["event"] == "iterate":
+        history = event["iteration"]
+    elif event["event"] == "tao_start" and history > 0:
+        starts.append(history)
+print(" ".join(str(s) for s in starts))
+EOF
+}
+
+# Run one case of one seed; its output is in <OUT>/seed<k>/<case>.log.
+run_case() {
+    local seed="$1" name="$2"
+    local case_dir="$OUT/seed$seed/$name" options
+    case "$name" in
+        oracle) options="--strategy uniform --uniform-size $ORACLE_SIZE --dt-fraction 0.35" ;;
+        uniform) options="--strategy uniform --uniform-size $UNIFORM_SIZE" ;;
+        undersized) options="--strategy uniform --uniform-size $UNDERSIZED_SIZE" ;;
+        restart_control)
+            local reference="$OUT/seed$seed/adjoint_update"
+            # Wait for the adjoint_update of the seed, which gives the restarts.
+            while [ ! -f "$reference/summary.json" ] && [ ! -f "$reference.failed" ]; do
+                sleep 30
+            done
+            if [ ! -f "$reference/summary.json" ]; then
+                echo "[protocol] seed $seed restart_control: adjoint_update failed, skipped"
+                return 0
+            fi
+            options="--strategy adjoint --fixed-mesh --restarts $(restarts_of "$reference/report_fwi.json")" ;;
+        *_fixed) options="--strategy ${name%_*} --fixed-mesh" ;;
+        *_update) options="--strategy ${name%_*}" ;;
+        *) echo "[protocol] unknown case $name"; return 1 ;;
+    esac
+    mkdir -p "$OUT/seed$seed"
+    rm -f "$case_dir.failed"
+    echo "[protocol] seed $seed $name: started $(date '+%d %H:%M'), log $case_dir.log"
+    # shellcheck disable=SC2086
+    if $MPIEXEC -n "$NP" python marmousi_fwi.py --data "$DATA" $COMMON $options \
+        --misfit-window --noise-seed "$seed" --noise-fraction "$NOISE" \
+        --discrepancy "$DISCREPANCY" --iterations "$MAX_ITERATIONS" \
+        --max-dofs "$MAX_DOFS" --xi "$XI" --output "$case_dir" > "$case_dir.log" 2>&1; then
+        echo "[protocol] seed $seed $name: finished $(date '+%d %H:%M')"
+    else
+        touch "$case_dir.failed"
+        echo "[protocol] seed $seed $name: FAILED, see $case_dir.log"
+    fi
+}
+
+# The cases in the order of CASES (the expensive ones first), each over the
+# seeds; at most JOBS at a time. Polling instead of "wait -n" keeps the
+# script working with the bash 3.2 of macOS.
+for name in $CASES; do
+    for seed in $SEEDS; do
+        if [ -f "$OUT/seed$seed/$name/summary.json" ]; then
+            echo "[protocol] seed $seed $name: already done, skipped"
+            continue
+        fi
+        while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do
+            sleep 10
+        done
+        mkdir -p "$OUT/seed$seed"
+        if ! mkdir "$OUT/seed$seed/$name.lock" 2>/dev/null; then
+            echo "[protocol] seed $seed $name: claimed by another copy, skipped"
+            continue
+        fi
+        run_case "$seed" "$name" &
+    done
+done
+wait
+
+python compare_circle_protocol.py "$OUT" || true
diff --git a/demos/mesh_adaptive_fwi/two_layer_fwi.py b/demos/mesh_adaptive_fwi/two_layer_fwi.py
new file mode 100644
index 0000000..c9a241f
--- /dev/null
+++ b/demos/mesh_adaptive_fwi/two_layer_fwi.py
@@ -0,0 +1,173 @@
+"""Acoustic FWI of a small two-layer model with the wave mesh updated on the way.
+
+The model lives on a fixed parameter grid; the gradient comes from spyro's
+UFL-derived implemented adjoint and TAO (BQNLS) minimizes the misfit. The
+wave mesh is designed at the start of each stage from the adjoint indicator
+of the two-level pilot, verified, audited during the iterations and refined
+when the mesh error exceeds the tolerance tied to the data residual (see
+:mod:`spyro.adaptivity.fwi_loop`).
+
+The true model is water (1.5 km/s) over a 2.5 km/s layer with a slow
+circular anomaly; the starting model has a 2.2 km/s layer and no anomaly.
+The observed data are propagated on an independent, finer mesh. The first
+stage inverts the data low-passed at ``--cutoff`` and the second the full
+band.
+
+Usage::
+
+    python two_layer_fwi.py --output results/two_layer
+
+AI assistance: implementation by Claude (Anthropic), to be reviewed by the
+author.
+"""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+import numpy as np
+
+from spyro.adaptivity import (MeshAdaptiveFWI, MeshPolicy, ParameterGrid,
+                              RectangularDomain, Stage, VelocityGrid,
+                              generate_mesh, synthesize_observations)
+
+INTERFACE = -0.3
+FREQUENCY = 5.0
+DOMAIN = RectangularDomain(z_min=-1.0, x_min=0.0, x_max=1.2, pad=0.2)
+SOURCES = [(-0.05, 0.35), (-0.05, 0.6), (-0.05, 0.85)]
+RECEIVERS = [(-0.1, x) for x in np.linspace(0.2, 1.0, 17)]
+
+
+def true_velocity(z: np.ndarray, x: np.ndarray) -> np.ndarray:
+    """Water over a faster layer with a slow circular anomaly.
+
+    Parameters
+    ----------
+    z : numpy.ndarray
+        Depths (km).
+    x : numpy.ndarray
+        Horizontal positions (km).
+
+    Returns
+    -------
+    numpy.ndarray
+        Velocity (km/s).
+    """
+    z = np.asarray(z, dtype=float)
+    x = np.asarray(x, dtype=float)
+    layer = np.where(z > INTERFACE, 1.5, 2.5)
+    anomaly = -0.5 * np.exp(-((z + 0.55) ** 2 + (x - 0.6) ** 2) / 0.08 ** 2)
+    return layer + np.where(z > INTERFACE, 0.0, anomaly)
+
+
+def initial_velocity(z: np.ndarray, x: np.ndarray) -> np.ndarray:
+    """Water over a layer of 2.2 km/s.
+
+    Parameters
+    ----------
+    z : numpy.ndarray
+        Depths (km).
+    x : numpy.ndarray
+        Horizontal positions (km).
+
+    Returns
+    -------
+    numpy.ndarray
+        Velocity (km/s).
+    """
+    return np.where(np.asarray(z) > INTERFACE, 1.5, 2.2) + 0.0 * np.asarray(x)
+
+
+def model_dictionary(final_time: float) -> dict:
+    """spyro dictionary of the problem.
+
+    Parameters
+    ----------
+    final_time : float
+        Duration of the records (s).
+
+    Returns
+    -------
+    dict
+        KMV2 triangles, pressure-free top and non-reflecting bottom and sides.
+    """
+    return {
+        "options": {"cell_type": "T", "variant": "lumped", "degree": 2,
+                    "dimension": 2},
+        "parallelism": {"type": "spatial"},
+        "mesh": {"length_z": 1.0, "length_x": 1.2, "length_y": 0.0,
+                 "mesh_type": "user_mesh"},
+        "acquisition": {"source_type": "ricker", "source_locations": SOURCES,
+                        "frequency": FREQUENCY, "delay": 1.5,
+                        "delay_type": "multiples_of_minimum",
+                        "receiver_locations": RECEIVERS},
+        "absorving_boundary_conditions": {
+            "status": True, "abc_type": "nrbc", "free_surface": True,
+            "damping_layer": None},
+        "time_axis": {"initial_time": 0.0, "final_time": final_time,
+                      "dt": 1e-3, "amplitude": 1, "output_frequency": 10**9,
+                      "gradient_sampling_frequency": 1},
+        "visualization": {"forward_output": False, "forward_output_filename": None,
+                          "fwi_velocity_model_output": False,
+                          "velocity_model_filename": None, "gradient_output": False,
+                          "gradient_filename": None, "adjoint_output": False,
+                          "adjoint_filename": None, "debug_output": False},
+    }
+
+
+def main() -> None:
+    """Run the inversion with the command-line settings.
+
+    Returns
+    -------
+    None
+        Meshes, models and ``report_fwi.json`` are written to ``--output``.
+    """
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--final-time", type=float, default=0.9)
+    parser.add_argument("--cutoff", type=float, default=4.0, help="Hz, first stage")
+    parser.add_argument("--iterations", type=int, nargs=2, default=(8, 12))
+    parser.add_argument("--grid-spacing", type=float, default=0.04,
+                        help="km, parameter grid")
+    parser.add_argument("--element", choices=["Q1", "DG0"], default="Q1")
+    parser.add_argument("--strategy", choices=["adjoint", "gradient"],
+                        default="adjoint")
+    parser.add_argument("--noise", type=float, default=2e-4,
+                        help="noise floor in the norm of the misfit")
+    parser.add_argument("--audit-every", type=int, default=4)
+    parser.add_argument("--observed-cpw", type=float, default=8.0)
+    args = parser.parse_args()
+    output = Path(args.output)
+
+    dictionary = model_dictionary(args.final_time)
+    spacing = 0.005
+    z, x = DOMAIN.grid(spacing)
+    Z, X = np.meshgrid(z, x, indexing="ij")
+    fine_size = VelocityGrid(true_velocity(Z, X) / (args.observed_cpw * FREQUENCY),
+                             z[0], x[0], spacing, spacing)
+    observed_mesh = generate_mesh(output / "meshes" / "observed.msh", DOMAIN,
+                                  fine_size, [INTERFACE])
+    observed = synthesize_observations(dictionary, true_velocity,
+                                       str(observed_mesh))
+
+    grid = ParameterGrid(DOMAIN, args.grid_spacing, args.element)
+    gz = grid.origin[0] + grid.dz * np.arange(grid.shape[0])
+    gx = grid.origin[1] + grid.dx * np.arange(grid.shape[1])
+    GZ, GX = np.meshgrid(gz, gx, indexing="ij")
+    policy = MeshPolicy(noise_level=args.noise, strategy=args.strategy,
+                        audit_every=args.audit_every, max_dofs=20000)
+    fwi = MeshAdaptiveFWI(
+        dictionary, DOMAIN, grid, initial_velocity(GZ, GX), observed,
+        [Stage(args.iterations[0], cutoff=args.cutoff), Stage(args.iterations[1])],
+        policy, bounds=(1.4, 3.0), output_dir=output,
+        tao_options={"tao_gatol": 1e-12, "tao_grtol": 0.0, "tao_gttol": 0.0})
+    fwi.run()
+    if grid.comm.rank == 0:
+        np.save(output / "model_true.npy", true_velocity(GZ, GX))
+        np.save(output / "model_initial.npy", initial_velocity(GZ, GX))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/spyro/adaptivity/_firedrake_workarounds.py b/spyro/adaptivity/_firedrake_workarounds.py
new file mode 100644
index 0000000..17214c3
--- /dev/null
+++ b/spyro/adaptivity/_firedrake_workarounds.py
@@ -0,0 +1,64 @@
+"""Workarounds for Firedrake behaviour that long adaptive runs expose.
+
+AI assistance: implementation by Claude (Anthropic), reviewed by the author.
+"""
+from __future__ import annotations
+
+_STATE = {"unique_names_patched": False}
+
+
+def speed_up_unique_names() -> bool:
+    """Make pyop3's global unique-name generator constant time per name.
+
+    Firedrake names every function ``function_<n>`` or ``cofunction_<n>``
+    and pyop3 registers each name twice (the data and its buffer). The
+    second registration conflicts, and pytools then searches for a free name
+    counting up from ``<n>``, one step per name the process has created.
+    A run that creates one cofunction per time step, as the adjoint does,
+    gets slower with every solver it builds: after a few thousand time steps
+    the search costs more than the time step itself.
+
+    The patch continues such a name from the counter the generator already
+    keeps for its base. It changes no name that would be free, and it is
+    applied once per process.
+
+    Returns
+    -------
+    bool
+        Whether the generator is patched: ``False`` when this Firedrake has
+        no pyop3, where the search does not exist.
+    """
+    if _STATE["unique_names_patched"]:
+        return True
+    try:
+        from pyop3 import utils
+        from pytools import UNIQUE_NAME_GEN_COUNTER_RE
+    except ImportError:
+        return False
+    original = utils.UniqueNameGenerator.__call__
+
+    def unique_name(self: utils.UniqueNameGenerator, prefix: str) -> str:
+        """Return a new unique name, without a linear search.
+
+        Parameters
+        ----------
+        prefix : str
+            Name the new one is based on.
+
+        Returns
+        -------
+        str
+            A name the generator has not returned before.
+        """
+        if prefix not in self.prefix_to_counter:
+            match = UNIQUE_NAME_GEN_COUNTER_RE.match(prefix)
+            if match is not None:
+                base = match.group("based_on")
+                known = self.prefix_to_counter.get(base)
+                if known is not None and known > int(match.group("counter")):
+                    prefix = base
+        return original(self, prefix)
+
+    utils.UniqueNameGenerator.__call__ = unique_name
+    _STATE["unique_names_patched"] = True
+    return True
diff --git a/spyro/adaptivity/fwi_functional.py b/spyro/adaptivity/fwi_functional.py
new file mode 100644
index 0000000..f12b05f
--- /dev/null
+++ b/spyro/adaptivity/fwi_functional.py
@@ -0,0 +1,1109 @@
+"""FWI misfit on a fixed parameter grid, with the UFL-derived adjoint.
+
+The control :math:`m` lives on a regular parameter grid that never changes
+(:class:`ParameterGrid`); the wave is propagated on any triangular mesh. On
+each mesh the model is sampled at the nodes of the wave space,
+:math:`c_h = A_h m` (bilinear weights), and the derivative returns to the
+grid through the transpose applied explicitly,
+
+.. math::
+
+    DJ(m) = A_h^T\\, M_h\\, g_h,
+
+where :math:`g_h` is the gradient spyro's UFL-derived implemented adjoint
+returns in the lumped :math:`L^2` metric of the wave space and :math:`M_h`
+that lumped mass. The vector an optimizer sees therefore keeps its size when
+the wave mesh changes, and the model is never interpolated from one wave mesh
+to another.
+
+The misfit of shot :math:`s` is measured after the data processing
+:math:`B_s = W_s F` (low-pass filter, then window) of :class:`TraceOperator`,
+
+.. math::
+
+    J(m) = \\frac{1}{2} \\sum_s \\| B_s (d_s(m) - d_{obs,s}) \\|^2,
+    \\qquad \\|y\\|^2 = \\Delta t \\sum_n w_n \\sum_r y_{nr}^2,
+
+with :math:`w_n` the trapezoidal weights. The forward solve only records the
+traces; the adjoint source :math:`B_s^T W_t B_s (d_s - d_{obs,s})` is built
+from the complete traces before the reverse sweep, so a filter acts on
+traces and never on a source in time.
+
+The time step of a mesh is a fraction of the stability limit of that mesh
+with the *upper bound* of the velocity, so every model inside the bounds of
+the optimization is stable: mesh and time step stay fixed during a line
+search by construction.
+
+:class:`FWIFunctional` is a pyadjoint ``AbstractReducedFunctional`` without a
+tape, which :func:`spyro.tools.optimization.minimize_with_tao` minimizes.
+With shot parallelism each ensemble member evaluates it for its own shots,
+and :class:`EnsembleFWIFunctional`, an ``EnsembleReducedFunctional``, sums
+the members.
+"""
+
+from __future__ import annotations
+
+import gc
+import math
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass
+
+import numpy as np
+import firedrake as fire
+from firedrake.adjoint import EnsembleReducedFunctional
+from mpi4py import MPI
+from pyadjoint import Control
+from pyadjoint.enlisting import Enlist
+from pyadjoint.reduced_functional import AbstractReducedFunctional
+from scipy.sparse import csr_matrix
+
+from ..solvers.backward_time_integration import backward_wave_propagator
+from ..utils.typing import AdjointType
+from .mesh_generation import RectangularDomain
+from ._firedrake_workarounds import speed_up_unique_names
+from .pilot import TwoLevelPilot, Window, broken_nodes
+from .size_fields import VelocityGrid
+
+#: Firedrake family and degree of each parameter element.
+_ELEMENTS = {"Q1": ("Q", 1), "DG0": ("DQ", 0)}
+
+
+class ParameterGrid:
+    """Fixed regular grid that holds the control of the inversion.
+
+    The grid covers the padded domain with quadrilateral cells. Two elements
+    have a diagonal mass matrix, which the lumped :math:`L^2` metric of
+    :class:`~spyro.reduced_functionals.LumpedL2ReducedFunctional` needs:
+
+    ``"Q1"``
+        bilinear, with the values at the cell corners and the Gauss-Lobatto
+        quadrature;
+    ``"DG0"``
+        one value per cell, at its centre.
+
+    In both the model at a point is the bilinear interpolation of the
+    neighbouring values (corners or centres), constant beyond the outermost
+    ones, which is the sampling of :class:`VelocityGrid`.
+
+    A known top layer, such as the water above a sea floor, can be fixed with
+    ``fixed_layer``. Above its interface the model is the layer's value,
+    whatever the grid holds; below, the interpolation uses only the values
+    below the interface: a value above it is replaced, in the interpolation,
+    by the first value below it in the same column. The interface is then a
+    jump at its exact depth instead of a ramp one grid cell thick, and the
+    model stays linear in the grid values, so the derivative is exact. The
+    values above the interface do not change the model: their derivative is
+    zero.
+
+    Parameters
+    ----------
+    domain : RectangularDomain
+        Padded domain the grid covers.
+    spacing : float
+        Target cell size (km); adjusted so that the cells tile the domain.
+    element : str, optional
+        ``"Q1"`` (the default) or ``"DG0"``.
+    comm : mpi4py.MPI.Comm, optional
+        Communicator of the control. Default ``firedrake.COMM_WORLD``.
+    fixed_layer : tuple of float, optional
+        ``(depth, value)``: the model is ``value`` at the points strictly
+        above the horizontal interface at ``depth`` (km, negative
+        downwards). ``None`` (the default) has no fixed layer.
+
+    Attributes
+    ----------
+    space : firedrake.FunctionSpace
+        Space of the control.
+    shape : tuple of int
+        Shape ``(n_z, n_x)`` of the values as an array, both coordinates
+        increasing.
+    origin : tuple of float
+        Position ``(z, x)`` of the first value.
+    dz, dx : float
+        Spacing of the values.
+    fixed_layer : tuple of float or None
+        The fixed top layer.
+    """
+
+    def __init__(self, domain: RectangularDomain, spacing: float,
+                 element: str = "Q1", comm: MPI.Comm | None = None,
+                 fixed_layer: tuple[float, float] | None = None) -> None:
+        if element not in _ELEMENTS:
+            raise ValueError(f"element must be one of {sorted(_ELEMENTS)}.")
+        self.domain = domain
+        self.element = element
+        self.comm = fire.COMM_WORLD if comm is None else comm
+        self.fixed_layer = (None if fixed_layer is None
+                            else (float(fixed_layer[0]), float(fixed_layer[1])))
+        length_z = domain.z_max - domain.z_min
+        length_x = domain.x_max - domain.x_min
+        cells_z = max(1, round(length_z / spacing))
+        cells_x = max(1, round(length_x / spacing))
+        self.dz = length_z / cells_z
+        self.dx = length_x / cells_x
+        mesh = fire.RectangleMesh(cells_z, cells_x, length_z, length_x,
+                                  quadrilateral=True, comm=self.comm)
+        mesh.coordinates.dat.data[:, 0] += domain.z_min
+        mesh.coordinates.dat.data[:, 1] += domain.x_min
+        family, degree = _ELEMENTS[element]
+        self.space = fire.FunctionSpace(mesh, family, degree)
+        if element == "Q1":
+            self.shape = (cells_z + 1, cells_x + 1)
+            self.origin = (domain.z_min, domain.x_min)
+        else:
+            self.shape = (cells_z, cells_x)
+            self.origin = (domain.z_min + 0.5 * self.dz,
+                           domain.x_min + 0.5 * self.dx)
+        positions = fire.Function(
+            fire.VectorFunctionSpace(mesh, family, degree)
+        ).interpolate(mesh.coordinates).dat.data_ro
+        row = np.rint((positions[:, 0] - self.origin[0]) / self.dz).astype(int)
+        column = np.rint((positions[:, 1] - self.origin[1]) / self.dx).astype(int)
+        #: Position in the flattened array of each locally owned value.
+        self._flat_index = row * self.shape[1] + column
+        #: Values used by the interpolation, as a matrix of the grid values.
+        self._extension = self._layer_extension()
+
+    def _layer_extension(self) -> csr_matrix:
+        """Matrix that replaces the values above the fixed layer's interface.
+
+        Returns
+        -------
+        scipy.sparse.csr_matrix
+            Square matrix of size :attr:`size`: the identity, except that a
+            value above the interface takes the first value below it in its
+            column.
+
+        Raises
+        ------
+        ValueError
+            If a column has no value below the interface.
+        """
+        n_z, n_x = self.shape
+        source = np.arange(self.size).reshape(self.shape)
+        if self.fixed_layer is not None:
+            depths = self.origin[0] + self.dz * np.arange(n_z)
+            below = np.flatnonzero(depths <= self.fixed_layer[0])
+            if below.size == 0:
+                raise ValueError("The grid has no value below the fixed layer.")
+            # Rows go upwards: every row above the interface takes the
+            # highest row below it.
+            source[below[-1] + 1:, :] = source[below[-1], :]
+        return csr_matrix((np.ones(self.size), (np.arange(self.size),
+                                                source.ravel())),
+                          shape=(self.size, self.size))
+
+    def above_layer(self, z: np.ndarray) -> np.ndarray:
+        """Whether points are in the fixed layer.
+
+        Parameters
+        ----------
+        z : numpy.ndarray
+            Depths of the points.
+
+        Returns
+        -------
+        numpy.ndarray
+            Boolean, ``True`` strictly above the interface; all ``False``
+            without a fixed layer.
+        """
+        z = np.asarray(z, dtype=float)
+        if self.fixed_layer is None:
+            return np.zeros(z.shape, dtype=bool)
+        return z > self.fixed_layer[0]
+
+    def fixed_values(self, z: np.ndarray) -> np.ndarray:
+        """Part of the model that does not depend on the grid values.
+
+        The model at points is ``sampling_matrix(z, x) @ values +
+        fixed_values(z)``.
+
+        Parameters
+        ----------
+        z : numpy.ndarray
+            Depths of the points.
+
+        Returns
+        -------
+        numpy.ndarray
+            The layer's value in the fixed layer, zero elsewhere.
+        """
+        if self.fixed_layer is None:
+            return np.zeros(np.shape(z))
+        return np.where(self.above_layer(z), self.fixed_layer[1], 0.0)
+
+    @property
+    def size(self) -> int:
+        """Number of values of the grid.
+
+        Returns
+        -------
+        int
+            ``n_z * n_x``.
+        """
+        return self.shape[0] * self.shape[1]
+
+    def to_array(self, field: fire.Function | fire.Cofunction) -> np.ndarray:
+        """Return a field of the control space as an array.
+
+        Parameters
+        ----------
+        field : firedrake.Function or firedrake.Cofunction
+            Field in the control space or in its dual.
+
+        Returns
+        -------
+        numpy.ndarray
+            Values of shape :attr:`shape`, the same on every process.
+        """
+        flat = np.zeros(self.size)
+        flat[self._flat_index] = field.dat.data_ro
+        return self.comm.allreduce(flat).reshape(self.shape)
+
+    def function(self, values: np.ndarray | float,
+                 name: str = "velocity") -> fire.Function:
+        """Return a model of the control space from an array.
+
+        Parameters
+        ----------
+        values : numpy.ndarray or float
+            Values of shape :attr:`shape`, or one value for all of them.
+        name : str, optional
+            Name of the function.
+
+        Returns
+        -------
+        firedrake.Function
+            The model.
+        """
+        model = fire.Function(self.space, name=name)
+        flat = np.broadcast_to(np.asarray(values, dtype=float), self.shape).ravel()
+        model.dat.data_wo[:] = flat[self._flat_index]
+        return model
+
+    def cofunction(self, values: np.ndarray) -> fire.Cofunction:
+        """Return a derivative in the dual of the control space from an array.
+
+        Parameters
+        ----------
+        values : numpy.ndarray
+            Derivative with respect to each value, of shape :attr:`shape`.
+
+        Returns
+        -------
+        firedrake.Cofunction
+            The derivative.
+        """
+        derivative = fire.Cofunction(self.space.dual())
+        derivative.dat.data_wo[:] = np.asarray(values).ravel()[self._flat_index]
+        return derivative
+
+    def sampler(self, values: np.ndarray) -> VelocityGrid:
+        """Return the model as a callable of the position.
+
+        Parameters
+        ----------
+        values : numpy.ndarray
+            Values of shape :attr:`shape`.
+
+        Returns
+        -------
+        VelocityGrid
+            ``model(z, x)``, the bilinear interpolation of the values, with
+            the fixed layer when the grid has one.
+        """
+        extended = self._extension @ np.asarray(values, dtype=float).ravel()
+        return VelocityGrid(extended.reshape(self.shape), self.origin[0],
+                            self.origin[1], self.dz, self.dx,
+                            fixed_layer=self.fixed_layer)
+
+    def sampling_matrix(self, z: np.ndarray, x: np.ndarray) -> csr_matrix:
+        """Matrix that samples the model at points.
+
+        Row ``i`` holds the bilinear weights of point ``i``; they are the
+        weights of :meth:`sampler`, written as a matrix so that the transpose
+        can be applied. With a fixed layer, the rows of the points in it are
+        zero (add :meth:`fixed_values`) and the others interpolate only the
+        values below the interface.
+
+        Parameters
+        ----------
+        z : numpy.ndarray
+            Depths of the points.
+        x : numpy.ndarray
+            Horizontal positions of the points.
+
+        Returns
+        -------
+        scipy.sparse.csr_matrix
+            Matrix of shape ``(n_points, size)``.
+        """
+        n_z, n_x = self.shape
+        fz = np.clip((np.asarray(z, dtype=float) - self.origin[0]) / self.dz,
+                     0, n_z - 1.000001)
+        fx = np.clip((np.asarray(x, dtype=float) - self.origin[1]) / self.dx,
+                     0, n_x - 1.000001)
+        i = fz.astype(int)
+        j = fx.astype(int)
+        tz = fz - i
+        tx = fx - j
+        rows = np.tile(np.arange(len(i)), 4)
+        columns = np.concatenate([i * n_x + j, (i + 1) * n_x + j,
+                                  i * n_x + j + 1, (i + 1) * n_x + j + 1])
+        weights = np.concatenate([(1 - tz) * (1 - tx), tz * (1 - tx),
+                                  (1 - tz) * tx, tz * tx])
+        weights *= np.tile(~self.above_layer(z), 4)
+        bilinear = csr_matrix((weights, (rows, columns)), shape=(len(i), self.size))
+        return (bilinear @ self._extension).tocsr()
+
+
+def time_weights(steps: int) -> np.ndarray:
+    """Trapezoidal weights of a record, without the time step.
+
+    Parameters
+    ----------
+    steps : int
+        Number of samples.
+
+    Returns
+    -------
+    numpy.ndarray
+        Ones, with one half at both ends.
+    """
+    weights = np.ones(steps)
+    weights[[0, -1]] = 0.5
+    return weights
+
+
+class TraceOperator:
+    """Data processing :math:`B = W F` of the misfit: low-pass, then window.
+
+    The filter is zero phase, with the squared magnitude of a Butterworth
+    filter, applied in the frequency domain to the record padded with zeros
+    at both ends. It is a symmetric matrix, :math:`F^T = F`, so the transpose
+    :math:`B^T = F W` is exact, edges included.
+
+    Parameters
+    ----------
+    window : callable, optional
+        ``window(times, shot)`` returning the weights ``(n_times,
+        n_receivers)`` of the samples (a boolean mask or smooth weights).
+        ``None`` keeps the full traces.
+    cutoff : float, optional
+        Cut-off frequency of the low-pass filter (Hz). ``None`` (the
+        default) does not filter.
+    order : int, optional
+        Order of the Butterworth magnitude. Default ``4``.
+    pad_periods : float, optional
+        Zero padding at each end, in periods of the cut-off. Default ``4``.
+    """
+
+    def __init__(self, window: Window | None = None, cutoff: float | None = None,
+                 order: int = 4, pad_periods: float = 4.0) -> None:
+        self.window = window
+        self.cutoff = cutoff
+        self.order = order
+        self.pad_periods = pad_periods
+
+    def weights(self, steps: int, dt: float, shot: int) -> np.ndarray | float:
+        """Window of one shot on the time axis of a record.
+
+        Parameters
+        ----------
+        steps : int
+            Number of recorded steps.
+        dt : float
+            Time step (s).
+        shot : int
+            Source index.
+
+        Returns
+        -------
+        numpy.ndarray or float
+            Weights ``(steps, n_receivers)``, or ``1.0`` without a window.
+        """
+        if self.window is None:
+            return 1.0
+        # spyro records the state after each step: sample n is at (n + 1) dt.
+        return np.asarray(self.window((np.arange(steps) + 1) * dt, shot), dtype=float)
+
+    def low_pass(self, record: np.ndarray, dt: float) -> np.ndarray:
+        """Apply the filter :math:`F` along the time axis.
+
+        Parameters
+        ----------
+        record : numpy.ndarray
+            Traces ``(steps, n_receivers)``.
+        dt : float
+            Time step (s).
+
+        Returns
+        -------
+        numpy.ndarray
+            Filtered traces, of the same shape; the record itself when there
+            is no cut-off.
+        """
+        if self.cutoff is None:
+            return record
+        steps = record.shape[0]
+        pad = int(math.ceil(self.pad_periods / (self.cutoff * dt)))
+        padded = np.zeros((steps + 2 * pad,) + record.shape[1:])
+        padded[pad:pad + steps] = record
+        frequencies = np.fft.rfftfreq(len(padded), dt)
+        response = 1.0 / (1.0 + (frequencies / self.cutoff) ** (2 * self.order))
+        spectrum = np.fft.rfft(padded, axis=0) * response[:, None]
+        return np.fft.irfft(spectrum, len(padded), axis=0)[pad:pad + steps]
+
+    def apply(self, record: np.ndarray, dt: float, shot: int) -> np.ndarray:
+        """Return :math:`B d`.
+
+        Parameters
+        ----------
+        record : numpy.ndarray
+            Traces ``(steps, n_receivers)``.
+        dt : float
+            Time step (s).
+        shot : int
+            Source index.
+
+        Returns
+        -------
+        numpy.ndarray
+            Processed traces.
+        """
+        return self.weights(record.shape[0], dt, shot) * self.low_pass(record, dt)
+
+    def transpose(self, record: np.ndarray, dt: float, shot: int) -> np.ndarray:
+        """Return :math:`B^T y`.
+
+        Parameters
+        ----------
+        record : numpy.ndarray
+            Processed-trace residual ``(steps, n_receivers)``.
+        dt : float
+            Time step (s).
+        shot : int
+            Source index.
+
+        Returns
+        -------
+        numpy.ndarray
+            Its transpose image in the space of the traces.
+        """
+        return self.low_pass(self.weights(record.shape[0], dt, shot) * record, dt)
+
+    @staticmethod
+    def norm(record: np.ndarray, dt: float) -> float:
+        """Norm of processed traces, :math:`(\\Delta t \\sum_n w_n \\sum_r y_{nr}^2)^{1/2}`.
+
+        Parameters
+        ----------
+        record : numpy.ndarray
+            Traces ``(steps, n_receivers)``.
+        dt : float
+            Time step (s).
+
+        Returns
+        -------
+        float
+            The norm, in absolute units.
+        """
+        weights = time_weights(record.shape[0])
+        return float(np.sqrt(dt * np.sum(weights[:, None] * record ** 2)))
+
+
+@dataclass
+class ObservedData:
+    """Observed records on their own time axis.
+
+    Parameters
+    ----------
+    records : sequence of numpy.ndarray
+        One record ``(n_samples, n_receivers)`` per shot; sample ``n`` is at
+        ``(n + 1) dt``, as spyro records.
+    dt : float
+        Sampling interval (s).
+    """
+
+    records: Sequence[np.ndarray]
+    dt: float
+
+    def at(self, shot: int, steps: int, dt: float) -> np.ndarray:
+        """Resample the record of a shot on the time axis of a solver.
+
+        Parameters
+        ----------
+        shot : int
+            Source index.
+        steps : int
+            Number of steps of the solver.
+        dt : float
+            Time step of the solver (s).
+
+        Returns
+        -------
+        numpy.ndarray
+            Record ``(steps, n_receivers)`` by linear interpolation, zero at
+            time zero and held at the last sample beyond the recorded time.
+        """
+        record = np.asarray(self.records[shot])
+        times = np.arange(record.shape[0] + 1) * self.dt
+        target = (np.arange(steps) + 1) * dt
+        padded = np.vstack([np.zeros((1, record.shape[1])), record])
+        return np.column_stack([np.interp(target, times, padded[:, r])
+                                for r in range(record.shape[1])])
+
+
+def synthesize_observations(dictionary: dict,
+                            velocity: Callable[[np.ndarray, np.ndarray], np.ndarray],
+                            mesh_file: str, dt_fraction: float = 0.5
+                            ) -> ObservedData:
+    """Propagate every shot of a model on a mesh, as observed data.
+
+    Parameters
+    ----------
+    dictionary : dict
+        spyro model dictionary with the acquisition and the time axis.
+    velocity : callable
+        ``velocity(z, x)`` of the model that generates the data.
+    mesh_file : str
+        Mesh of the propagation, which should be independent of (and finer
+        than) the meshes of the inversion.
+    dt_fraction : float, optional
+        Fraction of the critical time step of that mesh. Default ``0.5``.
+
+    Returns
+    -------
+    ObservedData
+        The records of all shots.
+    """
+    pilot = TwoLevelPilot(dictionary, velocity)
+    mesh = pilot.load_meshes(mesh_file)[0]
+    dt = dt_fraction * pilot.critical_time_step(mesh)
+    records = [pilot.shot_record(shot, mesh, dt)
+               for shot in range(pilot.number_of_shots)]
+    return ObservedData(records, dt)
+
+
+class GridProjection:
+    """Lumped :math:`L^2` projection of the parameter grid onto a velocity space.
+
+    The velocity at the node :math:`i` of the wave mesh is the average of the
+    grid field weighted by its basis function,
+
+    .. math::
+
+        c_i = \\frac{\\int \\varphi_i\\, m\\, dx}{\\int \\varphi_i\\, dx},
+
+    so a constant stays constant, and the transpose sends a derivative back
+    to the grid as the integral of the gradient field against each grid basis
+    function: every grid node receives the weight of its own area, whatever
+    the nodes of the wave mesh. Sampling the grid at the nodes instead
+    weights each grid node by the wave nodes that happen to fall near it,
+    which imprints the wave mesh on the model when the grid is finer than
+    the node spacing.
+
+    The integrals use a collapsed Gauss rule on each cell of the wave mesh,
+    fine enough to resolve the grid cells (about two points per grid spacing
+    along the longest cell). The fixed layer of the grid enters through the
+    grid field, so an element above the interface keeps the fixed value.
+
+    Parameters
+    ----------
+    grid : ParameterGrid
+        Parameter grid of the control.
+    space : firedrake.FunctionSpace
+        Space of the velocity on the wave mesh.
+
+    Attributes
+    ----------
+    degree : int
+        Degree of the quadrature rule.
+    """
+
+    def __init__(self, grid: ParameterGrid, space: fire.FunctionSpace) -> None:
+        mesh = space.mesh()
+        diameters = fire.Function(fire.FunctionSpace(mesh, "DG", 0)).interpolate(
+            fire.CellDiameter(mesh)).dat.data_ro
+        longest = mesh.comm.allreduce(float(diameters.max(initial=0.0)), op=MPI.MAX)
+        points = int(np.clip(np.ceil(2.0 * longest / min(grid.dz, grid.dx)), 3, 24))
+        self.degree = 2 * points - 1
+        element = fire.FiniteElement("Quadrature", mesh.ufl_cell(), self.degree,
+                                     quad_scheme="canonical")
+        quadrature = fire.FunctionSpace(mesh, element)
+        coordinates = fire.Function(fire.VectorFunctionSpace(mesh, element)).interpolate(
+            fire.SpatialCoordinate(mesh)).dat.data_ro_with_halos
+        self._measure = fire.dx(degree=self.degree, scheme="canonical")
+        self._space = space
+        self._field = fire.Function(quadrature)
+        self._sampling = grid.sampling_matrix(coordinates[:, 0], coordinates[:, 1])
+        self._fixed = grid.fixed_values(coordinates[:, 0])
+        self._owned = len(self._field.dat.data_ro)
+        self._weights = fire.assemble(
+            fire.TestFunction(quadrature) * self._measure).dat.data_ro.copy()
+        self._integrals = fire.assemble(
+            fire.TestFunction(space) * self._measure).dat.data_ro.copy()
+
+    def apply(self, model: np.ndarray) -> np.ndarray:
+        """Project a grid model onto the velocity space.
+
+        Parameters
+        ----------
+        model : numpy.ndarray
+            Model on the grid.
+
+        Returns
+        -------
+        numpy.ndarray
+            Values of the velocity at the locally owned nodes.
+        """
+        self._field.dat.data_with_halos[:] = (self._sampling @ np.ravel(model)
+                                              + self._fixed)
+        moments = fire.assemble(fire.TestFunction(self._space) * self._field
+                                * self._measure)
+        return moments.dat.data_ro / self._integrals
+
+    def transpose(self, dual: np.ndarray) -> np.ndarray:
+        """Apply the transpose of :meth:`apply` to a derivative.
+
+        Parameters
+        ----------
+        dual : numpy.ndarray
+            Derivative with respect to the velocity at the locally owned
+            nodes (a cofunction of the velocity space).
+
+        Returns
+        -------
+        numpy.ndarray
+            This process's part of the derivative with respect to the grid
+            values, flattened; the sum over the processes is the derivative.
+        """
+        scaled = fire.Function(self._space)
+        scaled.dat.data[:] = dual / self._integrals
+        values = fire.Function(self._field.function_space()).interpolate(scaled)
+        owned = self._sampling[:self._owned]
+        return owned.T @ (self._weights * values.dat.data_ro)
+
+
+class FWIFunctional(AbstractReducedFunctional):
+    """FWI misfit of a model on the parameter grid, for one wave mesh.
+
+    Building the functional builds every solver object of the mesh: the mesh
+    itself, one acoustic wave per shot, the sampling matrix and the time
+    step. A new mesh is a new functional, started from the current model.
+
+    Parameters
+    ----------
+    dictionary : dict
+        spyro model dictionary (acquisition, time axis, boundaries); its mesh
+        entries and time step are replaced.
+    mesh_file : str
+        Wave mesh (gmsh file in spyro's ``(z, x)`` convention).
+    grid : ParameterGrid
+        Parameter grid of the control.
+    model : numpy.ndarray
+        Starting model on the grid, of shape ``grid.shape``.
+    observed : ObservedData
+        Observed records.
+    operator : TraceOperator
+        Data processing of the misfit.
+    upper_bound : numpy.ndarray or float
+        Upper bound of the velocity on the grid, which sets the time step.
+    dt_fraction : float, optional
+        Fraction of the critical time step at the upper bound. Default ``0.7``.
+    store_forward : bool, optional
+        Keep the forward states of every shot when the functional is
+        evaluated, so that the derivative at the same model does not
+        propagate again. ``False`` stores one shot at a time, in the
+        derivative, at the cost of one more forward per shot. Default
+        ``True``.
+    gradient_mask : numpy.ndarray, optional
+        Weights of shape ``grid.shape`` that multiply the derivative, zero
+        where the model is known (the water). The optimiser then never moves
+        those values. Where the mask is zero but :math:`J` depends on the
+        value, the masked derivative is no longer the derivative of
+        :math:`J`: mask only values the model does not depend on (above a
+        fixed layer of the grid) or that the bounds already fix. ``None``
+        (the default) does not mask.
+    discontinuous_velocity : bool, optional
+        Put the velocity in the broken copy of the wave space, sampled
+        element by element (see
+        :func:`~spyro.adaptivity.pilot.broken_velocity`), so that a fixed
+        layer of the grid jumps exactly on the interface the mesh conforms
+        to. The derivative is taken in that space. Default ``False``.
+    transfer : {"projection", "sampling"}, optional
+        How the grid model becomes the velocity of the wave mesh:
+        ``"projection"`` (the default), the lumped :math:`L^2` projection of
+        :class:`GridProjection`, which does not imprint the wave mesh on the
+        derivative; ``"sampling"``, the grid evaluated at the nodes of the
+        velocity.
+    ensemble : firedrake.Ensemble, optional
+        Shot parallelism: the functional of this member covers only its shots
+        (see :attr:`~spyro.adaptivity.pilot.TwoLevelPilot.local_shots`), on
+        the processes of ``ensemble.comm``, the communicator of ``grid``.
+        :class:`EnsembleFWIFunctional` sums the members. ``None`` (the
+        default) covers every shot.
+    refinements : int, optional
+        Uniform refinements of ``mesh_file`` (each triangle split in four)
+        the waves run on. A refined functional at half the time step is the
+        reference of the audits of the mesh. Default ``0``.
+    dt : float or None, optional
+        Time step (s), instead of ``dt_fraction`` of the critical one. It must
+        be stable at the upper bound. Default ``None``.
+
+    Attributes
+    ----------
+    shots : list of int
+        Shots of the functional, in the order of its waves.
+    dt : float
+        Time step of the mesh (s).
+    steps : int
+        Number of time steps.
+    dofs : int
+        Degrees of freedom of the wave space.
+    value : float or None
+        Functional at the last model evaluated.
+    first_value : float or None
+        Functional at the first model evaluated, the starting point.
+    shot_residuals : list of float
+        :math:`\\|B_s(d_s - d_{obs,s})\\|` of each shot of :attr:`shots` at
+        the last model.
+    records : list of numpy.ndarray
+        Receiver records :math:`d_s` of each shot of :attr:`shots` at the
+        last model, before the data processing, ``(steps, n_receivers)``;
+        sample ``n`` is at time ``(n + 1) dt``.
+    forwards, adjoints : int
+        Number of forward and of adjoint propagations so far.
+
+    Raises
+    ------
+    NotImplementedError
+        If the dictionary asks for the damping layer, whose strength follows
+        the largest velocity of the model and is not differentiated.
+    ValueError
+        If ``transfer`` is not one of the two transfers.
+    """
+
+    def __init__(self, dictionary: dict, mesh_file: str, grid: ParameterGrid,
+                 model: np.ndarray, observed: ObservedData,
+                 operator: TraceOperator, upper_bound: np.ndarray | float,
+                 dt_fraction: float = 0.7, store_forward: bool = True,
+                 gradient_mask: np.ndarray | None = None,
+                 discontinuous_velocity: bool = False,
+                 ensemble: fire.Ensemble | None = None,
+                 transfer: str = "projection", refinements: int = 0,
+                 dt: float | None = None) -> None:
+        super().__init__()
+        speed_up_unique_names()
+        if transfer not in ("projection", "sampling"):
+            raise ValueError("transfer must be 'projection' or 'sampling'.")
+        self.gradient_mask = (None if gradient_mask is None else
+                              np.asarray(gradient_mask, dtype=float).reshape(grid.shape))
+        abc = dictionary.get("absorving_boundary_conditions", {})
+        if abc.get("damping_layer") is not None:
+            raise NotImplementedError(
+                "The damping layer scales with the largest velocity of the "
+                "model, a dependence its gradient does not include.")
+        self.grid = grid
+        self.operator = operator
+        self.store_forward = store_forward
+        self.mesh_file = str(mesh_file)
+        upper = np.broadcast_to(np.asarray(upper_bound, dtype=float), grid.shape)
+        self.discontinuous_velocity = discontinuous_velocity
+        # The pilot is used here only as the builder of single-shot waves.
+        self._builder = TwoLevelPilot(dictionary, grid.sampler(upper),
+                                      discontinuous_velocity=discontinuous_velocity,
+                                      ensemble=ensemble)
+        self.shots = self._builder.local_shots
+        self.mesh = self._builder.load_meshes(self.mesh_file, refinements)[-1]
+        self.dt = (dt_fraction * self._builder.critical_time_step(self.mesh)
+                   if dt is None else float(dt))
+        self._builder.velocity = grid.sampler(model)
+        self.waves = [self._builder._wave(shot, self.mesh) for shot in self.shots]
+        for wave in self.waves:
+            wave.dt = self.dt
+        space = self.waves[0].function_space
+        self.dofs = space.dim()
+        self.steps = int(self._builder.final_time / self.dt) + 1
+        # The velocity has its own space: the wave's, or its broken copy.
+        velocity_space = self.waves[0].initial_velocity_model.function_space()
+        self._projection = None
+        self._sampling = None
+        self._fixed = None
+        if transfer == "projection":
+            self._projection = GridProjection(grid, velocity_space)
+        else:
+            owned = len(self.waves[0].initial_velocity_model.dat.data_ro)
+            if discontinuous_velocity:
+                points = broken_nodes(space)[1][:owned]
+            else:
+                points = fire.Function(
+                    fire.VectorFunctionSpace(self.mesh, space.ufl_element())
+                ).interpolate(self.mesh.coordinates).dat.data_ro
+            self._sampling = grid.sampling_matrix(points[:, 0], points[:, 1])
+            #: Model at the velocity's points that does not depend on the control.
+            self._fixed = grid.fixed_values(points[:, 0])
+        measure = fire.dx(**self.waves[0].quadrature_rule)
+        self._lumped_mass = fire.assemble(
+            fire.TestFunction(velocity_space) * measure).dat.data_ro.copy()
+        self._observed = [
+            operator.apply(observed.at(shot, self.steps, self.dt), self.dt, shot)
+            for shot in self.shots]
+        self.observed_norms = [operator.norm(d, self.dt) for d in self._observed]
+        self._control = Control(grid.function(model))
+        self._model = np.array(model, dtype=float)
+        self._residuals = [None] * len(self.waves)
+        self.records = [None] * len(self.waves)
+        self.value = None
+        self.first_value = None
+        self.shot_residuals = []
+        self.forwards = 0
+        self.adjoints = 0
+
+    @property
+    def controls(self) -> Enlist:
+        """:class:`pyadjoint.enlisting.Enlist`: the model on the parameter grid."""
+        return Enlist([self._control])
+
+    def _velocity(self) -> np.ndarray:
+        """Velocity of the wave mesh at the current model.
+
+        Returns
+        -------
+        numpy.ndarray
+            Values at the locally owned nodes of the velocity space.
+        """
+        if self._projection is not None:
+            return self._projection.apply(self._model)
+        return self._sampling @ self._model.ravel() + self._fixed
+
+    def _forward(self, index: int, store: bool) -> None:
+        """Propagate one shot at the current model and keep its residual.
+
+        Parameters
+        ----------
+        index : int
+            Position of the shot in :attr:`shots`.
+        store : bool
+            Keep every forward state, for the adjoint.
+
+        Returns
+        -------
+        None
+            The residual of the shot is stored.
+        """
+        wave = self.waves[index]
+        wave.initial_velocity_model.dat.data[:] = self._velocity()
+        wave.store_forward_time_steps = store
+        wave.forward_solve()
+        self.forwards += 1
+        self.records[index] = np.array(wave.forward_solution_receivers)
+        self._residuals[index] = (
+            self.operator.apply(self.records[index], self.dt, self.shots[index])
+            - self._observed[index])
+
+    def __call__(self, values: fire.Function | Sequence[fire.Function]) -> float:
+        """Return :math:`J(m)`.
+
+        Parameters
+        ----------
+        values : firedrake.Function or sequence of firedrake.Function
+            Model in the control space.
+
+        Returns
+        -------
+        float
+            The misfit summed over the shots of :attr:`shots`.
+        """
+        self._model = self.grid.to_array(Enlist(values)[0])
+        for index in range(len(self.waves)):
+            self._forward(index, self.store_forward)
+        self.shot_residuals = [self.operator.norm(r, self.dt)
+                               for r in self._residuals]
+        self.value = 0.5 * sum(r ** 2 for r in self.shot_residuals)
+        if self.first_value is None:
+            self.first_value = self.value
+        return self.value
+
+    def derivative_array(self) -> np.ndarray:
+        """Derivative of :math:`J` at the last model, as an array on the grid.
+
+        Returns
+        -------
+        numpy.ndarray
+            :math:`\\partial J/\\partial m_{ij}`, of shape ``grid.shape``.
+
+        Raises
+        ------
+        RuntimeError
+            If the functional has not been evaluated.
+        """
+        if self.value is None:
+            raise RuntimeError("Evaluate the functional before its derivative.")
+        weights = time_weights(self.steps)[:, None]
+        total = np.zeros(self.grid.size)
+        for index, wave in enumerate(self.waves):
+            if not wave.forward_solution:
+                # The states were not stored, or an earlier derivative used
+                # them: the reverse sweep consumes the stored forward.
+                self._forward(index, True)
+            # spyro injects the misfit with the trapezoidal weights and the
+            # time step of its own, and with the sign of observed minus
+            # computed.
+            wave.misfit = -self.operator.transpose(
+                weights * self._residuals[index], self.dt, self.shots[index]) / weights
+            gradient = backward_wave_propagator(
+                wave, adjoint_type=AdjointType.UFL_DERIVED_ADJOINT)
+            self.adjoints += 1
+            dual = self._lumped_mass * gradient.dat.data_ro
+            local = (self._projection.transpose(dual) if self._projection is not None
+                     else self._sampling.T @ dual)
+            total += self.grid.comm.allreduce(local)
+            wave.misfit = None
+            gc.collect()
+        total = total.reshape(self.grid.shape)
+        if self.gradient_mask is not None:
+            total = total * self.gradient_mask
+        return total
+
+    def derivative(self, adj_input: float = 1.0, apply_riesz: bool = False
+                   ) -> fire.Cofunction | fire.Function:
+        """Return :math:`DJ(m)` at the last model evaluated.
+
+        Parameters
+        ----------
+        adj_input : float, optional
+            Adjoint value of the functional result.
+        apply_riesz : bool, optional
+            Return the gradient in the lumped :math:`L^2` metric of the grid
+            instead of the derivative.
+
+        Returns
+        -------
+        firedrake.Cofunction or firedrake.Function
+            The derivative in the dual of the control space, or the gradient.
+        """
+        derivative = self.grid.cofunction(adj_input * self.derivative_array())
+        if not apply_riesz:
+            return derivative
+        mass = fire.assemble(fire.TestFunction(self.grid.space) * fire.dx)
+        gradient = fire.Function(self.grid.space)
+        gradient.dat.data_wo[:] = derivative.dat.data_ro / mass.dat.data_ro
+        return gradient
+
+    def tlm(self, m_dot: fire.Function) -> None:
+        """Not provided: the inversion uses first derivatives only.
+
+        Parameters
+        ----------
+        m_dot : firedrake.Function
+            Direction.
+
+        Raises
+        ------
+        NotImplementedError
+            Always.
+        """
+        raise NotImplementedError("FWIFunctional has no tangent linear model.")
+
+    def hessian(self, m_dot: fire.Function, hessian_input: float | None = None,
+                evaluate_tlm: bool = True, apply_riesz: bool = False) -> None:
+        """Not provided: the inversion uses first derivatives only.
+
+        Parameters
+        ----------
+        m_dot : firedrake.Function
+            Direction.
+        hessian_input : float, optional
+            Hessian value of the functional result.
+        evaluate_tlm : bool, optional
+            Whether to evaluate the tangent linear model first.
+        apply_riesz : bool, optional
+            Whether to return the primal result.
+
+        Raises
+        ------
+        NotImplementedError
+            Always.
+        """
+        raise NotImplementedError("FWIFunctional has no Hessian action.")
+
+
+class EnsembleFWIFunctional(EnsembleReducedFunctional):
+    """FWI misfit summed over the members of an ensemble, one set of shots each.
+
+    Firedrake's ``EnsembleReducedFunctional`` for :class:`FWIFunctional`:
+    each member evaluates the misfit of its own shots and its derivative by
+    the UFL-derived adjoint, and the ensemble sums the values and the
+    derivatives, so every member holds the total and the optimiser takes the
+    same steps on every member. The base class builds its local functional
+    from a pyadjoint tape; here the local functional is given, since
+    :class:`FWIFunctional` records no tape.
+
+    Parameters
+    ----------
+    local : FWIFunctional
+        Functional of this member's shots, built with ``ensemble``.
+    ensemble : firedrake.Ensemble
+        The ensemble of the shots.
+
+    Attributes
+    ----------
+    value : float or None
+        Total functional at the last model evaluated.
+    first_value : float or None
+        Total functional at the first model evaluated.
+    """
+
+    def __init__(self, local: FWIFunctional, ensemble: fire.Ensemble) -> None:
+        self.local_reduced_functional = local
+        self.ensemble = ensemble
+        self.scatter_control = True
+        self.gather_functional = None
+        self.value = None
+        self.first_value = None
+
+    def __call__(self, values: fire.Function | Sequence[fire.Function]) -> float:
+        """Return the total :math:`J(m)`.
+
+        Parameters
+        ----------
+        values : firedrake.Function or sequence of firedrake.Function
+            Model in the control space.
+
+        Returns
+        -------
+        float
+            The misfit summed over every shot.
+        """
+        self.value = float(super().__call__(values))
+        if self.first_value is None:
+            self.first_value = self.value
+        return self.value
+
+    @property
+    def dofs(self) -> int:
+        """int: degrees of freedom of the wave space."""
+        return self.local_reduced_functional.dofs
+
+    @property
+    def dt(self) -> float:
+        """float: time step of the mesh (s)."""
+        return self.local_reduced_functional.dt
+
+    @property
+    def steps(self) -> int:
+        """int: number of time steps."""
+        return self.local_reduced_functional.steps
+
+    @property
+    def forwards(self) -> int:
+        """int: forward propagations of every member (collective)."""
+        return self.ensemble.ensemble_comm.allreduce(
+            self.local_reduced_functional.forwards)
+
+    @property
+    def adjoints(self) -> int:
+        """int: adjoint propagations of every member (collective)."""
+        return self.ensemble.ensemble_comm.allreduce(
+            self.local_reduced_functional.adjoints)
