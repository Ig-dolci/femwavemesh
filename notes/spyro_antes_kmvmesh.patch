+def test_minimize_with_tao_stops_when_record_asks() -> None:
+    """A true value from ``record`` ends TAO at that iterate, without warning."""
+    mesh = fire.UnitSquareMesh(4, 4)
+    space = fire.FunctionSpace(mesh, "DG", 0)
+    set_working_tape(Tape())
+    continue_annotation()
+    m = fire.Function(space).assign(3.0)
+    x = fire.SpatialCoordinate(mesh)[0]
+    J = fire.assemble(((m - 1.0 - x) ** 4 + (m - 1.0) ** 2) * fire.dx)
+    pause_annotation()
+    functional = ReducedFunctional(J, Control(m))
+    seen = []
+
+    def record(iteration: int, value: float, controls: list,
+               gradient_norm: float) -> bool:
+        """Stop at the second accepted iterate.
+
+        Parameters
+        ----------
+        iteration : int
+            Iteration.
+        value : float
+            Functional.
+        controls : list
+            Iterate.
+        gradient_norm : float
+            Norm of the projected gradient.
+
+        Returns
+        -------
+        bool
+            Whether to stop.
+        """
+        assert gradient_norm > 0.0
+        seen.append((iteration, value, controls[0].dat.data_ro.copy()))
+        return iteration == 2
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        solution = minimize_with_tao(functional, record=record,
+                                     options={"tao_max_it": 50})
+    set_working_tape(Tape())
+    assert [entry[0] for entry in seen] == [1, 2]
+    assert np.allclose(solution[0].dat.data_ro, seen[-1][2])
+
+
+@heavy
+def test_mesh_adaptive_fwi_reduces_misfit(tmp_path) -> None:
+    """A short inversion designs, verifies and audits its mesh and lowers J."""
+    data = dictionary()
+    observed = synthesize_observations(
+        data, two_layer, cpw_mesh(tmp_path / "observed.msh", 6.0))
+    grid = ParameterGrid(DOMAIN, 0.05)
+    Z, X = grid_positions(grid)
+    initial = np.where(Z > INTERFACE, 1.5, 2.2)
+    policy = MeshPolicy(noise_level=1e-4, audit_every=2, max_dofs=6000)
+    fwi = MeshAdaptiveFWI(data, DOMAIN, grid, initial, observed, [Stage(4)],
+                          policy, bounds=(1.4, 3.0), output_dir=tmp_path)
+    report = fwi.run()
+    kinds = [event["event"] for event in report["events"]]
+    assert "initial_phase" in kinds and "verification" in kinds
+    audits = [event for event in report["events"] if event["event"] == "audit"]
+    assert audits
+    for event in audits:
+        # The audit splits the error and measures the gradient error.
+        assert len(event["E_time"]) == len(event["E"]) == 2
+        assert event["gradient_error"] >= 0.0 and event["gradient_norm"] > 0.0
+        assert event["worst_ratio"] == max(event["worst_E_over_tau"],
+                                           event["gradient_ratio"])
+    assert all("predicted_ratio" in entry for entry in report["history"])
+    values = [entry["J"] for entry in report["history"]]
+    assert values[-1] < values[0]
+    assert fwi.model.min() >= 1.4 - 1e-12 and fwi.model.max() <= 3.0 + 1e-12
+    # Every iterate, and the starting model as iteration 0, is saved.
+    iterations = [0] + [entry["iteration"] for entry in report["history"]]
+    collection = ElementTree.parse(tmp_path / "models.pvd").getroot()
+    steps = [int(item.get("timestep")) for item in collection.iter("DataSet")]
+    assert steps == iterations
+    for step in iterations:
+        assert (tmp_path / f"models/model_iter{step:03d}.vti").exists()
+    np.testing.assert_array_equal(
+        np.load(tmp_path / f"model_iter{iterations[-1]:03d}.npy"), fwi.model)
+
+
+def test_audit_ratios() -> None:
+    """The ratios of an audit and the decision between time and space."""
+    audit = Audit("m.msh", 100, 1e-3, 1.0, errors=[2.0, 1.0],
+                  residuals=[10.0, 10.0], tolerances=[1.0, 2.0],
+                  relative_errors=[0.1, 0.1], noise=[0.1, 0.1],
+                  time_errors=[1.5, 0.1], space_errors=[0.5, 0.9],
+                  gradient_error=0.3, gradient_norm=1.0, xi=0.5, work=0.0)
+    assert audit.data_ratio == pytest.approx(2.0)
+    assert audit.gradient_ratio == pytest.approx(0.6)
+    assert audit.worst_ratio == pytest.approx(2.0)
+    # The worst shot (the first) has more time error than space error.
+    assert audit.time_dominated
+    audit.gradient_error = 3.0
+    # The gradient now fails worse: a new time step would not fix it.
+    assert audit.worst_ratio == pytest.approx(6.0)
+    assert not audit.time_dominated
+    audit.xi = None
+    assert audit.gradient_ratio == 0.0
+
+
+@pytest.mark.parametrize("element", ["Q1", "DG0"])
+def test_model_image_layout(tmp_path, element: str) -> None:
+    """The VTK image puts each value of the grid at its position."""
+    grid = ParameterGrid(DOMAIN, 0.1, element=element)
+    Z, X = grid_positions(grid)
+    file = write_vti(tmp_path / "model.vti", grid, 10.0 * X - Z)
+    image = ElementTree.parse(file).getroot().find("ImageData")
+    columns, rows = grid.shape[1], grid.shape[0]
+    x0, z0, _ = (float(v) for v in image.get("Origin").split())
+    dx, dz, _ = (float(v) for v in image.get("Spacing").split())
+    values = np.array(image.find(".//DataArray").text.split(), dtype=float)
+    assert values.size == rows * columns
+    # Position of each value, with X varying fastest.
+    shift = 0.0 if element == "Q1" else 0.5
+    x = x0 + dx * (np.arange(values.size) % columns + shift)
+    z = z0 + dz * (np.arange(values.size) // columns + shift)
+    np.testing.assert_allclose(values, 10.0 * x - z, rtol=1e-6, atol=1e-6)
+    pvd = write_pvd(tmp_path / "models.pvd", [(0, file), (3, file)])
+    collection = ElementTree.parse(pvd).getroot()
+    assert [item.get("file") for item in collection.iter("DataSet")] == \
+        ["model.vti", "model.vti"]
+
