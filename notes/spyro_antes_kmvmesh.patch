+    domain : RectangularDomain
+        Domain with the pad.
+    sources, receivers : list
+        Positions ``(z, x)`` in km.
+
+    Returns
+    -------
+    dict
+        KMV triangles, pressure-free top, non-reflecting bottom and sides.
+    """
+    dictionary = {
+        "options": {"cell_type": "T", "variant": "lumped",
+                    "degree": args.degree, "dimension": 2},
+        "parallelism": {"type": "spatial"},
+        "mesh": {"length_z": -domain.z_min, "length_x": domain.x_max,
+                 "length_y": 0.0, "mesh_type": "user_mesh"},
+        "acquisition": {"source_type": "ricker", "source_locations": sources,
+                        "frequency": args.frequency, "delay": 1.5,
+                        "delay_type": "multiples_of_minimum",
+                        "receiver_locations": receivers},
+        "absorving_boundary_conditions": {
+            "status": True, "abc_type": "nrbc", "free_surface": True,
+            "damping_layer": None},
+        "time_axis": {"initial_time": 0.0, "final_time": args.final_time,
+                      "dt": 1e-4, "amplitude": 1, "output_frequency": 10**9,
+                      "gradient_sampling_frequency": 1},
+        "visualization": {"forward_output": False, "forward_output_filename": None,
+                          "fwi_velocity_model_output": False,
+                          "velocity_model_filename": None, "gradient_output": False,
+                          "gradient_filename": None, "adjoint_output": False,
+                          "adjoint_filename": None, "debug_output": False},
+    }
+    if vars(args).get("nrbc_dt_scheme", "backward") == "central":
+        dictionary["absorving_boundary_conditions"]["nrbc"] = {"dt_scheme": "central"}
+    return dictionary
+
+
+def starting_model(true: VelocityGrid, domain: RectangularDomain, sigma: float,
+                   spacing: float = 0.01) -> VelocityGrid:
+    """Smooth the slowness of the model below the sea floor.
+
+    Parameters
+    ----------
+    true : VelocityGrid
+        Model that generates the data.
+    domain : RectangularDomain
+        Domain with the pad.
+    sigma : float
+        Standard deviation of the Gaussian (km).
+    spacing : float, optional
+        Spacing of the grid of the smoothing (km). Default ``0.01``.
+
+    Returns
+    -------
+    VelocityGrid
+        The water as in the model; below it, the Gaussian average of the
+        slowness of the sediments alone, so the water does not leak down.
+    """
+    z, x = domain.grid(spacing)
+    Z, X = np.meshgrid(z, x, indexing="ij")
+    velocity = true(Z, X)
+    sediment = (velocity > WATER_VELOCITY + 1e-6).astype(float)
+    width = sigma / spacing
+    weight = gaussian_filter(sediment, width, mode="nearest")
+    slowness = gaussian_filter(sediment / velocity, width, mode="nearest")
+    smooth = np.where(sediment > 0, weight / np.maximum(slowness, 1e-12),
+                      WATER_VELOCITY)
+    return VelocityGrid(smooth, z[0], x[0], spacing, spacing)
+
+
+def grid_nodes(grid: ParameterGrid) -> tuple[np.ndarray, np.ndarray]:
+    """Positions of the values of the parameter grid.
+
+    Parameters
+    ----------
+    grid : ParameterGrid
+        Parameter grid.
+
+    Returns
+    -------
+    tuple of numpy.ndarray
+        Depths and horizontal positions, of shape ``grid.shape``.
+    """
+    z = grid.origin[0] + grid.dz * np.arange(grid.shape[0])
+    x = grid.origin[1] + grid.dx * np.arange(grid.shape[1])
+    return np.meshgrid(z, x, indexing="ij")
+
+
+def time_shifts(observed: np.ndarray, synthetic: np.ndarray, dt: float
+                ) -> np.ndarray:
+    """Lag of the largest cross-correlation of each pair of traces.
+
+    Parameters
+    ----------
+    observed, synthetic : numpy.ndarray
+        Records ``(n_samples, n_receivers)`` on the same time axis.
+    dt : float
+        Sampling interval (s).
+
+    Returns
+    -------
+    numpy.ndarray
+        Time shift of each receiver (s).
+    """
+    steps = observed.shape[0]
+    size = 2 * steps
+    correlation = np.fft.irfft(
+        np.fft.rfft(observed, size, axis=0)
+        * np.conj(np.fft.rfft(synthetic, size, axis=0)), size, axis=0)
+    lag = np.argmax(correlation, axis=0)
+    return np.where(lag > steps, lag - size, lag) * dt
+
+
+def data_mesh(args: argparse.Namespace, domain: RectangularDomain,
+              true: VelocityGrid, path: Path, size: float | None) -> Path:
+    """Write the mesh of the data.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+    domain : RectangularDomain
+        Domain with the pad.
+    true : VelocityGrid
+        Model that generates the data.
+    path : pathlib.Path
+        Mesh file.
+    size : float or None
+        Uniform element size (km); ``None`` follows the velocity with
+        ``--observed-cpw`` cells per wavelength.
+
+    Returns
+    -------
+    pathlib.Path
+        The mesh file, written by the first process; every mesh conforms to
+        the sea floor.
+    """
+    if fire.COMM_WORLD.rank == 0:
+        field = (uniform_size(domain, size) if size is not None
+                 else true.scaled(1.0 / (args.observed_cpw * args.frequency)))
+        generate_mesh(path, domain, field, [SEA_FLOOR])
+    fire.COMM_WORLD.barrier()
+    return path
+
+
+def records_on(pilot: TwoLevelPilot, mesh_file: Path, target: np.ndarray
+               ) -> tuple[list[np.ndarray], float, int, float]:
+    """Propagate every shot on a mesh and resample the records.
+
+    Parameters
+    ----------
+    pilot : TwoLevelPilot
+        Builder of the waves, with the velocity to propagate.
+    mesh_file : pathlib.Path
+        Mesh.
+    target : numpy.ndarray
+        Times of the stored samples (s).
+
+    Returns
+    -------
+    tuple
+        The records ``(len(target), n_receivers)`` of each shot, the time
+        step (half the critical one), the degrees of freedom and the wall
+        time (s).
+    """
+    mesh = pilot.load_meshes(str(mesh_file))[0]
+    dt = 0.5 * pilot.critical_time_step(mesh)
+    dofs = pilot._wave(0, mesh).function_space.dim()
+    start = time.perf_counter()
+    records = []
+    for record in pilot.shot_records(mesh, dt).values():
+        # Sample n of a spyro record is at time (n + 1) dt.
+        times = (np.arange(len(record)) + 1) * dt
+        records.append(CubicSpline(times, record, axis=0)(
+            np.clip(target, times[0], times[-1])))
+    return records, dt, dofs, time.perf_counter() - start
+
+
+def prepare(args: argparse.Namespace) -> None:
+    """Propagate the observed data and check the starting model.
+
+    The shots run in parallel (``--spatial``). With ``--observed-size`` the
+    data are computed on a uniform reference mesh and resampled at
+    ``--record-dt``; ``--convergence-size`` adds the same computation on a
+    coarser uniform mesh, whose relative difference from the reference is
+    recorded. The check of the starting model runs on the coarser mesh when
+    there is one (it compares arrival times, which the mesh does not
+    change).
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+
+    Returns
+    -------
+    None
+        The data, their mesh and the check are written next to ``--data``.
+    """
+    domain, sources, receivers, offset = geometry(args.sources, args.receivers)
+    dictionary = model_dictionary(args, domain, sources, receivers)
+    true = true_velocity(args.model, offset)
+    initial = initial_velocity(args, true, domain, offset)
+    ensemble = shot_ensemble(args)
+    data = Path(args.data)
+    data.parent.mkdir(parents=True, exist_ok=True)
+    pilot = TwoLevelPilot(dictionary, true, discontinuous_velocity=True,
+                          ensemble=ensemble)
+    mesh = data_mesh(args, domain, true, data.with_suffix(".msh"), args.observed_size)
+    if args.observed_size is not None:
+        record_dt = args.record_dt
+    else:
+        # The time step of the mesh of the data, as before.
+        record_dt = 0.5 * pilot.critical_time_step(pilot.load_meshes(str(mesh))[0])
+    target = (np.arange(int(round(args.final_time / record_dt))) + 1) * record_dt
+    records, dt, dofs, elapsed = records_on(pilot, mesh, target)
+    check = {"model": args.model, "initial_model": args.initial_model,
+             "sigma_km": args.sigma, "half_period_s": 0.5 / args.frequency,
+             "sources": args.sources, "receivers": args.receivers,
+             "reference": {"mesh": mesh.name, "size_km": args.observed_size,
+                           "dofs": dofs, "dt": dt, "seconds": elapsed},
+             "shots": []}
+    check_mesh, check_records = mesh, records
+    if args.convergence_size is not None:
+        check_mesh = data_mesh(args, domain, true,
+                               data.with_name(data.stem + "_convergence.msh"),
+                               args.convergence_size)
+        check_records, coarse_dt, coarse_dofs, coarse_elapsed = records_on(
+            pilot, check_mesh, target)
+        differences = [float(np.linalg.norm(c - r) / np.linalg.norm(r))
+                       for c, r in zip(check_records, records)]
+        check["convergence"] = {
+            "mesh": check_mesh.name, "size_km": args.convergence_size,
+            "dofs": coarse_dofs, "dt": coarse_dt, "seconds": coarse_elapsed,
+            "relative_difference_per_shot": differences,
+            "largest_relative_difference": max(differences)}
+    pilot.velocity = initial
+    synthetic, _, _, _ = records_on(pilot, check_mesh, target)
+    delay = 1.5 * np.sqrt(6.0) / (np.pi * args.frequency)
+    receiver_x = np.array([r[1] for r in receivers])
+    for shot in range(args.sources):
+        observed, computed = check_records[shot], synthetic[shot]
+        scattered = observed - computed
+        # The direct wave is the same in both models and would hold the
+        # correlation at zero lag: compare the traces after the reflection
+        # of the sea floor, the window of the mesh adaptation tests.
+        path = np.sqrt((receiver_x - sources[shot][1]) ** 2
+                       + (2 * SEA_FLOOR - sources[shot][0] - receivers[0][0]) ** 2)
+        late = target[:, None] > delay + path[None, :] / WATER_VELOCITY
+        shifts = time_shifts(late * observed, late * computed, record_dt)
+        check["shots"].append({
+            "largest_shift_s": float(np.abs(shifts).max()),
+            "median_shift_s": float(np.median(np.abs(shifts))),
+            "fraction_above_half_period": float(
+                np.mean(np.abs(shifts) >= check["half_period_s"])),
+            "relative_residual": float(np.linalg.norm(scattered)
+                                       / np.linalg.norm(observed))})
+    largest = max(s["largest_shift_s"] for s in check["shots"])
+    check["largest_shift_s"] = largest
+    check["below_half_period"] = bool(largest < check["half_period_s"])
+    if fire.COMM_WORLD.rank != 0:
+        return
+    np.savez(data, records=np.array(records), dt=record_dt, sigma=args.sigma,
+             frequency=args.frequency, final_time=args.final_time,
+             degree=args.degree, sources=args.sources, receivers=args.receivers,
+             model=str(args.model), initial_model=str(args.initial_model),
+             mesh=str(mesh), fine_dt=dt)
+    data.with_suffix(".check.json").write_text(json.dumps(check, indent=1))
+    print(f"[prepare] {mesh.name}: {dofs} DOFs, dt = {dt:.3e} s, "
+          f"{args.sources} shots in {elapsed:.0f} s, stored every {record_dt} s",
+          flush=True)
+    if "convergence" in check:
+        print(f"[prepare] {check['convergence']['mesh']}: largest relative "
+              f"difference from the reference "
+              f"{100 * check['convergence']['largest_relative_difference']:.3f} %",
+              flush=True)
+    for shot, values in enumerate(check["shots"]):
+        print(f"[prepare] shot {shot}: largest shift "
+              f"{1e3 * values['largest_shift_s']:.1f} ms (median "
+              f"{1e3 * values['median_shift_s']:.1f} ms, "
+              f"{100 * values['fraction_above_half_period']:.0f} % of the "
+              f"receivers above half a period), residual "
+              f"{100 * values['relative_residual']:.1f} % of the data", flush=True)
+    print(f"[prepare] largest shift {1e3 * largest:.1f} ms; half period "
+          f"{1e3 * check['half_period_s']:.0f} ms: "
+          + ("starting model accepted" if check["below_half_period"]
+             else "STARTING MODEL MAY CYCLE-SKIP"), flush=True)
+
+
+def grid_models(args: argparse.Namespace, domain: RectangularDomain, offset: float,
+                comm: fire.MPI.Comm | None = None
+                ) -> tuple[ParameterGrid, np.ndarray, np.ndarray, np.ndarray]:
+    """Parameter grid with the true and starting models on it.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+    domain : RectangularDomain
+        Domain with the pad.
+    offset : float
+        Horizontal position of the window in the model file (km).
+    comm : mpi4py.MPI.Comm, optional
+        Communicator of the grid, the spatial one of the ensemble member.
+
+    Returns
+    -------
+    tuple
+        The grid, the true and starting models on it, and the mask of the
+        nodes in the water.
+    """
+    true = true_velocity(args.model, offset)
+    initial = initial_velocity(args, true, domain, offset)
+    # The water is known: above the sea floor the model is fixed, and the
+    # grid interpolates only the sediment below it (a sharp sea floor).
+    grid = ParameterGrid(domain, args.grid_spacing, "Q1", comm=comm,
+                         fixed_layer=(SEA_FLOOR, WATER_VELOCITY))
+    Z, X = grid_nodes(grid)
+    true_model, initial_model = true(Z, X), initial(Z, X)
+    water = grid.above_layer(Z)
+    initial_model[water] = WATER_VELOCITY
+    return grid, true_model, initial_model, water
+
+
+def invert_on_uniform_mesh(args: argparse.Namespace, dictionary: dict,
+                           domain: RectangularDomain, grid: ParameterGrid,
+                           initial_model: np.ndarray, observed: ObservedData,
+                           operator: TraceOperator, bounds: tuple,
+                           water: np.ndarray, noise_levels: list[float],
+                           ensemble: fire.Ensemble, output: Path
+                           ) -> tuple[dict, np.ndarray]:
+    """Run TAO on a uniform mesh of ``--uniform-size``, with no mesh design.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+    dictionary : dict
+        spyro dictionary.
+    domain : RectangularDomain
+        Domain with the pad.
+    grid : ParameterGrid
+        Parameter grid, on the spatial communicator of the ensemble.
+    initial_model : numpy.ndarray
+        Starting model on the grid.
+    observed : ObservedData
+        Observed records.
+    operator : TraceOperator
+        Data processing of the misfit.
+    bounds : tuple of numpy.ndarray
+        Lower and upper bounds on the grid.
+    water : numpy.ndarray
+        Mask of the grid values in the water.
+    noise_levels : list of float
+        Noise level of each shot: with ``--discrepancy`` the inversion stops
+        when :math:`\\sqrt{2J}` falls to that factor of their norm (no
+        modelling error is estimated on this mesh).
+    ensemble : firedrake.Ensemble
+        Ensemble of the shots.
+    output : pathlib.Path
+        Directory of the case.
+
+    Returns
+    -------
+    tuple
+        The report (``report_fwi.json``, with the same ``history`` and
+        ``events`` as the adaptive cases) and the final model.
+    """
+    lower, upper = bounds
+    mesh = data_mesh(args, domain, None, output / "meshes"
+                     / f"uniform_{1000 * args.uniform_size:.0f}m.msh",
+                     args.uniform_size)
+    local = FWIFunctional(dictionary, str(mesh), grid, initial_model, observed,
+                          operator, upper, dt_fraction=args.dt_fraction,
+                          gradient_mask=(~water).astype(float),
+                          discontinuous_velocity=True, ensemble=ensemble)
+    functional = EnsembleFWIFunctional(local, ensemble)
+    root = fire.COMM_WORLD.rank == 0
+    start = time.perf_counter()
+    report = {"case": f"inversion on a uniform mesh of {args.uniform_size} km",
+              "events": [], "history": []}
+    models = []
+
+    def save(iteration: int, model: np.ndarray) -> None:
+        """Write a model and the report, as the adaptive loop does.
+
+        Parameters
+        ----------
+        iteration : int
+            Iteration; 0 is the starting model.
+        model : numpy.ndarray
+            Model on the grid.
+
+        Returns
+        -------
+        None
+            The files are written by the first process.
+        """
+        if not root:
+            return
+        output.mkdir(parents=True, exist_ok=True)
+        np.save(output / f"model_iter{iteration:03d}.npy", model)
+        image = write_vti(output / "models" / f"model_iter{iteration:03d}.vti",
+                          grid, model)
+        models.append((iteration, image.relative_to(output)))
+        write_pvd(output / "models.pvd", models)
+        (output / "report_fwi.json").write_text(json.dumps(report, indent=1))
+
+    def record(iteration: int, value: float, controls: list,
+               gradient_norm: float) -> bool:
+        """Keep each accepted iterate; stop at the discrepancy level.
+
+        Parameters
+        ----------
+        iteration : int
+            Iteration over the TAO solves.
+        value : float
+            Functional at the iterate.
+        controls : list of firedrake.Function
+            The iterate.
+        gradient_norm : float
+            TAO's norm of the projected gradient at the iterate.
+
+        Returns
+        -------
+        bool
+            Whether the residual reached the discrepancy level.
+        """
+        elapsed = time.perf_counter() - start
+        report["history"].append({"iteration": iteration, "stage": 0,
+                                  "mesh": mesh.name, "dofs": functional.dofs,
+                                  "J": float(value),
+                                  "gradient_norm": float(gradient_norm)})
+        report["events"].append({"event": "iterate", "elapsed_s": round(elapsed, 1),
+                                 "iteration": iteration, "J": float(value)})
+        save(iteration, grid.to_array(controls[0]))
+        stop = (args.discrepancy is not None and np.sqrt(2.0 * value)
+                <= args.discrepancy * np.linalg.norm(noise_levels))
+        if stop:
+            report["events"].append({"event": "discrepancy",
+                                     "elapsed_s": round(elapsed, 1),
+                                     "iteration": iteration})
+        return stop
+
+    save(0, initial_model)
+    model, done = initial_model, 0
+    # TAO restarts at --restarts, as the mesh changes of an adaptive case do.
+    for stop in sorted(set(args.restarts) | {args.iterations}):
+        if stop <= done:
+            continue
+        report["events"].append({
+            "event": "tao_start", "elapsed_s": round(time.perf_counter() - start, 1),
+            "mesh": mesh.name, "dofs": functional.dofs, "dt": functional.dt,
+            "steps": functional.steps})
+        offset = done
+        local.controls[0].update(grid.function(model))
+        solution = minimize_with_tao(
+            functional, bounds=[(grid.function(lower), grid.function(upper))],
+            comm=grid.comm,
+            options={"tao_gatol": 1e-14, "tao_grtol": 0.0, "tao_gttol": 0.0,
+                     "tao_max_it": stop - done},
+            record=lambda it, value, controls, norm, offset=offset: record(
+                offset + it, value, controls, norm))
+        model = grid.to_array(solution[0])
+        done = len(report["history"])
+        if done < stop or report["events"][-1]["event"] == "discrepancy":
+            break
+    forwards, adjoints = functional.forwards, functional.adjoints
+    report["elapsed_s"] = time.perf_counter() - start
+    report["events"].append({
+        "event": "end", "elapsed_s": round(report["elapsed_s"], 1),
+        "forwards": forwards, "adjoints": adjoints,
+        "work": (forwards + adjoints) * functional.dofs * functional.steps})
+    if root:
+        np.save(output / "model_stage0.npy", model)
+        (output / "report_fwi.json").write_text(json.dumps(report, indent=1))
+    return report, model
+
+
+def run_case(args: argparse.Namespace) -> None:
+    """Run the inversion of one case.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+
+    Returns
+    -------
+    None
+        The results are written to ``--output``.
+    """
+    stored = np.load(args.data)
+    for name in ("sigma", "frequency", "final_time", "degree"):
+        if float(stored[name]) != float(getattr(args, name)):
+            raise ValueError(f"--{name.replace('_', '-')} differs from the one "
+                             f"of {args.data}: prepare the data again.")
+    for name in ("sources", "receivers"):
+        if name in stored.files and int(stored[name]) != getattr(args, name):
+            raise ValueError(f"--{name} differs from the one of {args.data}.")
+    records = [np.array(record) for record in stored["records"]]
+    record_dt = float(stored["dt"])
+    domain, sources, receivers, offset = geometry(args.sources, args.receivers)
+    dictionary = model_dictionary(args, domain, sources, receivers)
+    ensemble = shot_ensemble(args)
+    grid, true_model, initial_model, water = grid_models(args, domain, offset,
+                                                         ensemble.comm)
+    largest = args.upper_factor * float(true_model.max())
+    lower = np.full(grid.shape, WATER_VELOCITY)
+    upper = np.where(water, WATER_VELOCITY, largest)
+
+    # The audits and the noise level look at the reflections of the sediment,
+    # as the mesh tests did; with --misfit-window the misfit does too.
+    window = reflection_window(sources, receivers, args.frequency, args.window_delay)
+    audit = TraceOperator(window)
+    norms = [TraceOperator.norm(audit.apply(record, record_dt, shot), record_dt)
+             for shot, record in enumerate(records)]
+    noise_levels = [args.noise_fraction * norm for norm in norms]
+    if args.noise_seed is not None:
+        # The same seed on every process and in every case: paired replicas.
+        rng = np.random.default_rng(args.noise_seed)
+        for shot, record in enumerate(records):
+            noise = rng.standard_normal(record.shape)
+            in_window = TraceOperator.norm(audit.apply(noise, record_dt, shot), record_dt)
+            record += noise_levels[shot] / in_window * noise
+    observed = ObservedData(records, record_dt)
+    output = Path(args.output)
+    if args.strategy == "uniform":
+        report, final_model = invert_on_uniform_mesh(
+            args, dictionary, domain, grid, initial_model, observed,
+            TraceOperator(window if args.misfit_window else None),
+            (lower, upper), water, noise_levels, ensemble, output)
+        elapsed = report["elapsed_s"]
+    else:
+        policy = MeshPolicy(
+            noise_level=noise_levels, xi=None if args.xi < 0 else args.xi,
+            strategy=args.strategy, update_during_iterations=not args.fixed_mesh,
+            unified_rule=args.unified_mesh_rule,
+            audit_only_on_prediction=args.audit_only_on_prediction,
+            audit_every=args.audit_every, max_dofs=args.max_dofs,
+            dt_fraction=args.dt_fraction, discrepancy=args.discrepancy,
+            restarts=tuple(args.restarts))
+        fwi = MeshAdaptiveFWI(
+            dictionary, domain, grid, initial_model, observed,
+            [Stage(args.iterations)], policy, bounds=(lower, upper),
+            output_dir=output, conforming_depths=[SEA_FLOOR],
+            tao_options={"tao_gatol": 1e-14, "tao_grtol": 0.0, "tao_gttol": 0.0},
+            window=window if args.misfit_window else None,
+            audit_window=window, gradient_mask=(~water).astype(float),
+            discontinuous_velocity=True, ensemble=ensemble)
+        report = fwi.run()
+        final_model, elapsed = fwi.model, report["elapsed_s"]
+    write_summary(args, report, final_model, elapsed, ensemble.comm)
+
+
+def summarize(args: argparse.Namespace) -> None:
+    """Write ``summary.json`` of a case whose inversion has finished.
+
+    Reads ``report_fwi.json`` and the final model ``model_stage0.npy`` of
+    ``--output``; nothing is propagated.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings, the same as those of the run.
+
+    Returns
+    -------
+    None
+        ``summary.json`` and the true and starting models are written to
+        ``--output``.
+    """
+    output = Path(args.output)
+    report = json.loads((output / "report_fwi.json").read_text())
+    if report["events"][-1]["event"] != "end":
+        raise SystemExit(f"{output}: the inversion has not finished.")
+    write_summary(args, report, np.load(output / "model_stage0.npy"),
+                  report["events"][-1]["elapsed_s"])
+
+
+def bandlimited_floor(true_model: np.ndarray, region: np.ndarray, spacing: float,
+                      frequency: float) -> float:
+    """Approximate error floor of an inversion of the band.
+
+    The spectrum of the true model is cut at the wavenumber
+    :math:`2/\\lambda`, with :math:`\\lambda` the wavelength at the peak
+    frequency and the median velocity of the region; the error of the result
+    in the region is the floor. The grid is not periodic, so the floor is
+    indicative only.
+
+    Parameters
+    ----------
+    true_model : numpy.ndarray
+        True model on the grid.
+    region : numpy.ndarray
+        Mask of the region of the error.
+    spacing : float
+        Grid spacing (km).
+    frequency : float
+        Peak frequency (Hz).
+
+    Returns
+    -------
+    float
+        RMS of the true model minus its band-limited part, in the region.
+    """
+    wavelength = float(np.median(true_model[region])) / frequency
+    mean = float(true_model.mean())
+    spectrum = np.fft.fft2(true_model - mean)
+    kz = np.fft.fftfreq(true_model.shape[0], spacing)
+    kx = np.fft.fftfreq(true_model.shape[1], spacing)
+    keep = np.hypot(*np.meshgrid(kz, kx, indexing="ij")) <= 2.0 / wavelength
+    limited = mean + np.real(np.fft.ifft2(spectrum * keep))
+    return float(np.sqrt(np.mean((limited - true_model)[region] ** 2)))
+
+
+def write_summary(args: argparse.Namespace, report: dict, final_model: np.ndarray,
+                  elapsed: float, comm: fire.MPI.Comm | None = None) -> None:
+    """Write the summary of a case and the true and starting models.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings of the case.
+    report : dict
+        Report of the inversion (``report_fwi.json``).
+    final_model : numpy.ndarray
+        Final model on the grid.
+    elapsed : float
+        Wall time of the inversion (s).
+    comm : mpi4py.MPI.Comm, optional
+        Communicator of the grid.
+
+    Returns
+    -------
+    None
+        ``summary.json``, ``model_true.npy``, ``model_initial.npy`` and
+        ``model_region.npy`` (the region of the errors) are written to
+        ``--output`` by the first process.
+    """
+    domain, _, _, offset = geometry(args.sources, args.receivers)
+    grid, true_model, initial_model, water = grid_models(args, domain, offset, comm)
+    Z, X = grid_nodes(grid)
+    inverted = ~water & domain.in_interior(Z, X)
+    shallow = inverted & (Z >= -1.0)
+
+    def model_error(model: np.ndarray, region: np.ndarray = inverted) -> float:
+        """Root mean square error of a model in a region.
+
+        Parameters
+        ----------
+        model : numpy.ndarray
+            Model on the grid.
+        region : numpy.ndarray, optional
+            Mask of the region; the default is below the sea floor and
+            outside the pad.
+
+        Returns
+        -------
+        float
+            Error (km/s).
+        """
+        return float(np.sqrt(np.mean((model - true_model)[region] ** 2)))
+
+    events, history = report["events"], report["history"]
+    work = sum(e.get("work", 0) for e in events)
+    final_audits = [e for e in events if e["event"] == "final_audit"]
+    initial, final = model_error(initial_model), model_error(final_model)
+    floor = bandlimited_floor(true_model, inverted, args.grid_spacing, args.frequency)
+    summary = {
+        "strategy": args.strategy, "update_during_iterations": not args.fixed_mesh,
+        "data": str(args.data), "model": args.model,
+        "initial_model": args.initial_model,
+        "sources": args.sources, "receivers": args.receivers,
+        "data_mesh": args.reference_mesh or str(Path(args.data).with_suffix(".msh")),
+        "sea_floor": "fixed water layer, sharp interface",
+        "audit_window_delay_s": args.window_delay,
+        "misfit_window": args.misfit_window,
+        "iterations": len(history),
+        "meshes_used": list(dict.fromkeys(h["mesh"] for h in history)),
+        "final_dofs": history[-1]["dofs"],
+        "J_first": history[0]["J"], "J_last": history[-1]["J"],
+        "model_rms_error_initial": initial,
+        "model_rms_error_final": final,
+        "model_rms_error_shallow": model_error(final_model, shallow),
+        "model_rms_error_deep": model_error(final_model, inverted & ~shallow),
+        "bandlimited_floor": floor,
+        "recoverable_gap_closed": (initial - final) / (initial - floor),
+        "final_audit_E_over_tau": (final_audits[-1]["worst_E_over_tau"]
+                                   if final_audits else None),
+        "final_audit_worst_ratio": (final_audits[-1]["worst_ratio"]
+                                    if final_audits else None),
+        "tao_restarts": sum(e["event"] == "tao_start" for e in events),
+        "noise_seed": args.noise_seed, "noise_fraction": args.noise_fraction,
+        "work_dof_steps": work, "elapsed_s": elapsed}
+    if fire.COMM_WORLD.rank == 0:
+        output = Path(args.output)
+        np.save(output / "model_true.npy", true_model)
+        np.save(output / "model_initial.npy", initial_model)
+        np.save(output / "model_region.npy", inverted)
+        (output / "summary.json").write_text(json.dumps(summary, indent=1))
+        print("[summary] " + json.dumps(summary), flush=True)
+
+
+def main() -> None:
+    """Prepare the data or run one case.
+
+    Returns
+    -------
+    None
+        See :func:`prepare`, :func:`run_case` and :func:`summarize`.
+    """
+    args = parse_arguments()
+    if args.prepare:
+        prepare(args)
+    elif args.output is None:
+        raise SystemExit("--output is required to run a case.")
+    elif args.summarize:
+        summarize(args)
+    else:
+        run_case(args)
+
+
+if __name__ == "__main__":
+    main()
