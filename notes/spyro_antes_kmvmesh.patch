+        PETSc options of TAO, besides the iteration limit set per stage.
+    store_forward : bool, optional
+        See :class:`~spyro.adaptivity.fwi_functional.FWIFunctional`. Default
+        ``True``.
+    audit_window : callable, optional
+        Window of the traces in the audits of the meshes (pilot errors,
+        residuals, tolerances and the adjoint indicator), when it differs
+        from the window of the misfit: for example only the reflections
+        after the sea floor, while the misfit keeps the full traces.
+        ``None`` (the default) uses ``window``.
+    gradient_mask : numpy.ndarray, optional
+        See :class:`~spyro.adaptivity.fwi_functional.FWIFunctional`.
+    discontinuous_velocity : bool, optional
+        Sample the velocity element by element in the inversion and in the
+        audits (see :class:`~spyro.adaptivity.pilot.TwoLevelPilot`), so that
+        the interfaces of ``conforming_depths`` are exact jumps. Default
+        ``False``.
+    ensemble : firedrake.Ensemble, optional
+        Shot parallelism: the members share the shots of the pilots, of the
+        audits and of the misfit, whose total is an
+        :class:`~spyro.adaptivity.fwi_functional.EnsembleFWIFunctional`.
+        ``grid`` must live on ``ensemble.comm``. Every member runs the loop
+        and the optimiser on the same totals; the meshes and the files are
+        written by the first process of the first member. ``None`` (the
+        default) propagates every shot on the processes of ``grid``.
+
+    Attributes
+    ----------
+    model : numpy.ndarray
+        Current model on the grid.
+    mesh : pathlib.Path or None
+        Current wave mesh.
+    report : dict
+        Events, history and costs, also written to ``report_fwi.json``.
+    """
+
+    def __init__(self, dictionary: dict, domain: RectangularDomain,
+                 grid: ParameterGrid, initial_model: np.ndarray,
+                 observed: ObservedData, stages: Sequence[Stage],
+                 policy: MeshPolicy, bounds: tuple,
+                 output_dir: str | Path, window: Window | None = None,
+                 conforming_depths: Sequence[float] = (),
+                 tao_options: dict | None = None,
+                 store_forward: bool = True,
+                 audit_window: Window | None = None,
+                 gradient_mask: np.ndarray | None = None,
+                 discontinuous_velocity: bool = False,
+                 ensemble: fire.Ensemble | None = None) -> None:
+        if policy.strategy not in ("adjoint", "gradient", "cpw"):
+            raise ValueError("strategy must be 'adjoint', 'gradient' or 'cpw'.")
+        # The loop builds many solvers in one process (see the workaround).
+        speed_up_unique_names()
+        self.dictionary = dictionary
+        self.domain = domain
+        self.grid = grid
+        self.model = np.array(initial_model, dtype=float).reshape(grid.shape)
+        self.observed = observed
+        self.stages = list(stages)
+        self.policy = policy
+        self.lower, self.upper = bounds
+        self.output_dir = Path(output_dir)
+        self.window = window
+        self.audit_window = window if audit_window is None else audit_window
+        self.gradient_mask = gradient_mask
+        self.discontinuous_velocity = discontinuous_velocity
+        self.conforming_depths = tuple(conforming_depths)
+        self.tao_options = dict(tao_options or {})
+        self.store_forward = store_forward
+        self.comm = grid.comm
+        self.ensemble = ensemble
+        if ensemble is not None and ensemble.comm.size != grid.comm.size:
+            raise ValueError("The grid must live on the ensemble's spatial "
+                             "communicator, ensemble.comm.")
+        #: The process that builds the meshes and writes the files.
+        self._root = self.comm.rank == 0 and (
+            ensemble is None or ensemble.ensemble_comm.rank == 0)
+        self.degree = int(dictionary["options"]["degree"])
+        self.peak_frequency = float(dictionary["acquisition"]["frequency"])
+        shots = len(dictionary["acquisition"]["source_locations"])
+        noise = np.broadcast_to(np.asarray(policy.noise_level, dtype=float), (shots,))
+        if np.any(noise <= 0.0):
+            raise ValueError("The noise level must be positive: without noise, "
+                             "declare an absolute floor.")
+        self.noise = noise
+        self.pilot = TwoLevelPilot(dictionary, grid.sampler(self.model),
+                                   window=self.audit_window,
+                                   discontinuous_velocity=discontinuous_velocity,
+                                   dt_fraction=policy.pilot_dt_fraction,
+                                   keep_records=True, ensemble=ensemble)
+        self.z, self.x = domain.grid(policy.grid_spacing)
+        self._Z, self._X = np.meshgrid(self.z, self.x, indexing="ij")
+        self.interior = domain.in_interior(self._Z, self._X)
+        self.mesh = None
+        self.dofs = 0
+        #: Degrees of freedom of a uniform mesh per (C f)^2 int v^-2.
+        self._cpw_calibration = None
+        #: Density, reference size and calibration of the stage's design.
+        self._design = None
+        #: Fraction of the critical time step of the inversion, halved by
+        #: the failures dominated by the time error.
+        self.dt_fraction = policy.dt_fraction
+        #: Functionals of the audits, built once per mesh and time step:
+        #: ``(mesh, dt_fraction, level) -> FWIFunctional``.
+        self._functionals = {}
+        #: Last audit: the reference of the predicted ratio.
+        self._last_audit = None
+        #: Lumped mass of the grid, the metric of BQNLS.
+        self._grid_mass = grid.to_array(
+            fire.assemble(fire.TestFunction(grid.space) * fire.dx))
+        self._meshes = 0
+        #: Wall-clock origin of the times of the events.
+        self._start = time.perf_counter()
+        #: Iteration and VTK file of each model in ``models.pvd``.
+        self._saved_models = []
+        self.report = {"policy": asdict(policy), "degree": self.degree,
+                       "peak_frequency_hz": self.peak_frequency,
+                       "grid": {"element": grid.element, "shape": grid.shape},
+                       "events": [], "history": []}
+
+    # ------------------------------------------------------------ helpers
+    def _on_root(self, build: Callable[[], T]) -> T:
+        """Run ``build`` on the root process and broadcast its result.
+
+        Parameters
+        ----------
+        build : callable
+            Function without arguments.
+
+        Returns
+        -------
+        T
+            The broadcast result.
+        """
+        comm = self.comm if self.ensemble is None else self.ensemble.global_comm
+        value = build() if self._root else None
+        return comm.bcast(value, root=0)
+
+    def _log(self, kind: str, **data: object) -> None:
+        """Append an event to the report and write it.
+
+        Parameters
+        ----------
+        kind : str
+            Kind of the event.
+        **data
+            Content of the event.
+
+        Returns
+        -------
+        None
+            ``report_fwi.json`` is rewritten on the root process.
+        """
+        data = {"elapsed_s": round(time.perf_counter() - self._start, 1), **data}
+        self.report["events"].append({"event": kind, **data})
+        if self._root:
+            self.output_dir.mkdir(parents=True, exist_ok=True)
+            (self.output_dir / "report_fwi.json").write_text(
+                json.dumps(self.report, indent=1, default=_json_value))
+            fire.PETSc.Sys.Print(f"[mesh-fwi] {kind}: " + ", ".join(
+                f"{k}={v:.4g}" if isinstance(v, float) else f"{k}={v}"
+                for k, v in data.items() if not isinstance(v, (dict, list))))
+
+    def _save_model(self, iteration: int) -> None:
+        """Save the current model as the one of an iteration.
+
+        The model is written as ``model_iter<k>.npy`` and as
+        ``models/model_iter<k>.vti``, and ``models.pvd`` is rewritten to list
+        every model saved so far with the iteration as the time, so an
+        interrupted run keeps its models and ParaView can follow the run.
+
+        Parameters
+        ----------
+        iteration : int
+            Iteration counted over all the stages; 0 is the starting model.
+
+        Returns
+        -------
+        None
+            The files are written on the root process.
+        """
+        if not self._root:
+            return
+        self.output_dir.mkdir(parents=True, exist_ok=True)
+        np.save(self.output_dir / f"model_iter{iteration:03d}.npy", self.model)
+        image = write_vti(self.output_dir / "models" / f"model_iter{iteration:03d}.vti",
+                          self.grid, self.model)
+        self._saved_models.append((iteration, image.relative_to(self.output_dir)))
+        write_pvd(self.output_dir / "models.pvd", self._saved_models)
+
+    def _velocity(self) -> np.ndarray:
+        """Current model on the design grid of the meshes.
+
+        Returns
+        -------
+        numpy.ndarray
+            Velocity of shape ``(len(z), len(x))``.
+        """
+        return self.grid.sampler(self.model)(self._Z, self._X)
+
+    def _smoothing(self, frequency: float) -> float:
+        """Smoothing length of the densities.
+
+        Parameters
+        ----------
+        frequency : float
+            Frequency of the stage (Hz).
+
+        Returns
+        -------
+        float
+            Length (km).
+        """
+        if self.policy.smoothing is not None:
+            return self.policy.smoothing
+        return 0.06 * 7.0 / frequency
+
+    def _mesh_size(self, mesh: Path) -> tuple[np.ndarray, int]:
+        """Local size of a mesh on the design grid and its degrees of freedom.
+
+        Parameters
+        ----------
+        mesh : pathlib.Path
+            Mesh file.
+
+        Returns
+        -------
+        tuple
+            Size ``(len(z), len(x))`` and the dimension of its KMV space.
+        """
+        def measure() -> tuple[np.ndarray, int]:
+            """Read the mesh on rank 0.
+
+            Returns
+            -------
+            tuple
+                Size on the grid and degrees of freedom.
+            """
+            points, triangles = read_triangulation(mesh)
+            return (local_mesh_size(points, triangles, self.z, self.x),
+                    count_kmv_dofs(triangles, self.degree))
+
+        return self._on_root(measure)
+
+    def _equivalent_cpw(self, dofs: int, frequency: float) -> float:
+        """Cells per wavelength of a uniform mesh with a budget.
+
+        Parameters
+        ----------
+        dofs : int
+            Budget.
+        frequency : float
+            Frequency of the stage (Hz).
+
+        Returns
+        -------
+        float
+            :math:`C` of the uniform mesh with that budget at the current
+            model, from the calibration of the first uniform mesh.
+        """
+        integral = float((self._velocity() ** -2).sum())
+        return math.sqrt(dofs / (self._cpw_calibration * integral)) / frequency
+
+    # ------------------------------------------------------------- meshes
+    def _new_name(self, tag: str) -> Path:
+        """Path of the next mesh.
+
+        Parameters
+        ----------
+        tag : str
+            What the mesh is.
+
+        Returns
+        -------
+        pathlib.Path
+            A new file in the ``meshes`` directory.
+        """
+        self._meshes += 1
+        return self.output_dir / "meshes" / f"m{self._meshes:02d}_{tag}.msh"
+
+    def _cpw_mesh(self, cpw: float, frequency: float,
+                  cap: np.ndarray | None = None) -> tuple[Path, int]:
+        """Build a uniform mesh for the current model.
+
+        Parameters
+        ----------
+        cpw : float
+            Cells per wavelength.
+        frequency : float
+            Frequency of the stage (Hz).
+        cap : numpy.ndarray or None, optional
+            Local upper size bound for a unified recovery mesh.
+
+        Returns
+        -------
+        tuple
+            Mesh path and its degrees of freedom.
+        """
+        path = self._new_name(f"cpw{cpw:.3g}".replace(".", "p"))
+        velocity = self._velocity()
+        spacing = self.policy.grid_spacing
+
+        def build() -> int:
+            """Generate the mesh and count its degrees of freedom.
+
+            Returns
+            -------
+            int
+                Degrees of freedom.
+            """
+            size = VelocityGrid(velocity / (cpw * frequency),
+                                self.z[0], self.x[0], spacing, spacing)
+            if cap is not None:
+                size = VelocityGrid(np.minimum(velocity / (cpw * frequency), cap),
+                                    self.z[0], self.x[0], spacing, spacing)
+            generate_mesh(path, self.domain, size, self.conforming_depths)
+            return count_kmv_dofs(read_triangulation(path)[1], self.degree)
+
+        dofs = self._on_root(build)
+        if self._cpw_calibration is None:
+            self._cpw_calibration = dofs / (
+                (cpw * frequency) ** 2 * float((velocity ** -2).sum()))
+        return path, dofs
+
+    def _designed_mesh(self, tag: str, target: int, frequency: float,
+                       cap: np.ndarray | None) -> tuple[Path, int]:
+        """Build a mesh from the density of the stage with a budget.
+
+        Parameters
+        ----------
+        tag : str
+            Name of the mesh.
+        target : int
+            Target number of degrees of freedom.
+        frequency : float
+            Frequency of the stage (Hz).
+        cap : numpy.ndarray or None
+            Local size of a mesh the new one may not be coarser than (a
+            refinement inside a stage). ``None`` only keeps ``cpw_floor``
+            cells per wavelength (a redesign).
+
+        Returns
+        -------
+        tuple
+            Mesh path and its degrees of freedom.
+        """
+        p = self.policy
+        path = self._new_name(tag)
+        velocity = self._velocity()
+        ceiling = velocity / (p.cpw_floor * frequency)
+        if cap is not None:
+            ceiling = np.minimum(ceiling, cap)
+        design = self._design
+        if p.unified_rule:
+            current_size, current_dofs = self._mesh_size(self.mesh)
+            ceiling = np.minimum(ceiling, current_size)
+            design = {**design, "size": current_size,
+                      "calibration": current_dofs / float(
+                          (current_size ** -2).sum() * p.grid_spacing ** 2)}
+        equivalent = self._equivalent_cpw(target, frequency)
+
+        def build_uniform() -> int:
+            """Generate the uniform mesh, rescaling until it meets the budget.
+
+            Returns
+            -------
+            int
+                Degrees of freedom obtained.
+            """
+            cpw = max(equivalent, p.cpw_floor)
+            dofs = 0
+            for _ in range(6):
+                size = np.minimum(velocity / (cpw * frequency), ceiling)
+                generate_mesh(path, self.domain, VelocityGrid(
+                    size, self.z[0], self.x[0], p.grid_spacing, p.grid_spacing),
+                    self.conforming_depths)
+                dofs = count_kmv_dofs(read_triangulation(path)[1], self.degree)
+                if abs(dofs / target - 1.0) <= p.dof_tolerance:
+                    break
+                cpw *= math.sqrt(target / dofs)
+            return dofs
+
+        if p.strategy == "cpw":
+            return path, self._on_root(build_uniform)
+
+        def build() -> int:
+            """Generate the mesh, rescaling until it meets the budget.
+
+            Returns
+            -------
+            int
+                Degrees of freedom obtained.
+            """
+            size = AdaptiveSizeField(design["density"], design["size"],
+                                     self.z, self.x, p.order, ceiling=ceiling)
+            size.set_floor(velocity, frequency, equivalent, p.cmax_ratio)
+            scale = size.scale_for(target / design["calibration"])
+            dofs = 0
+            for _ in range(6):
+                size.set_scale(scale)
+                generate_mesh(path, self.domain, size.grid, self.conforming_depths)
+                dofs = count_kmv_dofs(read_triangulation(path)[1], self.degree)
+                if abs(dofs / target - 1.0) <= p.dof_tolerance:
+                    break
+                scale *= math.sqrt(dofs / target)
+            return dofs
+
+        return path, self._on_root(build)
+
+    # ------------------------------------------------------------- audits
+    def _audit_operator(self, operator: TraceOperator) -> TraceOperator:
+        """Data processing of the audits for the one of a stage.
+
+        Parameters
+        ----------
+        operator : TraceOperator
+            Data processing of the misfit of the stage.
+
+        Returns
+        -------
+        TraceOperator
+            The same filter with the window of the audits.
+        """
+        if self.audit_window is self.window:
+            return operator
+        return TraceOperator(self.audit_window, operator.cutoff, operator.order,
+                             operator.pad_periods)
+
+    def _functional(self, mesh: Path, operator: TraceOperator,
+                    level: str) -> FWIFunctional:
+        """Functional of this member's shots on a mesh, built once.
+
+        Parameters
+        ----------
+        mesh : pathlib.Path
+            Wave mesh.
+        operator : TraceOperator
+            Data processing of the misfit of the stage.
+        level : {"coarse", "half", "fine"}
+            The mesh at the time step of the inversion; the mesh at half that
+            step; its uniform refinement at half that step.
+
+        Returns
+        -------
+        FWIFunctional
+            The functional. Those of other meshes, time steps or stages are
+            dropped, so only the current operator's three are kept.
+        """
+        key = (str(mesh), self.dt_fraction, operator.cutoff)
+        if any(cached[:3] != key for cached in self._functionals):
+            self._functionals.clear()
+            gc.collect()
+        if (*key, level) not in self._functionals:
+            dt = None
+            if level != "coarse":
+                dt = 0.5 * self._functional(mesh, operator, "coarse").dt
+            # Only the functional of the inversion keeps its forward states
+            # from the evaluation to the derivative; the refined one, whose
+            # states are four times larger and twice as many, propagates
+            # again in its derivative, when the gradient criterion needs it,
+            # and the one at half the time step never needs them.
+            self._functionals[(*key, level)] = FWIFunctional(
+                self.dictionary, str(mesh), self.grid, self.model,
+                self.observed, operator, self.upper, self.dt_fraction,
+                self.store_forward and level == "coarse", self.gradient_mask,
+                self.discontinuous_velocity, self.ensemble,
+                refinements=int(level == "fine"), dt=dt)
+        return self._functionals[(*key, level)]
+
+    def _sum_members(self, value: T) -> T:
+        """Sum a value of this member's shots over the ensemble.
+
+        Parameters
+        ----------
+        value : float or numpy.ndarray
+            Value of the local shots, the same on the member's processes.
+
+        Returns
+        -------
+        float or numpy.ndarray
+            The total over every shot.
+        """
+        if self.ensemble is None:
+            return value
+        return self.ensemble.ensemble_comm.allreduce(value)
+
+    def _free(self, gradient: np.ndarray) -> np.ndarray:
+        """Mask of the grid values not held by an active bound.
+
+        Parameters
+        ----------
+        gradient : numpy.ndarray
+            Derivative on the grid at the current model.
+
+        Returns
+        -------
+        numpy.ndarray
+            ``True`` where a step along :math:`-g` stays inside the bounds.
+        """
+        lower = np.broadcast_to(np.asarray(self.lower, dtype=float), self.grid.shape)
+        upper = np.broadcast_to(np.asarray(self.upper, dtype=float), self.grid.shape)
+        margin = 1e-10 * np.maximum(np.abs(upper), 1.0)
+        at_lower = (self.model <= lower + margin) & (gradient > 0.0)
+        at_upper = (self.model >= upper - margin) & (gradient < 0.0)
+        return ~(at_lower | at_upper)
+
+    @staticmethod
+    def _pilot_relative_errors(result: PilotResult,
+                               operator: TraceOperator) -> list[float]:
+        """Relative trace errors of a pilot in the norm of the misfit.
+
+        Parameters
+        ----------
+        result : PilotResult
+            Pilot run with ``keep_records``; its records are released.
+        operator : TraceOperator
+            Data processing of the audits.
+
+        Returns
+        -------
+        list of float
+            :math:`\\|B_s(d_H - d_h)\\| / \\|B_s d_h\\|` of each shot, both
+            levels at the pilot's common time step.
+        """
+        relative = []
+        for shot in sorted(result.records):
+            coarse, fine = result.records[shot]
+            coarse = operator.apply(coarse, result.dt, shot)
+            fine = operator.apply(fine, result.dt, shot)
+            relative.append(operator.norm(coarse - fine, result.dt)
+                            / operator.norm(fine, result.dt))
+        result.records.clear()
+        return relative
+
+    def _audit(self, mesh: Path, operator: TraceOperator, pilot: bool = False,
+               indicator: bool = False) -> Audit:
+        """Audit a mesh at the current model.
+
+        The functional of the mesh at the time step of the inversion is
+        compared with the one of its uniform refinement at half that step
+        (and, with ``time_split``, with the mesh itself at half the step).
+        Both use the transfer of the model and the processing of the misfit,
+        so the error is the one of the operator the inversion minimizes.
+
+        Parameters
+        ----------
+        mesh : pathlib.Path
+            Mesh to audit.
+        operator : TraceOperator
+            Data processing of the stage.
+        pilot : bool, optional
+            Also run the two-level pilot, whose relative errors decide the
+            reliability of a design. Default ``False``.
+        indicator : bool, optional
+            Also compute the adjoint indicator in the pilot. Default
+            ``False``.
+
+        Returns
+        -------
+        Audit
+            Errors, residuals, tolerances and the gradient error. It also
+            becomes :attr:`_last_audit`, the reference of the predictions.
+        """
+        p = self.policy
+        audit_operator = self._audit_operator(operator)
+        result = relative_pilot = None
+        if pilot or indicator:
+            self.pilot.velocity = self.grid.sampler(self.model)
+            result = self.pilot.run(str(mesh), compute_indicator=indicator)
+            relative_pilot = self._pilot_relative_errors(result, audit_operator)
+        levels = ("coarse", "fine", "half") if p.time_split else ("coarse", "fine")
+        functionals = {level: self._functional(mesh, operator, level)
+                       for level in levels}
+        before = {level: f.forwards + f.adjoints for level, f in functionals.items()}
+        control = self.grid.function(self.model)
+        value = self._sum_members(functionals["coarse"](control))
+        for level in levels[1:]:
+            functionals[level](control)
+        gradient_error = gradient_norm = None
+        if p.xi is not None:
+            coarse_gradient = self._sum_members(functionals["coarse"].derivative_array())
+            fine_gradient = self._sum_members(functionals["fine"].derivative_array())
+            free = self._free(coarse_gradient)
+            gradient_norm = math.sqrt(float(
+                (free * coarse_gradient ** 2 / self._grid_mass).sum()))
+            gradient_error = math.sqrt(float(
+                (free * (coarse_gradient - fine_gradient) ** 2 / self._grid_mass).sum()))
+        coarse = functionals["coarse"]
+        dt = coarse.dt
+        local = {}
+        for index, shot in enumerate(coarse.shots):
+            d_coarse = audit_operator.apply(coarse.records[index], dt, shot)
+            # Sample 2k + 1 at dt/2 is at the time (k + 1) dt of sample k.
+            d_fine = audit_operator.apply(
+                functionals["fine"].records[index], 0.5 * dt, shot)[1::2]
+            steps = min(len(d_coarse), len(d_fine))
+            observed = audit_operator.apply(
+                self.observed.at(shot, coarse.steps, dt), dt, shot)
+            entry = {
+                "E": audit_operator.norm(d_coarse[:steps] - d_fine[:steps], dt),
+                "R": audit_operator.norm(d_coarse - observed, dt),
+                "norm_observed": audit_operator.norm(observed, dt),
+                "norm_fine": audit_operator.norm(d_fine[:steps], dt)}
+            if p.time_split:
+                d_half = audit_operator.apply(
+                    functionals["half"].records[index], 0.5 * dt, shot)[1::2]
+                steps = min(steps, len(d_half))
+                entry["E_time"] = audit_operator.norm(
+                    d_coarse[:steps] - d_half[:steps], dt)
+                entry["E_space"] = audit_operator.norm(
+                    d_half[:steps] - d_fine[:steps], dt)
+            local[shot] = entry
+        shots = self.pilot.gather_shots(local)
+        errors = [shots[s]["E"] for s in sorted(shots)]
+        residuals = [shots[s]["R"] for s in sorted(shots)]
+        tolerances = []
+        for s in sorted(shots):
+            tolerance = p.kappa * max(shots[s]["R"], self.noise[s])
+            if p.epsilon_max is not None:
+                tolerance = min(tolerance, p.epsilon_max * shots[s]["norm_observed"])
+            tolerances.append(tolerance)
+        work = self._sum_members(sum(
+            (f.forwards + f.adjoints - before[level]) * f.dofs * f.steps
+            for level, f in functionals.items()))
+        if result is not None:
+            runs = len(result.trace_errors) + len(result.repeated_shots)
+            work += ((result.dofs_coarse + result.dofs_fine) * result.steps * runs
+                     + result.dofs_fine * result.steps * len(result.adjoint_shots))
+        audit = Audit(
+            str(mesh), coarse.dofs, dt, value, errors, residuals, tolerances,
+            [shots[s]["E"] / shots[s]["norm_fine"] for s in sorted(shots)],
+            [float(self.noise[s]) for s in sorted(shots)],
+            [shots[s]["E_time"] for s in sorted(shots)] if p.time_split else None,
+            [shots[s]["E_space"] for s in sorted(shots)] if p.time_split else None,
+            gradient_error, gradient_norm, p.xi, float(work), result,
+            relative_pilot)
+        self._last_audit = audit
+        return audit
+
+    def _halve_time_step(self) -> bool:
+        """Halve the time step of the inversion, within ``dt_fraction_min``.
+
+        Returns
+        -------
+        bool
+            Whether the time step was halved.
+        """
+        if 0.5 * self.dt_fraction < self.policy.dt_fraction_min:
+            return False
+        self.dt_fraction *= 0.5
+        self._log("time_step", dt_fraction=self.dt_fraction,
+                  note="the failure was dominated by the time error")
+        return True
+
+    def _fix_time_error(self, audit: Audit, operator: TraceOperator,
+                        tag: str) -> Audit:
+        """Halve the time step while a failure is dominated by the time error.
+
+        Parameters
+        ----------
+        audit : Audit
+            Audit of the current mesh.
+        operator : TraceOperator
+            Data processing of the stage.
+        tag : str
+            Name of the event of each new audit.
+
+        Returns
+        -------
+        Audit
+            The last audit of the current mesh.
+        """
+        p = self.policy
+        while (audit.worst_ratio > p.theta and audit.time_dominated
+               and self._halve_time_step()):
+            audit = self._audit(self.mesh, operator)
+            self._log(tag, accepted=audit.worst_ratio <= p.theta, **audit.summary())
+        return audit
+
+    def _growth(self, audit: Audit, smallest: float,
+                history: Sequence[tuple[int, float]] = ()) -> float:
+        """Growth of the budget predicted to meet the acceptance.
+
+        Parameters
+        ----------
+        audit : Audit
+            Audit of the mesh the budget grows from.
+        smallest : float
+            Smallest growth allowed.
+        history : sequence of tuple, optional
+            DOFs and error ratios of successive meshes at the current model.
+            Only the unified rule uses their measured convergence rate.
+
+        Returns
+        -------
+        float
+            :math:`(\\rho/\\theta)^{2/p}`, clipped.
+        """
+        p = self.policy
+        rate = self._measured_rate(history) if p.unified_rule else p.rate
+        predicted = (audit.worst_ratio / p.theta) ** (2.0 / rate)
+        return min(max(predicted, smallest), p.growth_max)
+
+    def _measured_rate(self, history: Sequence[tuple[int, float]]) -> float:
+        """Measure the spatial rate by the article's two-mesh rule.
+
+        Parameters
+        ----------
+        history : sequence of tuple
+            DOFs and positive error ratios at successive meshes.
+
+        Returns
+        -------
+        float
+            Measured rate in [0.5, 6], or the policy fallback rate.
+        """
+        if len(history) >= 2:
+            (n0, rho0), (n1, rho1) = history[-2:]
+            if n1 > n0 and 0 < rho1 < rho0:
+                rate = 2 * math.log(rho0 / rho1) / math.log(n1 / n0)
+                if .5 <= rate <= 6:
+                    return rate
+        return self.policy.rate
+
+    def _refresh_unified_design(self, audit: Audit, operator: TraceOperator,
+                                frequency: float) -> None:
+        """Rebuild the density and size reference on the mesh being refined.
+
+        Parameters
+        ----------
+        audit : Audit
+            Failed audit on the current mesh and model.
+        operator : TraceOperator
+            Original data processing.
+        frequency : float
+            Stage frequency in Hz.
+
+        Returns
+        -------
+        None
+            Updates the design and records its provenance and pilot cost.
+        """
+        p = self.policy
+        size, dofs = self._mesh_size(self.mesh)
+        density = None
+        work = 0
+        active = []
+        if p.strategy == "adjoint":
+            active = [s for s, (error, tau) in enumerate(zip(audit.errors, audit.tolerances))
+                      if error > p.theta * tau]
+            if not active and audit.gradient_ratio > p.theta:
+                active = list(range(len(audit.errors)))
+            self.pilot.velocity = self.grid.sampler(self.model)
+            # Audits without xi retain no forward states. A new pilot is
+            # needed for the coarse trajectory used by the DWR residual.
+            result = self.pilot.run(str(self.mesh), compute_indicator=True,
+                                    indicator_shots=active)
+            relative = self._pilot_relative_errors(result, self._audit_operator(operator))
+            density = self._on_root(lambda: adjoint_density(
+                result.centroids, result.indicators, np.array(relative) ** 2,
+                self.z, self.x, self._smoothing(frequency)))
+            work = ((result.dofs_coarse + result.dofs_fine) * result.steps
+                    * (len(result.trace_errors) + len(result.repeated_shots))
+                    + result.dofs_fine * result.steps * len(result.adjoint_shots))
+        elif p.strategy == "gradient":
+            density = gradient_density(self._velocity(), p.grid_spacing,
+                                       self._smoothing(frequency), self.interior)
+        self._design = {"density": density, "size": size,
+                        "calibration": dofs / float((size ** -2).sum() * p.grid_spacing ** 2)}
+        self._log("design_refresh", mesh=self.mesh.name, dofs=dofs,
+                  density_sha256=None if density is None else
+                  hashlib.sha256(np.ascontiguousarray(density).tobytes()).hexdigest(),
+                  indicator_shots=active, work=float(work))
+
+    def _verified_mesh(self, audit: Audit, operator: TraceOperator,
+                       frequency: float, tag: str, first_growth: float,
+                       cap: np.ndarray | None) -> bool:
+        """Design meshes from the stage's density until one is accepted.
+
+        Parameters
+        ----------
+        audit : Audit
+            Audit of the current mesh.
+        operator : TraceOperator
+            Data processing of the stage.
+        frequency : float
+            Frequency of the stage (Hz).
+        tag : str
+            Name of the meshes.
+        first_growth : float
+            Smallest growth of the budget of the first mesh.
+        cap : numpy.ndarray or None
+            See :meth:`_designed_mesh`.
+
+        Returns
+        -------
+        bool
+            Whether the last mesh, now the current one, met
+            :math:`\\rho \\le \\theta`. ``False`` when the tries or the
+            largest budget ran out.
+        """
+        p = self.policy
+        smallest = first_growth
+        history = [(audit.dofs, audit.worst_ratio)]
+        for attempt in range(p.max_refinements):
+            if p.unified_rule:
+                self._refresh_unified_design(audit, operator, frequency)
+            growth = self._growth(audit, smallest, history)
+            rate = self._measured_rate(history) if p.unified_rule else p.rate
+            target = int(audit.dofs * growth)
+            limited = p.max_dofs is not None and target >= p.max_dofs
+            if limited:
+                target = p.max_dofs
+            mesh, dofs = self._designed_mesh(f"{tag}{attempt}", target,
+                                             frequency, cap)
+            self.mesh, self.dofs = mesh, dofs
+            audit = self._audit(mesh, operator)
+            accepted = audit.worst_ratio <= p.theta
+            self._log("verification", accepted=accepted, target_dofs=target,
+                      **audit.summary())
+            fraction = self.dt_fraction
+            if not accepted:
+                audit = self._fix_time_error(audit, operator, "verification")
+                accepted = audit.worst_ratio <= p.theta
+            if p.unified_rule:
+                measured = audit.summary()
+                measured["work"] = 0.0
+                self._log("measured_growth", rate_used=rate, growth=growth,
+                          **measured)
+                if fraction != self.dt_fraction:
+                    history.clear()
+                history.append((audit.dofs, audit.worst_ratio))
+            if accepted:
+                return True
+            if limited:
+                break
+            smallest = p.growth_min if p.unified_rule else p.refine_growth
+        self._log("unverified_mesh", mesh=self.mesh.name, dofs=self.dofs,
+                  note="accuracy not met within the limits; the stage goes "
+                       "on without further refinement")
+        return False
+
+    # ------------------------------------------------------------- stages
+    def _initial_mesh(self, operator: TraceOperator, frequency: float) -> None:
+        """Initial phase: raise the cells per wavelength until the pilot is reliable.
+
+        Parameters
+        ----------
+        operator : TraceOperator
+            Data processing of the first stage.
+        frequency : float
+            Frequency of the first stage (Hz).
+
+        Returns
+        -------
+        None
+            The last uniform mesh becomes the current one.
+        """
+        p = self.policy
+        cpw = p.cpw_start
+        while True:
+            self.mesh, self.dofs = self._cpw_mesh(cpw, frequency)
+            self.pilot.velocity = self.grid.sampler(self.model)
+            result = self.pilot.run(str(self.mesh))
+            relative = self._pilot_relative_errors(
+                result, self._audit_operator(operator))
+            reliable = max(relative) <= p.eta_reliable
+            cost = ({"work": float((result.dofs_coarse + result.dofs_fine)
+                                   * result.steps * len(result.trace_errors))}
+                    if p.unified_rule else {})
+            self._log("initial_phase", cpw=cpw, reliable=reliable, dofs=self.dofs,
+                      pilot_relative_error=relative, **cost)
+            if reliable or cpw * p.cpw_factor > p.cpw_max + 1e-9:
+                return
+            cpw *= p.cpw_factor
+
+    def _start_stage(self, operator: TraceOperator, frequency: float) -> bool:
+        """Design and verify the mesh of a stage at the current model.
+
+        Parameters
+        ----------
+        operator : TraceOperator
+            Data processing of the stage.
+        frequency : float
+            Frequency of the stage (Hz).
+
+        Returns
+        -------
+        bool
+            Whether the mesh of the stage was accepted.
+        """
+        p = self.policy
+        if p.unified_rule:
+            return self._start_unified_stage(operator, frequency)
+        adjoint = p.strategy == "adjoint"
+        audit = self._audit(self.mesh, operator, pilot=True, indicator=adjoint)
+        self._log("stage_pilot", **audit.summary())
+        while max(audit.pilot_relative_errors) > p.eta_reliable:
+            # Recovery: the pilot is not reliable on the current mesh.
+            cpw = self._equivalent_cpw(self.dofs, frequency) * p.cpw_factor
+            if cpw > p.cpw_max + 1e-9:
+                break
+            self.mesh, self.dofs = self._cpw_mesh(cpw, frequency)
+            audit = self._audit(self.mesh, operator, pilot=True, indicator=adjoint)
+            self._log("recovery", cpw=cpw, **audit.summary())
+        result = audit.result
+        relative = np.array(audit.pilot_relative_errors)
+        # The time error is not what a new mesh would fix.
+        audit = self._fix_time_error(audit, operator, "stage_pilot")
+
+        size, dofs = self._mesh_size(self.mesh)
+        velocity = self._velocity()
+        smoothing = self._smoothing(frequency)
+        if adjoint:
+            density = self._on_root(lambda: adjoint_density(
+                result.centroids, result.indicators, relative ** 2,
+                self.z, self.x, smoothing))
+        elif p.strategy == "cpw":
+            # The uniform meshes follow the velocity, not a density.
+            density = None
+        else:
+            density = gradient_density(velocity, p.grid_spacing, smoothing,
+                                       self.interior)
+        self._design = {
+            "density": density, "size": size,
+            # DOFs per unit of sum(h^-2) area, measured on the reference mesh.
+            "calibration": dofs / float((size ** -2).sum() * p.grid_spacing ** 2)}
+        return self._verified_mesh(audit, operator, frequency, "stage",
+                                   p.stage_growth_min, cap=None)
+
+    def _start_unified_stage(self, operator: TraceOperator, frequency: float) -> bool:
+        """Keep an accepted current mesh or refine it without coarsening.
+
+        Parameters
+        ----------
+        operator : TraceOperator
+            Stage data processing.
+        frequency : float
+            Stage frequency in Hz.
+
+        Returns
+        -------
+        bool
+            Whether the current or refined mesh meets the acceptance margin.
+        """
+        p = self.policy
+        audit = self._audit(self.mesh, operator, pilot=True, indicator=False)
+        self._log("stage_pilot", **audit.summary())
+        while max(audit.pilot_relative_errors) > p.eta_reliable:
+            cpw = self._equivalent_cpw(self.dofs, frequency) * p.cpw_factor
+            if cpw > p.cpw_max + 1e-9:
+                break
+            cap, _ = self._mesh_size(self.mesh)
+            self.mesh, self.dofs = self._cpw_mesh(cpw, frequency, cap=cap)
+            audit = self._audit(self.mesh, operator, pilot=True, indicator=False)
+            self._log("recovery", cpw=cpw, **audit.summary())
+        audit = self._fix_time_error(audit, operator, "stage_pilot")
+        if audit.worst_ratio <= p.theta:
+            accepted = audit.summary()
+            accepted["work"] = 0.0
+            self._log("stage_current_mesh_accepted", **accepted)
+            return True
+        cap, _ = self._mesh_size(self.mesh)
+        return self._verified_mesh(audit, operator, frequency, "stage", p.growth_min, cap)
+
+    def _predicted_ratio(self, value: float, gradient_norm: float | None) -> float:
+        """Ratio of the current iterate predicted from the last audit.
+
+        On a fixed mesh the errors :math:`E_s` and :math:`e_g` change slowly;
+        the residuals follow the misfit, :math:`R_s \\approx R_s^a
+        \\sqrt{J/J^a}`, and the gradient norm is TAO's.
+
+        Parameters
+        ----------
+        value : float
+            Misfit at the iterate.
+        gradient_norm : float or None
+            Norm of the projected gradient at the iterate, in the metric of
+            the audits, or ``None`` when unknown.
+
+        Returns
+        -------
+        float
+            The predicted :math:`\\rho`.
+        """
+        p = self.policy
+        audit = self._last_audit
+        factor = math.sqrt(value / audit.value) if audit.value > 0.0 else 1.0
+        ratios = []
+        for error, residual, tolerance, noise in zip(
+                audit.errors, audit.residuals, audit.tolerances, audit.noise):
+            tau = p.kappa * max(residual * factor, noise)
+            if p.epsilon_max is not None:
+                # The cap is the one of the audit: it does not change.
+                cap = tolerance if tolerance < p.kappa * max(residual, noise) else math.inf
+                tau = min(tau, cap)
+            ratios.append(error / tau)
+        predicted = max(ratios)
+        if (audit.gradient_error is not None and p.xi is not None
+                and gradient_norm is not None):
+            predicted = max(predicted, audit.gradient_error / (p.xi * gradient_norm)
+                            if gradient_norm > 0.0 else math.inf)
+        return predicted
+
+    def _discrepancy_reached(self, value: float) -> bool:
+        """Whether the residual has fallen to the discrepancy level.
+
+        Parameters
+        ----------
+        value : float
+            Misfit at the iterate.
+
+        Returns
+        -------
+        bool
+            :math:`\\sqrt{2J} \\le \\tau_D \\|\\sigma + E\\|`, with the errors of
+            the last audit.
+        """
+        audit = self._last_audit
+        level = math.sqrt(sum((s + e) ** 2 for s, e in zip(audit.noise, audit.errors)))
+        return math.sqrt(2.0 * value) <= self.policy.discrepancy * level
+
+    def _optimize(self, stage_index: int, operator: TraceOperator,
+                  budget: int, may_refine: bool) -> tuple[int, str, Audit | None]:
+        """Run TAO on the current mesh until it ends or the mesh must change.
+
+        Parameters
+        ----------
+        stage_index : int
+            Index of the stage.
+        operator : TraceOperator
+            Data processing of the stage.
+        budget : int
+            Iterations left in the stage.
+        may_refine : bool
+            Whether a failed audit may still end TAO to refine the mesh.
+
+        Returns
+        -------
+        tuple
+            Iterations used, why TAO ended (``"tao"``, ``"audit"``,
+            ``"discrepancy"`` or ``"restart"``) and the audit that failed, if
+            one did.
+        """
+        p = self.policy
+        local = self._functional(self.mesh, operator, "coarse")
+        # The functional may have been built at an earlier model: TAO starts
+        # from its control.
+        local.controls[0].update(self.grid.function(self.model))
+        functional = (local if self.ensemble is None
+                      else EnsembleFWIFunctional(local, self.ensemble))
+        before = local.forwards + local.adjoints
+        state = {"iterations": 0, "reason": "tao", "audit": None, "last_audit": 0,
+                 # TAO's projected gradient norm to the one of the audits.
+                 "scale": 1.0,
+                 # Solves of the TAO functional made by the audits.
+                 "audit_solves": 0}
+        offset = len(self.report["history"])
+        self._log("tao_start", stage=stage_index, mesh=self.mesh.name,
+                  dofs=local.dofs, dt=local.dt, steps=local.steps,
+                  iterations_left=budget)
+
+        def record(iteration: int, value: float, controls: list,
+                   gradient_norm: float) -> bool:
+            """Monitor an accepted iterate; ask TAO to stop to change the mesh.
+
+            Parameters
+            ----------
+            iteration : int
+                Iteration of this TAO solve.
+            value : float
+                Functional at the iterate.
+            controls : list of firedrake.Function
+                The iterate.
+            gradient_norm : float
+                TAO's norm of the projected gradient at the iterate.
+
+            Returns
+            -------
+            bool
+                Whether TAO must stop at this iterate.
+            """
+            self.model = self.grid.to_array(controls[0])
+            state["iterations"] = iteration
+            self._save_model(offset + iteration)
+            predicted = self._predicted_ratio(value, state["scale"] * gradient_norm)
+            self.report["history"].append({
+                "iteration": offset + iteration, "stage": stage_index,
+                "mesh": self.mesh.name, "dofs": local.dofs, "dt": local.dt,
+                "J": float(value), "gradient_norm": float(gradient_norm),
+                "predicted_ratio": predicted})
+            self._log("iterate", iteration=offset + iteration, J=float(value),
+                      gradient_norm=float(gradient_norm), predicted_ratio=predicted)
+            if iteration >= budget:
+                return False
+            if offset + iteration in p.restarts:
+                state["reason"] = "restart"
+                return True
+            if p.discrepancy is not None and self._discrepancy_reached(value):
+                state["reason"] = "discrepancy"
+                return True
+            if not p.update_during_iterations:
+                return False
+            periodic = (not p.audit_only_on_prediction
+                        and iteration - state["last_audit"] >= p.audit_every)
+            if predicted > p.predict_threshold or periodic:
+                solves = local.forwards + local.adjoints
+                audit = self._audit(self.mesh, operator)
+                state["audit_solves"] += local.forwards + local.adjoints - solves
+                state["last_audit"] = iteration
+                if audit.gradient_norm and gradient_norm > 0.0:
+                    state["scale"] = audit.gradient_norm / gradient_norm
+                failed = audit.worst_ratio > 1.0
+                self._log("audit", iteration=offset + iteration, failed=failed,
+                          trigger="predicted" if predicted > p.predict_threshold
+                          else "periodic", predicted_ratio=predicted,
+                          **audit.summary())
+                if failed and may_refine:
+                    state["reason"], state["audit"] = "audit", audit
+                    return True
+            return False
+
+        solution = minimize_with_tao(
+            functional, bounds=[(self._bound(self.lower), self._bound(self.upper))],
+            comm=self.comm, options={**self.tao_options, "tao_max_it": budget},
+            record=record)
+        self.model = self.grid.to_array(solution[0])
+        # The audits evaluate the same functional: their solves are theirs.
+        solves = local.forwards + local.adjoints - before - state["audit_solves"]
+        self._log("tao_end", stage=stage_index, reason=state["reason"],
+                  iterations=state["iterations"],
+                  work=float(self._sum_members(solves * local.dofs * local.steps)))
+        return state["iterations"], state["reason"], state["audit"]
+
+    def _bound(self, bound: float | np.ndarray) -> float | fire.Function:
+        """A bound of the velocity in the form TAO takes.
+
+        Parameters
+        ----------
+        bound : float or numpy.ndarray
+            Scalar, or array of shape ``grid.shape``.
+
+        Returns
+        -------
+        float or firedrake.Function
+            The scalar, or the field in the control space.
+        """
+        if np.isscalar(bound):
+            return float(bound)
+        return self.grid.function(bound, name="bound")
+
+    def run(self) -> dict:
+        """Run every stage of the inversion.
+
+        Returns
+        -------
+        dict
+            The report, also written to ``report_fwi.json``. The model of
+            each stage is saved as ``model_stage<k>.npy``.
+        """
+        start = self._start = time.perf_counter()
+        p = self.policy
+        self._saved_models = []
+        self._save_model(0)
+        for index, stage in enumerate(self.stages):
+            operator = TraceOperator(self.window, stage.cutoff)
+            frequency = stage.cutoff or self.peak_frequency
+            self._log("stage_start", stage=index, cutoff=stage.cutoff,
+                      frequency=frequency)
+            if self.mesh is None:
+                self._initial_mesh(operator, frequency)
+            verified = self._start_stage(operator, frequency)
+            budget = stage.max_iterations
+            while budget > 0:
+                used, reason, audit = self._optimize(index, operator, budget, verified)
+                budget -= max(used, 1)
+                if reason in ("tao", "discrepancy") or budget <= 0:
+                    break
+                if reason == "audit":
+                    audit = self._fix_time_error(audit, operator, "verification")
+                    if audit.worst_ratio > p.theta:
+                        cap, _ = self._mesh_size(self.mesh)
+                        verified = self._verified_mesh(
+                            audit, operator, frequency, "refine",
+                            p.growth_min if p.unified_rule else p.refine_growth, cap)
+            if self._root:
+                np.save(self.output_dir / f"model_stage{index}.npy", self.model)
+            # Error of the last mesh at the model the stage ends with.
+            audit = self._audit(self.mesh, operator)
+            self._log("final_audit", stage=index, failed=audit.worst_ratio > 1.0,
+                      **audit.summary())
+        self.report["elapsed_s"] = time.perf_counter() - start
+        self._log("end", mesh=self.mesh.name, dofs=self.dofs,
+                  dt_fraction=self.dt_fraction)
+        return self.report
