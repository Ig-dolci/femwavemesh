+"""Misfit so far of the cases of ``run_marmousi_fwi.sh``, while they run.
+
+Usage::
+
+    python plot_progress.py <directory with one folder per case>
+
+Writes ``progress_misfit.png`` and, for each case, ``<case>/meshes.png`` with
+the meshes the optimiser has used so far, ``<case>/model_final.png`` for
+the finished cases and ``<case>/model_latest.png`` (last saved iterate) for
+the running ones. Only the files the cases have written are read,
+so it works on cases that have not finished.
+
+AI assistance: written by Claude (Anthropic), reviewed by the author.
+"""
+import json
+import sys
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+import meshio  # noqa: E402
+import numpy as np  # noqa: E402
+
+# This checkout of spyro, whatever the folder the script is run from.
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from marmousi_fwi import geometry  # noqa: E402
+
+COLORS = {"cpw": "C0", "gradient": "C2", "adjoint": "C3"}
+
+
+def reports(root: Path) -> dict:
+    """Read the reports of the cases that have started.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory with one folder per case.
+
+    Returns
+    -------
+    dict
+        ``report_fwi.json`` of each case, by case name.
+    """
+    found = {}
+    for file in sorted(root.glob("*/report_fwi.json")):
+        try:
+            found[file.parent.name] = json.loads(file.read_text())
+        except json.JSONDecodeError:
+            continue  # being rewritten right now
+    return found
+
+
+def plot_misfit(root: Path, cases: dict) -> Path:
+    """Misfit and degrees of freedom along the iterations.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`reports`.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    fig, (top, bottom) = plt.subplots(2, 1, figsize=(8, 7), sharex=True,
+                                      constrained_layout=True)
+    for name, report in cases.items():
+        history = report["history"]
+        if not history:
+            continue
+        strategy, _, mode = name.partition("_")
+        style = dict(color=COLORS.get(strategy, "k"),
+                     ls="-" if mode == "update" else "--", label=name)
+        iteration = [h["iteration"] for h in history]
+        top.semilogy(iteration, [h["J"] for h in history], marker=".", **style)
+        bottom.step(iteration, [h["dofs"] for h in history], where="post",
+                    **style)
+    top.set_ylabel("J (on the mesh of the iteration)")
+    top.legend(ncol=2, fontsize=8)
+    top.grid(alpha=0.3)
+    bottom.set_ylabel("degrees of freedom")
+    bottom.set_xlabel("iteration")
+    bottom.grid(alpha=0.3)
+    file = root / "progress_misfit.png"
+    fig.savefig(file, dpi=130)
+    plt.close(fig)
+    return file
+
+
+def plot_meshes(folder: Path, report: dict) -> Path | None:
+    """Meshes the optimiser of one case has used so far.
+
+    Parameters
+    ----------
+    folder : pathlib.Path
+        Folder of the case.
+    report : dict
+        Its ``report_fwi.json``.
+
+    Returns
+    -------
+    pathlib.Path or None
+        File of the figure, ``None`` before the first iteration.
+    """
+    used = list(dict.fromkeys(h["mesh"] for h in report["history"]))
+    if not used:
+        return None
+    dofs = {h["mesh"]: h["dofs"] for h in report["history"]}
+    fig, axes = plt.subplots(len(used), 1, figsize=(9, 6.5 * len(used)),
+                             constrained_layout=True, squeeze=False)
+    for ax, name in zip(axes[:, 0], used):
+        mesh = meshio.read(folder / "meshes" / name)
+        triangles = mesh.cells_dict["triangle"]
+        ax.triplot(mesh.points[:, 1], mesh.points[:, 0], triangles, lw=0.25,
+                   color="k")
+        ax.set_aspect("equal")
+        ax.set_title(f"{folder.name}: {name}, {dofs[name]} DOFs, "
+                     f"{len(triangles)} triangles", fontsize=10)
+        ax.set_xlabel("x (km)")
+        ax.set_ylabel("z (km)")
+    file = folder / "meshes.png"
+    fig.savefig(file, dpi=150)
+    plt.close(fig)
+    return file
+
+
+def plot_final_model(folder: Path) -> Path | None:
+    """True, starting and final models of a finished case, and their errors.
+
+    Parameters
+    ----------
+    folder : pathlib.Path
+        Folder of the case.
+
+    Returns
+    -------
+    pathlib.Path or None
+        File of the figure, ``None`` while the case runs.
+    """
+    if not (folder / "summary.json").exists():
+        return None
+    summary = json.loads((folder / "summary.json").read_text())
+    title = (
+        f"{folder.name}: RMS error {summary['model_rms_error_initial']:.4f} -> "
+        f"{summary['model_rms_error_final']:.4f} km/s, J last / first "
+        f"{summary['J_last'] / summary['J_first']:.2e}")
+    return plot_model(folder / "model_final.png", np.load(folder / "model_true.npy"),
+                      np.load(folder / "model_initial.npy"),
+                      np.load(folder / "model_stage0.npy"),
+                      f"final ({summary['iterations']} iterations)", title)
+
+
+def plot_latest_model(folder: Path, root: Path) -> Path | None:
+    """Latest iterate of a running case, against the true and starting models.
+
+    The true and starting models are the same for every case; they are read
+    from a finished case, since a running one writes them only at the end.
+
+    Parameters
+    ----------
+    folder : pathlib.Path
+        Folder of the case.
+    root : pathlib.Path
+        Directory of all the cases.
+
+    Returns
+    -------
+    pathlib.Path or None
+        File of the figure, ``None`` when the case has finished, has no
+        saved iterate, or no case has finished yet.
+    """
+    iterates = sorted(folder.glob("model_iter*.npy"))
+    finished = sorted(root.glob("*/model_true.npy"))
+    if (folder / "summary.json").exists() or not iterates or not finished:
+        return None
+    true = np.load(finished[0])
+    initial = np.load(finished[0].with_name("model_initial.npy"))
+    latest = np.load(iterates[-1])
+    iteration = int(iterates[-1].stem.removeprefix("model_iter"))
+
+    def rms(model: np.ndarray) -> float:
+        """Root-mean-square difference from the true model.
+
+        Parameters
+        ----------
+        model : numpy.ndarray
+            Model on the grid.
+
+        Returns
+        -------
+        float
+            RMS error (km/s).
+        """
+        return float(np.sqrt(np.mean((model - true) ** 2)))
+
+    title = (f"{folder.name}, running: iteration {iteration}, RMS error "
+             f"{rms(initial):.4f} -> {rms(latest):.4f} km/s")
+    return plot_model(folder / "model_latest.png", true, initial, latest,
+                      f"iteration {iteration}", title)
+
+
+def plot_model(file: Path, true: np.ndarray, initial: np.ndarray,
+               final: np.ndarray, label: str, title: str) -> Path:
+    """Figure of a model against the true and starting models.
+
+    Parameters
+    ----------
+    file : pathlib.Path
+        File of the figure.
+    true, initial, final : numpy.ndarray
+        Models on the parameter grid.
+    label : str
+        Title of the panel of ``final``.
+    title : str
+        Title of the figure.
+
+    Returns
+    -------
+    pathlib.Path
+        The file written.
+    """
+    domain, sources, receivers, _ = geometry()
+    z = np.linspace(domain.z_min, 0.0, true.shape[0])
+    x = np.linspace(domain.x_min, domain.x_max, true.shape[1])
+    extent = [x[0], x[-1], z[0], z[-1]]
+    fig = plt.figure(figsize=(15, 8.5), constrained_layout=True)
+    grid = fig.add_gridspec(2, 4, width_ratios=[1, 1, 1, 0.55])
+    limits = dict(vmin=true.min(), vmax=true.max(), cmap="viridis")
+    spread = 0.5
+    panels = [
+        (grid[0, 0], true, "true", limits),
+        (grid[0, 1], initial, "initial", limits),
+        (grid[0, 2], final, label, limits),
+        (grid[1, 0], final - initial, "update: final - initial",
+         dict(vmin=-spread, vmax=spread, cmap="RdBu_r")),
+        (grid[1, 1], initial - true, "error of the initial: initial - true",
+         dict(vmin=-spread, vmax=spread, cmap="RdBu_r")),
+        (grid[1, 2], final - true, "error of the final: final - true",
+         dict(vmin=-spread, vmax=spread, cmap="RdBu_r"))]
+    for spec, values, panel_title, style in panels:
+        ax = fig.add_subplot(spec)
+        image = ax.imshow(values, origin="lower", extent=extent,
+                          aspect="equal", **style)
+        ax.plot([s[1] for s in sources], [s[0] for s in sources], "r*", ms=6)
+        ax.set_title(panel_title, fontsize=10)
+        ax.set_xlabel("x (km)")
+        ax.set_ylabel("z (km)")
+        fig.colorbar(image, ax=ax, shrink=0.7, label="km/s")
+    # Vertical profiles at three positions.
+    profile = fig.add_subplot(grid[:, 3])
+    for column, color in zip(np.searchsorted(x, [0.8, 1.3, 1.8]),
+                             ("C0", "C1", "C2")):
+        label = f"x = {x[column]:.2f} km"
+        profile.plot(true[:, column], z, color=color, lw=2, label=label)
+        profile.plot(initial[:, column], z, color=color, ls=":")
+        profile.plot(final[:, column], z, color=color, ls="--")
+    profile.set_xlabel("velocity (km/s)")
+    profile.set_ylabel("z (km)")
+    profile.set_title("true (solid), initial (dotted)\nfinal (dashed)",
+                      fontsize=9)
+    profile.legend(fontsize=8)
+    profile.grid(alpha=0.3)
+    fig.suptitle(title)
+    fig.savefig(file, dpi=130)
+    plt.close(fig)
+    return file
+
+
+def main() -> None:
+    """Write the figures of the directory of the command line.
+
+    Returns
+    -------
+    None
+        The files are written in that directory.
+    """
+    root = Path(sys.argv[1])
+    cases = reports(root)
+    print(plot_misfit(root, cases))
+    for name, report in cases.items():
+        for file in (plot_meshes(root / name, report),
+                     plot_final_model(root / name),
+                     plot_latest_model(root / name, root)):
+            if file is not None:
+                print(file)
+
+
+if __name__ == "__main__":
+    main()
