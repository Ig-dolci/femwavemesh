+    monkeypatch : pytest.MonkeyPatch
+        Supplies one completed verification with a known nonzero cost.
+
+    Returns
+    -------
+    None
+        Asserts total reported work equals the actual audit cost once.
+    """
+    verified = audit(.5, 1500)
+    verified.work = 17.
+    monkeypatch.setattr(driver, "_refresh_unified_design", lambda *a: None)
+    monkeypatch.setattr(driver, "_designed_mesh", lambda *a: (driver.mesh.with_name("new.msh"), 1500))
+    monkeypatch.setattr(driver, "_audit", lambda *a: verified)
+    assert driver._verified_mesh(audit(2.), loop.TraceOperator(), 5., "stage", 1.15, None)
+    assert sum(event.get("work", 0) for event in driver.report["events"]) == 17.
