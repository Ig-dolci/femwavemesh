+"""FWI on a fixed parameter grid with the UFL-derived adjoint and TAO.
+
+The Taylor test covers the complete chain: control on the parameter grid,
+its transfer to the wave mesh (lumped L2 projection, or sampling at the
+nodes), forward solve, data processing (window and low-pass filter), misfit,
+and the way back through the adjoint, the lumped mass of the wave space and
+the transpose of the transfer.
+"""
+
+import importlib.util
+import os
+import sys
+import warnings
+from xml.etree import ElementTree
+
+import numpy as np
+import pytest
+
+import firedrake as fire
+from firedrake.adjoint import (Control, ReducedFunctional, continue_annotation,
+                               pause_annotation, set_working_tape, Tape)
+from spyro.adaptivity import (FWIFunctional, GridProjection, MeshAdaptiveFWI,
+                              MeshPolicy,
+                              ParameterGrid, RectangularDomain, Stage,
+                              TraceOperator, TwoLevelPilot, VelocityGrid,
+                              generate_mesh, synthesize_observations)
+from spyro.adaptivity.fwi_functional import ObservedData
+from spyro.adaptivity.fwi_loop import Audit, _json_value
+from spyro.adaptivity.paraview import write_pvd, write_vti
+from spyro.adaptivity.pilot import broken_velocity, nodal_velocity
+from spyro.tools.optimization import minimize_with_tao
+
+heavy = pytest.mark.skipif(os.environ.get("SPYRO_HEAVY_TESTS") != "1",
+                           reason="heavy test: set SPYRO_HEAVY_TESTS=1 to run")
+INTERFACE = -0.3
+FREQUENCY = 5.0
+DOMAIN = RectangularDomain(z_min=-1.0, x_min=0.0, x_max=1.2, pad=0.2)
+RECEIVERS = [(-0.1, x) for x in np.linspace(0.2, 1.0, 9)]
+
+
+def two_layer(z: np.ndarray, x: np.ndarray) -> np.ndarray:
+    """Water over a faster layer.
+
+    Parameters
+    ----------
+    z : numpy.ndarray
+        Depths.
+    x : numpy.ndarray
+        Horizontal positions.
+
+    Returns
+    -------
+    numpy.ndarray
+        Velocity (km/s).
+    """
+    return np.where(np.asarray(z) > INTERFACE, 1.5, 2.5) + 0.0 * np.asarray(x)
+
+
+def late_window(times: np.ndarray, shot: int) -> np.ndarray:
+    """Window that drops the first 0.25 s of every trace.
+
+    Parameters
+    ----------
+    times : numpy.ndarray
+        Sample times.
+    shot : int
+        Source index (unused).
+
+    Returns
+    -------
+    numpy.ndarray
+        Boolean ``(n_times, n_receivers)``.
+    """
+    return np.broadcast_to(times[:, None] > 0.25, (len(times), len(RECEIVERS)))
+
+
+def dictionary(final_time: float = 0.6) -> dict:
+    """spyro dictionary of the small test problem, with two shots.
+
+    Parameters
+    ----------
+    final_time : float, optional
+        Duration (s).
+
+    Returns
+    -------
+    dict
+        KMV2 triangles, pressure-free top, non-reflecting bottom and sides.
+    """
+    return {
+        "options": {"cell_type": "T", "variant": "lumped", "degree": 2,
+                    "dimension": 2},
+        "parallelism": {"type": "spatial"},
+        "mesh": {"length_z": 1.0, "length_x": 1.2, "length_y": 0.0,
+                 "mesh_type": "user_mesh"},
+        "acquisition": {"source_type": "ricker",
+                        "source_locations": [(-0.05, 0.4), (-0.05, 0.8)],
+                        "frequency": FREQUENCY, "delay": 1.5,
+                        "delay_type": "multiples_of_minimum",
+                        "receiver_locations": RECEIVERS},
+        "absorving_boundary_conditions": {
+            "status": True, "abc_type": "nrbc", "free_surface": True,
+            "damping_layer": None},
+        "time_axis": {"initial_time": 0.0, "final_time": final_time,
+                      "dt": 1e-3, "amplitude": 1, "output_frequency": 10**9,
+                      "gradient_sampling_frequency": 1},
+        "visualization": {"forward_output": False, "forward_output_filename": None,
+                          "fwi_velocity_model_output": False,
+                          "velocity_model_filename": None, "gradient_output": False,
+                          "gradient_filename": None, "adjoint_output": False,
+                          "adjoint_filename": None, "debug_output": False},
+    }
+
+
+def cpw_mesh(path, cpw: float) -> str:
+    """Uniform mesh of the two-layer model.
+
+    Parameters
+    ----------
+    path : pathlib.Path
+        Output file.
+    cpw : float
+        Cells per wavelength.
+
+    Returns
+    -------
+    str
+        The mesh file.
+    """
+    spacing = 0.01
+    z, x = DOMAIN.grid(spacing)
+    Z, X = np.meshgrid(z, x, indexing="ij")
+    size = VelocityGrid(two_layer(Z - 1e-9, X) / (cpw * FREQUENCY),
+                        z[0], x[0], spacing, spacing)
+    return str(generate_mesh(path, DOMAIN, size, [INTERFACE]))
+
+
+def grid_positions(grid: ParameterGrid) -> tuple[np.ndarray, np.ndarray]:
+    """Positions of the values of a parameter grid.
+
+    Parameters
+    ----------
+    grid : ParameterGrid
+        The grid.
+
+    Returns
+    -------
+    tuple of numpy.ndarray
+        ``Z`` and ``X`` of shape ``grid.shape``.
+    """
+    z = grid.origin[0] + grid.dz * np.arange(grid.shape[0])
+    x = grid.origin[1] + grid.dx * np.arange(grid.shape[1])
+    return np.meshgrid(z, x, indexing="ij")
+
+
+@pytest.mark.parametrize("cutoff", [None, 6.0])
+def test_trace_operator_transpose(cutoff) -> None:
+    """``<B a, b> = <a, B^T b>`` to round-off, filter edges included."""
+    operator = TraceOperator(late_window, cutoff)
+    rng = np.random.default_rng(0)
+    a = rng.standard_normal((300, len(RECEIVERS)))
+    b = rng.standard_normal((300, len(RECEIVERS)))
+    left = np.sum(operator.apply(a, 2e-3, 0) * b)
+    right = np.sum(a * operator.transpose(b, 2e-3, 0))
+    assert left == pytest.approx(right, rel=1e-12)
+
+
+def test_low_pass_removes_high_frequencies() -> None:
+    """A 2 Hz sine passes a 5 Hz cut-off and a 20 Hz one does not."""
+    operator = TraceOperator(cutoff=5.0)
+    times = np.arange(2000) * 1e-3
+    taper = np.sin(np.pi * times / times[-1]) ** 2
+    low = (taper * np.sin(2 * np.pi * 2.0 * times))[:, None]
+    high = (taper * np.sin(2 * np.pi * 20.0 * times))[:, None]
+    assert np.linalg.norm(operator.low_pass(low, 1e-3) - low) < 0.05 * np.linalg.norm(low)
+    assert np.linalg.norm(operator.low_pass(high, 1e-3)) < 1e-3 * np.linalg.norm(high)
+
+
+@pytest.mark.parametrize("element", ["Q1", "DG0"])
+def test_parameter_grid_round_trip_and_sampling(element: str) -> None:
+    """Compare array transfers and point evaluation with the grid sampler.
+
+    Parameters
+    ----------
+    element : str
+        Parameter-grid element, Q1 or DG0.
+
+    Returns
+    -------
+    None
+        Assert the round trip and agreement at the sampled points.
+    """
+    grid = ParameterGrid(DOMAIN, 0.1, element)
+    rng = np.random.default_rng(1)
+    values = rng.uniform(1.5, 3.0, grid.shape)
+    assert np.allclose(grid.to_array(grid.function(values)), values)
+    assert np.allclose(grid.to_array(grid.cofunction(values)), values)
+    z = rng.uniform(DOMAIN.z_min, DOMAIN.z_max, 50)
+    x = rng.uniform(DOMAIN.x_min, DOMAIN.x_max, 50)
+    assert np.allclose(grid.sampling_matrix(z, x) @ values.ravel(),
+                       grid.sampler(values)(z, x))
+    # A Q1 function is its own bilinear interpolant.
+    if element == "Q1":
+        model = grid.function(values)
+        points = np.column_stack([z, x])
+        evaluator = fire.PointEvaluator(model.function_space().mesh(), points,
+                                        tolerance=1e-10)
+        assert np.allclose(evaluator.evaluate(model),
+                           grid.sampler(values)(z, x))
+
+
+@pytest.mark.parametrize("element", ["Q1", "DG0"])
+def test_parameter_grid_fixed_layer(element: str) -> None:
+    """A fixed top layer is a sharp interface that the values above never move."""
+    layer = (INTERFACE - 0.013, 1.5)  # between two rows of the grid
+    grid = ParameterGrid(DOMAIN, 0.1, element, fixed_layer=layer)
+    rng = np.random.default_rng(4)
+    values = rng.uniform(1.8, 3.0, grid.shape)
+    z = np.concatenate([rng.uniform(DOMAIN.z_min, DOMAIN.z_max, 200),
+                        [layer[0], layer[0] + 1e-9, layer[0] - 1e-9]])
+    x = rng.uniform(DOMAIN.x_min, DOMAIN.x_max, z.size)
+    model = grid.sampler(values)(z, x)
+    matrix = grid.sampling_matrix(z, x)
+    assert np.allclose(matrix @ values.ravel() + grid.fixed_values(z), model)
+    above = z > layer[0]
+    assert np.all(model[above] == 1.5)
+    # Below, the model interpolates only values below the interface: the
+    # same values with those above changed give the same model.
+    Z, _ = grid_positions(grid)
+    changed = np.where(Z > layer[0], 9.0, values)
+    assert np.allclose(grid.sampler(changed)(z, x), model)
+    # ... so no value above the interface has a weight anywhere.
+    assert np.all(abs(matrix).sum(axis=0).A1[(Z > layer[0]).ravel()] == 0.0)
+    # Just below the interface the model is the sediment, not a ramp to 1.5.
+    assert model[-1] > 1.8 - 1e-12
+    scaled = grid.sampler(values).scaled(0.5)
+    assert np.allclose(scaled(z, x), 0.5 * model)
+
