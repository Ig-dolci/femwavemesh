+@dataclass
+class Audit:
+    """Audit of a mesh at a model: the error of its operator and of its gradient.
+
+    Parameters
+    ----------
+    mesh : str
+        Audited mesh.
+    dofs : int
+        Its degrees of freedom.
+    dt : float
+        Time step of the inversion on the mesh (s).
+    value : float
+        Misfit :math:`J_H` of the mesh at the model.
+    errors : list of float
+        :math:`E_s` of each shot (mesh at :math:`\\Delta t` against its
+        refinement at :math:`\\Delta t/2`).
+    residuals : list of float
+        :math:`R_s` of each shot.
+    tolerances : list of float
+        :math:`\\tau_s` of each shot.
+    relative_errors : list of float
+        :math:`E_s / \\|B_s d_h\\|` of each shot.
+    noise : list of float
+        :math:`\\sigma_s` of each shot.
+    time_errors : list of float or None
+        :math:`\\|B_s(d_{H,\\Delta t} - d_{H,\\Delta t/2})\\|` of each shot, with
+        ``time_split``.
+    space_errors : list of float or None
+        :math:`\\|B_s(d_{H,\\Delta t/2} - d_{h,\\Delta t/2})\\|` of each shot,
+        with ``time_split``.
+    gradient_error : float or None
+        :math:`e_g`, without the gradient criterion ``None``.
+    gradient_norm : float or None
+        :math:`\\|P g_H\\|_M`.
+    xi : float or None
+        :math:`\\xi` of the policy.
+    work : float
+        Degrees of freedom times time steps of every propagation of the audit.
+    result : PilotResult or None
+        The two-level pilot of the mesh, when one ran (for the indicator and
+        the reliability of the design), else ``None``.
+    pilot_relative_errors : list of float or None
+        Relative trace errors of the pilot, in the norm of the misfit.
+    """
+
+    mesh: str
+    dofs: int
+    dt: float
+    value: float
+    errors: list[float]
+    residuals: list[float]
+    tolerances: list[float]
+    relative_errors: list[float]
+    noise: list[float]
+    time_errors: list[float] | None
+    space_errors: list[float] | None
+    gradient_error: float | None
+    gradient_norm: float | None
+    xi: float | None
+    work: float
+    result: PilotResult | None = field(default=None, repr=False)
+    pilot_relative_errors: list[float] | None = None
+
+    @property
+    def data_ratio(self) -> float:
+        """Largest :math:`E_s/\\tau_s` over the shots.
+
+        Returns
+        -------
+        float
+            The ratio of the modelling error to its tolerance.
+        """
+        return max(e / t for e, t in zip(self.errors, self.tolerances))
+
+    @property
+    def gradient_ratio(self) -> float:
+        """:math:`e_g/(\\xi\\|P g_H\\|_M)`.
+
+        Returns
+        -------
+        float
+            Zero without the gradient criterion; infinite when the projected
+            gradient vanishes but its error does not.
+        """
+        if self.gradient_error is None or self.xi is None:
+            return 0.0
+        if self.gradient_norm == 0.0:
+            return 0.0 if self.gradient_error == 0.0 else math.inf
+        return self.gradient_error / (self.xi * self.gradient_norm)
+
+    @property
+    def worst_ratio(self) -> float:
+        """Largest ratio of an error to its tolerance.
+
+        Returns
+        -------
+        float
+            :math:`\\rho`; above one, the audit fails.
+        """
+        return max(self.data_ratio, self.gradient_ratio)
+
+    @property
+    def time_dominated(self) -> bool:
+        """Whether the worst shot has more time error than space error.
+
+        Returns
+        -------
+        bool
+            ``False`` without ``time_split``, or when the gradient criterion
+            is the one that fails.
+        """
+        if self.time_errors is None or self.gradient_ratio > self.data_ratio:
+            return False
+        worst = int(np.argmax([e / t for e, t in zip(self.errors, self.tolerances)]))
+        return self.time_errors[worst] > self.space_errors[worst]
+
+    def summary(self) -> dict:
+        """Numbers of the audit for the report.
+
+        Returns
+        -------
+        dict
+            The per-shot norms, the gradient error and the cost.
+        """
+        return {"mesh": Path(self.mesh).name, "dofs": self.dofs, "dt": self.dt,
+                "J": self.value, "E": self.errors, "R": self.residuals,
+                "tau": self.tolerances, "sigma": self.noise,
+                "relative_error": self.relative_errors,
+                "E_time": self.time_errors, "E_space": self.space_errors,
+                "gradient_error": self.gradient_error,
+                "gradient_norm": self.gradient_norm,
+                "worst_E_over_tau": self.data_ratio,
+                "gradient_ratio": self.gradient_ratio,
+                "worst_ratio": self.worst_ratio,
+                "time_dominated": self.time_dominated,
+                "pilot_relative_error": self.pilot_relative_errors,
+                "work": self.work}
+
+
