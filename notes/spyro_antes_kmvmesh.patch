+def test_unique_names_stay_unique_with_the_workaround() -> None:
+    """Check uniqueness with the generator used by development Firedrake.
+
+    Returns
+    -------
+    None
+        Assert uniqueness and counter progression when pyop3 is available.
+    """
+    if importlib.util.find_spec("pyop3") is None:
+        pytest.skip("this Firedrake does not use the pyop3 name generator")
+    from pyop3 import utils
+    from spyro.adaptivity._firedrake_workarounds import speed_up_unique_names
+
+    assert speed_up_unique_names()
+    generator = utils.UniqueNameGenerator()
+    first = [generator("cofunction") for _ in range(50)]
+    # A numbered name that already exists, as Firedrake's own names do.
+    again = [generator("cofunction_3") for _ in range(50)]
+    assert len(set(first + again)) == 100
+    assert generator.prefix_to_counter["cofunction"] >= 99
+
+
+def test_unique_names_workaround_without_pyop3(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Leave Firedrake without pyop3 unaffected by the optional workaround.
+
+    Parameters
+    ----------
+    monkeypatch : pytest.MonkeyPatch
+        Restore the import table and workaround state after the test.
+
+    Returns
+    -------
+    None
+        Assert that the workaround reports itself as inactive.
+    """
+    from spyro.adaptivity import _firedrake_workarounds as workarounds
+
+    monkeypatch.setitem(sys.modules, "pyop3", None)
+    monkeypatch.setitem(workarounds._STATE, "unique_names_patched", False)
+    assert workarounds.speed_up_unique_names() is False
