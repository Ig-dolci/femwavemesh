+def initial_velocity(args: argparse.Namespace, true: VelocityGrid,
+                     domain: RectangularDomain, offset: float) -> VelocityGrid:
+    """The starting model.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+    true : VelocityGrid
+        Model that generates the data.
+    domain : RectangularDomain
+        Domain with the pad.
+    offset : float
+        Position of Marmousi2 subtracted from ``x`` (km).
+
+    Returns
+    -------
+    VelocityGrid
+        The window of ``--initial-model``, with the known water above the
+        sea floor; otherwise the smoothing of the true model by ``--sigma``.
+    """
+    if args.initial_model:
+        return true_velocity(args.initial_model, offset)
+    return starting_model(true, domain, args.sigma)
