+
+def uniform_size(domain: RectangularDomain, size: float,
+                 spacing: float = 0.05) -> VelocityGrid:
+    """Constant size field of a uniform mesh.
+
+    Parameters
+    ----------
+    domain : RectangularDomain
+        Domain with the pad.
+    size : float
+        Element size (km).
+    spacing : float, optional
+        Spacing of the grid of the field (km). Default ``0.05``.
+
+    Returns
+    -------
+    VelocityGrid
+        ``size`` everywhere, in the form :func:`generate_mesh` takes.
+    """
+    z, x = domain.grid(spacing)
+    return VelocityGrid(np.full((len(z), len(x)), float(size)), z[0], x[0],
+                        spacing, spacing)
+
+
+def true_velocity(model: str, offset: float) -> VelocityGrid:
+    """The true model, with the water as a fixed layer above the sea floor.
+
+    The model file samples the sea floor on its own grid, so between its last
+    water row and its first sediment row it would ramp. Declaring the water
+    as a fixed layer makes the jump sharp at the sea floor of the meshes,
+    which the element-wise velocity then keeps exact.
+
+    Parameters
+    ----------
+    model : str
+        ``.npz`` of the velocity window.
+    offset : float
+        Position of Marmousi2 subtracted from ``x`` (km).
+
+    Returns
+    -------
+    VelocityGrid
+        ``velocity(z, x)``.
+    """
+    grid = velocity_from_npz(model, offset)
+    return VelocityGrid(grid.values, grid.z0, grid.x0, grid.dz, grid.dx,
+                        fixed_layer=(SEA_FLOOR, WATER_VELOCITY))
+
+
+def reflection_window(sources: list, receivers: list, frequency: float,
+                      delay_after: float) -> Callable[[np.ndarray, int], np.ndarray] | None:
+    """Window of the traces after the sea-floor reflection, as in the mesh tests.
+
+    The direct wave and the sea-floor reflection depend only on the water,
+    which is known; the reflections of the sediment come after them.
+
+    Parameters
+    ----------
+    sources, receivers : list
+        Positions ``(z, x)`` (km).
+    frequency : float
+        Peak frequency of the Ricker wavelet (Hz), which sets its delay.
+    delay_after : float
+        Start of the window after the arrival of the sea-floor reflection
+        (s). Negative: no window.
+
+    Returns
+    -------
+    callable or None
+        ``window(times, shot)``, boolean ``(n_times, n_receivers)``; ``None``
+        for the full traces.
+    """
+    if delay_after < 0:
+        return None
+    wavelet_delay = 1.5 * np.sqrt(6.0) / (np.pi * frequency)
+    receiver_x = np.array([r[1] for r in receivers])
+    receiver_z = receivers[0][0]
+
+    def window(times: np.ndarray, shot: int) -> np.ndarray:
+        """Samples after the sea-floor reflection of the shot plus a delay.
+
+        Parameters
+        ----------
+        times : numpy.ndarray
+            Sample times (s).
+        shot : int
+            Source index.
+
+        Returns
+        -------
+        numpy.ndarray
+            Boolean ``(n_times, n_receivers)``.
+        """
+        source_z, source_x = sources[shot]
+        path = np.sqrt((receiver_x - source_x) ** 2
+                       + (2 * SEA_FLOOR - source_z - receiver_z) ** 2)
+        start = wavelet_delay + path / WATER_VELOCITY + delay_after
+        return np.asarray(times)[:, None] > start[None, :]
+
+    return window
+
+
+def model_dictionary(args: argparse.Namespace, domain: RectangularDomain,
