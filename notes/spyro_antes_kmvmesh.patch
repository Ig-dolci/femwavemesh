+"""Positive KMV face rules and the centred acoustic gradient.
+
+Notes
+-----
+AI assistance: Codex (OpenAI), tests of the approved optional NRBC.
+"""
+import numpy as np
+import pytest
+import firedrake as fire
+
+from spyro.domains.quadrature import kmv_edge_quadrature_rule
+from spyro.adaptivity import TraceOperator
+from spyro.adaptivity.fwi_functional import FWIFunctional, ParameterGrid, synthesize_observations
+from .test_mesh_adaptive_fwi import DOMAIN, cpw_mesh, dictionary, grid_positions, two_layer
+
+
+@pytest.mark.parametrize("degree", [1, 2, 3, 4, 5, 6])
+def test_kmv_face_rule_positive_and_polynomially_exact(degree: int) -> None:
+    """Integrate the polynomial moments independently of the wave solver.
+
+    Parameters
+    ----------
+    degree : int
+        Triangular KMV degree supported by the installed FIAT.
+
+    Returns
+    -------
+    None
+        Assert positive weights and the interpolation moments.
+    """
+    rule = kmv_edge_quadrature_rule(degree)
+    x, w = rule.point_set.points[:, 0], rule.weights
+    assert len(x) == degree + 1
+    assert np.all(w > 0.)
+    assert np.allclose(x + x[::-1], 1., atol=1e-14, rtol=0.)
+    for power in range(degree + 1):
+        assert np.dot(w, x**power) == pytest.approx(1. / (power + 1), abs=2e-14)
+
+
+def test_kmv4_face_rule_matches_analytic_weights() -> None:
+    """Check the independent five-point rule approved for the experiment.
+
+    Returns
+    -------
+    None
+        Assert node locations, weights and the extra symmetric moment.
+    """
+    rule = kmv_edge_quadrature_rule(4)
+    expected = [0., (1. - 1. / np.sqrt(3.)) / 2., .5,
+                (1. + 1. / np.sqrt(3.)) / 2., 1.]
+    assert np.allclose(rule.point_set.points[:, 0], expected, rtol=0., atol=1e-15)
+    assert np.allclose(rule.weights, [1/15, 3/10, 4/15, 3/10, 1/15], rtol=0., atol=1e-14)
+    assert np.dot(rule.weights, rule.point_set.points[:, 0]**5) == pytest.approx(1/6, abs=2e-14)
+
+
+@pytest.mark.parametrize("degree", [2, 4])
+def test_nodal_boundary_mass_is_diagonal_with_variable_velocity(degree: int) -> None:
+    """Check all face orientations with a nonconstant coefficient 1/c.
+
+    Parameters
+    ----------
+    degree : int
+        KMV degree of the scalar space.
+
+    Returns
+    -------
+    None
+        Assert the requested relative diagonality threshold.
+    """
+    mesh = fire.UnitSquareMesh(2, 3)
+    space = fire.FunctionSpace(mesh, "KMV", degree)
+    x = fire.SpatialCoordinate(mesh)
+    velocity = 2. + .2 * x[0] + .1 * x[1]
+    trial, test = fire.TrialFunction(space), fire.TestFunction(space)
+    form = trial * test / velocity * fire.ds(scheme=kmv_edge_quadrature_rule(degree))
+    matrix = fire.assemble(form, mat_type="aij").petscmat
+    ptr, columns, values = matrix.getValuesCSR()
+    rows = np.repeat(np.arange(len(ptr) - 1), np.diff(ptr))
+    assert not np.any((rows != columns) & (np.abs(values) > 1e-14 * np.max(np.abs(values))))
+
+
+@pytest.mark.parametrize("discontinuous", [False, True])
+def test_centred_nrbc_fwi_taylor(tmp_path, discontinuous: bool) -> None:
+    """Differentiate the velocity-dependent boundary term through UFL.
+
+    Parameters
+    ----------
+    tmp_path : pathlib.Path
+        Isolated directory for the test meshes.
+    discontinuous : bool
+        Use broken velocity coefficients when true.
+
+    Returns
+    -------
+    None
+        Assert a second-order Taylor remainder after boundary returns.
+    """
+    data = dictionary(final_time=.8)
+    data["absorving_boundary_conditions"]["nrbc"] = {"dt_scheme": "central"}
+    observed = synthesize_observations(data, two_layer, cpw_mesh(tmp_path / "observed.msh", 4.))
+    grid = ParameterGrid(DOMAIN, .05)
+    z, x = grid_positions(grid)
+    model = 1.5 + .8 * (z < -.35) + .1 * np.sin(6. * x)
+    functional = FWIFunctional(data, cpw_mesh(tmp_path / "inversion.msh", 3.), grid, model,
+                               observed, TraceOperator(), upper_bound=3.,
+                               discontinuous_velocity=discontinuous)
+    value = functional(grid.function(model))
+    gradient = functional.derivative_array()
+    direction = .2 * np.random.default_rng(3).standard_normal(grid.shape)
+    slope = np.sum(gradient * direction)
+    remainders = [abs(functional(grid.function(model + h * direction)) - value - h * slope)
+                  for h in (1e-2, 5e-3, 2.5e-3)]
+    assert np.all(np.log2(np.array(remainders[:-1]) / remainders[1:]) > 1.9)
