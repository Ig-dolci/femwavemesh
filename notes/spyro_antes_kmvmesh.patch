@@ -0,0 +1,356 @@
+"""Unified-rule invariants and density refresh; AI assistance: Codex/OpenAI."""
+
+from dataclasses import replace
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+import spyro.adaptivity.fwi_loop as loop
+from spyro.adaptivity import MeshAdaptiveFWI, MeshPolicy, ObservedData, ParameterGrid
+from spyro.adaptivity.fwi_loop import Audit
+from tests.on_one_core.test_mesh_adaptive_fwi import DOMAIN, RECEIVERS, dictionary, grid_positions
+
+
+@pytest.fixture
+def driver(tmp_path: Path) -> MeshAdaptiveFWI:
+    """Build a real driver without propagating a wave.
+
+    Parameters
+    ----------
+    tmp_path : pathlib.Path
+        Isolated output directory.
+
+    Returns
+    -------
+    MeshAdaptiveFWI
+        Two-source driver with the unified rule enabled.
+    """
+    grid = ParameterGrid(DOMAIN, .1)
+    z, x = grid_positions(grid)
+    model = 2. + .1 * x + .1 * z
+    observed = ObservedData([np.zeros((600, len(RECEIVERS)))] * 2, .001)
+    fwi = MeshAdaptiveFWI(dictionary(), DOMAIN, grid, model, observed, [],
+                          MeshPolicy(noise_level=.1, xi=None, unified_rule=True,
+                                     grid_spacing=.1), bounds=(1.4, 3.), output_dir=tmp_path)
+    fwi.mesh, fwi.dofs = tmp_path / "current.msh", 1000
+    return fwi
+
+
+def audit(ratio: float, dofs: int = 1000) -> Audit:
+    """Construct a two-source audit with a prescribed worst ratio.
+
+    Parameters
+    ----------
+    ratio : float
+        Worst data-error ratio.
+    dofs : int, optional
+        Mesh size.
+
+    Returns
+    -------
+    Audit
+        Audit with reliable relative pilot errors.
+    """
+    return Audit("current.msh", dofs, .001, 1., [ratio, .1], [10., 10.],
+                 [1., 1.], [.1, .1], [.1, .1], [.01, .01], [.1, .1],
+                 None, None, None, 0., pilot_relative_errors=[.1, .1])
+
+
+@pytest.mark.parametrize("strategy", ["cpw", "gradient", "adjoint"])
+def test_passing_mesh_is_kept_after_time_fix(
+        driver: MeshAdaptiveFWI, monkeypatch: pytest.MonkeyPatch, strategy: str) -> None:
+    """A time-step correction can accept the existing mesh without a design.
+
+    Parameters
+    ----------
+    driver : MeshAdaptiveFWI
+        Real driver fixture.
+    monkeypatch : pytest.MonkeyPatch
+        Replaces propagation and asserts no new design occurs.
+    strategy : str
+        Mesh strategy under test.
+
+    Returns
+    -------
+    None
+        Asserts preservation of the exact mesh and its acceptance event.
+    """
+    driver.policy = replace(driver.policy, strategy=strategy)
+    mesh = driver.mesh
+    failed, fixed = audit(2.), audit(.5)
+    failed.work = fixed.work = 13.
+    monkeypatch.setattr(driver, "_audit", lambda *a, **kw: failed)
+    monkeypatch.setattr(driver, "_fix_time_error", lambda *a: fixed)
+    monkeypatch.setattr(driver, "_verified_mesh", lambda *a: pytest.fail("passing mesh redesigned"))
+    assert driver._start_stage(loop.TraceOperator(), 5.)
+    assert driver.mesh is mesh
+    assert driver.report["events"][-1]["event"] == "stage_current_mesh_accepted"
+    assert sum(event.get("work", 0) for event in driver.report["events"]) == 13.
+
+
+@pytest.mark.parametrize("strategy", ["cpw", "gradient", "adjoint"])
+def test_size_field_uses_current_mesh_and_never_coarsens(
+        driver: MeshAdaptiveFWI, monkeypatch: pytest.MonkeyPatch, strategy: str) -> None:
+    """Check the generated size field at every design-grid location.
+
+    Parameters
+    ----------
+    driver : MeshAdaptiveFWI
+        Real driver fixture.
+    monkeypatch : pytest.MonkeyPatch
+        Observes the actual field handed to the mesher.
+    strategy : str
+        Mesh strategy under test.
+
+    Returns
+    -------
+    None
+        Verifies current-size input and both local upper bounds.
+    """
+    driver.policy = replace(driver.policy, strategy=strategy)
+    current = .08 + .02 * np.sin(driver._X) ** 2
+    cap = current * np.where(driver._X > .6, .9, 1.)
+    driver._design = {"density": 1 + driver._X ** 2,
+                      "size": 10 * current, "calibration": 1.}
+    captured, references = [], []
+    original = loop.AdaptiveSizeField
+
+    def field(density: np.ndarray, size: np.ndarray, *args: object,
+              **kwargs: object) -> object:
+        """Record the size reference and use the production size law.
+
+        Parameters
+        ----------
+        density, size : numpy.ndarray
+            Actual density and reference size.
+        *args, **kwargs : object
+            Remaining production constructor arguments.
+
+        Returns
+        -------
+        AdaptiveSizeField
+            Real production field.
+        """
+        references.append(size.copy())
+        return original(density, size, *args, **kwargs)
+
+    monkeypatch.setattr(driver, "_mesh_size", lambda path: (current, 1000))
+    monkeypatch.setattr(driver, "_equivalent_cpw", lambda *a: 4.)
+    monkeypatch.setattr(loop, "AdaptiveSizeField", field)
+    monkeypatch.setattr(loop, "generate_mesh", lambda path, domain, size, depths:
+                        captured.append(size(driver._Z, driver._X)))
+    monkeypatch.setattr(loop, "read_triangulation", lambda path: (None, None))
+    monkeypatch.setattr(loop, "count_kmv_dofs", lambda *a: 1500)
+    driver._designed_mesh("refine", 1500, 5., cap)
+    assert captured and all(np.all(h <= cap * (1 + 1e-14)) for h in captured)
+    assert all(np.all(h <= current * (1 + 1e-14)) for h in captured)
+    if strategy != "cpw":
+        np.testing.assert_array_equal(references[0], current)
+
+
+@pytest.mark.parametrize("power", [.5, 1.8, 5.5, 6.])
+def test_rate_matches_article_rule(driver: MeshAdaptiveFWI, power: float) -> None:
+    """Match the article's two-mesh formula on an exact power law.
+
+    Parameters
+    ----------
+    driver : MeshAdaptiveFWI
+        Driver fixture.
+    power : float
+        Synthetic spatial order.
+
+    Returns
+    -------
+    None
+        Asserts measured order and predicted clipped growth.
+    """
+    # At the lower admissible boundary, use an exact power-of-two error
+    # ratio; a rounded value just below 0.5 correctly uses the fallback.
+    n1 = 16000 if power == .5 else 2000
+    history = [(1000, 2.), (n1, 2. / (n1 / 1000) ** (power / 2))]
+    measured = driver._measured_rate(history)
+    assert measured == pytest.approx(power, abs=1e-14)
+    expected = np.clip((history[-1][1] / driver.policy.theta) ** (2 / measured), 1.15, 4.)
+    assert driver._growth(audit(history[-1][1], n1), 1.15, history) == pytest.approx(expected)
+
+
+@pytest.mark.parametrize("history", [
+    [(1000, 1.)], [(1000, 1.), (1000, .5)],
+    [(1000, 1.), (2000, 2.)], [(1000, 1.), (2000, .01)]])
+def test_invalid_rate_uses_fallback(driver: MeshAdaptiveFWI, history: list) -> None:
+    """Reject nonconvergent or out-of-range measured rates.
+
+    Parameters
+    ----------
+    driver : MeshAdaptiveFWI
+        Driver fixture.
+    history : list
+        Invalid order observations.
+
+    Returns
+    -------
+    None
+        Asserts the declared fallback, without changing it.
+    """
+    assert driver._measured_rate(history) == driver.policy.rate
+
+
+def test_gradient_refresh_uses_current_model(driver: MeshAdaptiveFWI,
+                                             monkeypatch: pytest.MonkeyPatch) -> None:
+    """A changed current model changes the recomputed gradient density.
+
+    Parameters
+    ----------
+    driver : MeshAdaptiveFWI
+        Driver fixture.
+    monkeypatch : pytest.MonkeyPatch
+        Supplies the current measured mesh size.
+
+    Returns
+    -------
+    None
+        Checks density provenance before two successive refinements.
+    """
+    driver.policy = replace(driver.policy, strategy="gradient")
+    monkeypatch.setattr(driver, "_mesh_size", lambda path: (np.full_like(driver._X, .1), 1000))
+    driver._refresh_unified_design(audit(2), loop.TraceOperator(), 5.)
+    before = driver._design["density"].copy()
+    z, x = grid_positions(driver.grid)
+    driver.model += .4 * np.exp(-((x - .6) ** 2 + (z + .5) ** 2) / .02)
+    driver._refresh_unified_design(audit(2), loop.TraceOperator(), 5.)
+    assert not np.allclose(before, driver._design["density"])
+    assert driver.report["events"][-2]["density_sha256"] != driver.report["events"][-1]["density_sha256"]
+
+
+def test_adjoint_refresh_selects_sources_on_each_current_mesh(
+        driver: MeshAdaptiveFWI, monkeypatch: pytest.MonkeyPatch) -> None:
+    """Refresh a mesh-dependent DWR density and skip passing sources.
+
+    Parameters
+    ----------
+    driver : MeshAdaptiveFWI
+        Adjoint driver fixture.
+    monkeypatch : pytest.MonkeyPatch
+        Supplies two distinct, source-local indicator fields.
+
+    Returns
+    -------
+    None
+        Asserts refreshed mesh, selected sources and distinct density hashes.
+    """
+    seen = []
+    monkeypatch.setattr(driver, "_mesh_size", lambda path: (np.full_like(driver._X, .1), 1000))
+    monkeypatch.setattr(driver, "_pilot_relative_errors", lambda *a: [.2, .1])
+
+    def pilot(mesh: str, **kwargs: object) -> object:
+        """Return an indicator located differently on each current mesh.
+
+        Parameters
+        ----------
+        mesh : str
+            Current mesh path.
+        **kwargs : object
+            Actual pilot options.
+
+        Returns
+        -------
+        SimpleNamespace
+            Distinct localized indicators with production-compatible metadata.
+        """
+        seen.append((mesh, kwargs["indicator_shots"]))
+        indicators = np.array([[1., 0.], [0., 0.]])
+        if len(seen) == 2:
+            indicators = indicators[:, ::-1]
+        return SimpleNamespace(centroids=np.array([[-.4, .4], [-.6, .8]]),
+                               indicators=indicators, dofs_coarse=1000,
+                               dofs_fine=4000, steps=10, trace_errors={0: .2, 1: .1},
+                               repeated_shots=[], adjoint_shots=[0])
+
+    monkeypatch.setattr(driver.pilot, "run", pilot)
+    driver._refresh_unified_design(audit(2), loop.TraceOperator(), 5.)
+    driver.mesh = driver.mesh.with_name("refined.msh")
+    driver._refresh_unified_design(audit(2), loop.TraceOperator(), 5.)
+    assert seen[0][0] != seen[1][0] and seen[0][1] == seen[1][1] == [0]
+    assert driver.report["events"][-2]["density_sha256"] != driver.report["events"][-1]["density_sha256"]
+
+
+@pytest.mark.parametrize("prediction_only", [False, True])
+@pytest.mark.parametrize("predicted", [.5, 1.5])
+def test_prediction_only_audit_trigger(
+        driver: MeshAdaptiveFWI, monkeypatch: pytest.MonkeyPatch,
+        prediction_only: bool, predicted: float) -> None:
+    """Suppress periodic audits while preserving predicted-error triggers.
+
+    Parameters
+    ----------
+    driver : MeshAdaptiveFWI
+        Real driver fixture.
+    monkeypatch : pytest.MonkeyPatch
+        Runs a single accepted optimizer iterate without solving a wave.
+    prediction_only : bool
+        Separate audit policy switch, independent of the unified mesh rule.
+    predicted : float
+        Predicted error ratio.
+
+    Returns
+    -------
+    None
+        Checks the actual TAO monitor's decision to run an audit.
+    """
+    driver.policy = replace(driver.policy, unified_rule=False, audit_every=1,
+                            audit_only_on_prediction=prediction_only)
+    control = driver.grid.function(driver.model)
+    functional = SimpleNamespace(controls=[SimpleNamespace(update=lambda model: None)],
+                                 forwards=0, adjoints=0, dofs=1000, dt=.001, steps=600)
+    seen = []
+    monkeypatch.setattr(driver, "_functional", lambda *a: functional)
+    monkeypatch.setattr(driver, "_predicted_ratio", lambda *a: predicted)
+    monkeypatch.setattr(driver, "_save_model", lambda *a: None)
+    monkeypatch.setattr(driver, "_audit", lambda *a: seen.append(True) or audit(.5))
+
+    def minimize(*args: object, **kwargs: object) -> list:
+        """Exercise the production monitor on one accepted iterate.
+
+        Parameters
+        ----------
+        *args, **kwargs : object
+            Production optimizer arguments, including its monitor.
+
+        Returns
+        -------
+        list
+            Unchanged control, as returned by TAO.
+        """
+        assert not kwargs["record"](1, 1., [control], 1.)
+        return [control]
+
+    monkeypatch.setattr(loop, "minimize_with_tao", minimize)
+    driver._optimize(0, loop.TraceOperator(), 3, True)
+    assert len(seen) == int(predicted > 1. or not prediction_only)
+
