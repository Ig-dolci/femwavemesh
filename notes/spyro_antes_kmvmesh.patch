@@ -0,0 +1,646 @@
+"""Mesh-adaptive acoustic FWI of the circle of Firedrake's FWI demo.
+
+The problem of Firedrake's demo ``demos/full_waveform_inversion``: a 1 km x
+1 km square, absorbing on its four sides (first-order condition
+:math:`(1/c)\\,\\partial_t u` on the boundary, as in the demo); the true model
+is a disc of 2.0 km/s and radius 0.125 km centred in the square, in a
+1.5 km/s background (the demo's ``1.75 + 0.25 tanh(200 (0.125 - r))``); the
+starting model is 1.5 km/s everywhere, and the bounds are 1.5 and 2.0 km/s.
+Three sources on a line 0.1 km from one side, twenty receivers on a line
+0.1 km from the opposite side, a 7 Hz Ricker wavelet (delay 1.5 times the
+minimum, as in the demo) and 1 s of propagation.
+
+Positions follow spyro: ``(z, x)``, ``z`` from -1 to 0. The demo's vertical
+coordinate ``y`` becomes ``z = -y``, so its sources at ``y = 0.1`` are at
+``z = -0.1`` and its receivers at ``y = 0.9`` at ``z = -0.9``.
+
+The observed data are computed on a uniform mesh like the demo's, a
+structured square of right triangles (written as ``<data>.msh``), with the
+true model sampled at the nodes. The demo has 80 x 80 squares with KMV1
+(6 561 degrees of freedom); here the elements are the KMV4 of the inversion
+(``--degree``), so the mesh has 25 x 25 squares (13 951 degrees of freedom;
+``--data-cells``). The time step is half the critical one of that mesh, and
+the records are resampled at the demo's 2 ms.
+
+The control is a Q1 grid of 12.5 mm (81 x 81 values: the nodes of the demo's
+P1 control). The misfit uses the full traces, with no gradient mask.
+
+The shots run in parallel, as in the demo: a ``firedrake.Ensemble`` with one
+member per group of shots, each on ``--spatial`` processes (one by default),
+so ``mpiexec -n 3`` runs the three shots at once. The pilots and the audits
+of the meshes share the shots in the same way, and the misfit is an
+``EnsembleReducedFunctional`` of the UFL-derived adjoint
+(:class:`~spyro.adaptivity.fwi_functional.EnsembleFWIFunctional`).
+
+Besides the cpw, gradient and adjoint designs (``--strategy``, with or
+without ``--fixed-mesh``), ``--strategy uniform`` inverts on a uniform mesh
+of ``--uniform-cells`` squares a side, without designing or auditing a mesh:
+by default the mesh of the data itself.
+
+Two steps, one case at a time::
+
+    mpiexec -n 3 python circle_fwi.py --prepare --data data_circle.npz
+    mpiexec -n 3 python circle_fwi.py --data data_circle.npz \\
+        --strategy adjoint --output results/adjoint_update
+
+AI assistance: implementation by Claude (Anthropic), reviewed by the author.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import time
+from pathlib import Path
+
+import firedrake as fire
+import numpy as np
+from scipy.interpolate import CubicSpline
+
+import meshio
+
+from spyro.adaptivity import (EnsembleFWIFunctional, FWIFunctional,
+                              MeshAdaptiveFWI, MeshPolicy, ObservedData,
+                              ParameterGrid, RectangularDomain, Stage,
+                              TraceOperator, TwoLevelPilot, VelocityGrid)
+from spyro.adaptivity.mesh_generation import BOTTOM, TOP, X_MAX, X_MIN
+from spyro.adaptivity.paraview import write_pvd, write_vti
+from spyro.tools.optimization import minimize_with_tao
+
+BACKGROUND = 1.5
+DISC = 2.0
+RADIUS = 0.125
+CENTRE = (-0.5, 0.5)
+SHARPNESS = 200.0
+DEMO_CELLS = 80
+DATA_CELLS = 25
+DEMO_DT = 0.002
+TAO_OPTIONS = {"tao_gatol": 1e-14, "tao_grtol": 0.0, "tao_gttol": 0.0}
+SOURCES = [(-0.1, x) for x in np.linspace(0.3, 0.7, 3)]
+RECEIVERS = [(-0.9, x) for x in np.linspace(0.2, 0.8, 20)]
+
+
+def parse_arguments() -> argparse.Namespace:
+    """Read the command line.
+
+    Returns
+    -------
+    argparse.Namespace
+        The parsed arguments.
+    """
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    parser.add_argument("--data", required=True,
+                        help="observed data (.npz), written by --prepare")
+    parser.add_argument("--prepare", action="store_true",
+                        help="propagate the observed data and stop")
+    parser.add_argument("--output", help="directory of the case")
+    parser.add_argument("--strategy",
+                        choices=["cpw", "gradient", "adjoint", "uniform"],
+                        default="adjoint",
+                        help="mesh design; 'uniform' inverts on the mesh of "
+                             "the data")
+    parser.add_argument("--fixed-mesh", action="store_true",
+                        help="keep the mesh verified at the starting model "
+                             "during the iterations")
+    parser.add_argument("--iterations", type=int, default=30)
+    parser.add_argument("--frequency", type=float, default=7.0, help="Hz")
+    parser.add_argument("--final-time", type=float, default=1.0, help="s")
+    parser.add_argument("--degree", type=int, default=4, help="KMV degree")
+    parser.add_argument("--grid-spacing", type=float, default=1.0 / DEMO_CELLS,
+                        help="km, parameter grid")
+    parser.add_argument("--noise-fraction", type=float, default=0.05,
+                        help="noise level of each shot, relative to the norm "
+                             "of its observed data")
+    parser.add_argument("--noise-seed", type=int,
+                        help="add white Gaussian noise of norm --noise-fraction "
+                             "of each shot, from this seed (the same seed "
+                             "gives the same noise to every case); without "
+                             "it the data are noise-free and the noise level "
+                             "is only a declared floor")
+    parser.add_argument("--discrepancy", type=float,
+                        help="stop when the residual falls to this factor of "
+                             "the noise plus the modelling error")
+    parser.add_argument("--xi", type=float, default=0.5,
+                        help="gradient-error tolerance; negative drops the "
+                             "gradient criterion")
+    parser.add_argument("--restarts", type=int, nargs="*", default=[],
+                        help="iterations at which TAO restarts on the same "
+                             "mesh (control of the quasi-Newton restarts)")
+    parser.add_argument("--dt-fraction", type=float, default=0.7,
+                        help="fraction of the critical time step at the "
+                             "upper bound")
+    parser.add_argument("--audit-every", type=int, default=8)
+    parser.add_argument("--max-dofs", type=int, default=30000)
+    parser.add_argument("--data-cells", type=int, default=DATA_CELLS,
+                        help="squares a side of the uniform mesh of the data")
+    parser.add_argument("--uniform-cells", type=int,
+                        help="squares a side of the mesh of --strategy uniform "
+                             "(default: the mesh of the data)")
+    parser.add_argument("--spatial", type=int, default=1,
+                        help="processes of each ensemble member (each shot)")
+    return parser.parse_args()
+
+
+def shot_ensemble(args: argparse.Namespace) -> fire.Ensemble:
+    """Ensemble of the shots.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+
+    Returns
+    -------
+    firedrake.Ensemble
+        Members of ``--spatial`` processes each; their number must divide the
+        number of shots.
+    """
+    if fire.COMM_WORLD.size % args.spatial:
+        raise SystemExit("The number of processes must be a multiple of --spatial.")
+    return fire.Ensemble(fire.COMM_WORLD, args.spatial)
+
+
+def geometry() -> tuple[RectangularDomain, list, list]:
+    """Domain and acquisition of the demo, in spyro's ``(z, x)``.
+
+    Returns
+    -------
+    tuple
+        The unit square without a pad, the sources and the receivers.
+    """
+    return (RectangularDomain(z_min=-1.0, x_min=0.0, x_max=1.0),
+            list(SOURCES), list(RECEIVERS))
+
+
+def true_velocity(spacing: float = 0.00125) -> VelocityGrid:
+    """The disc of the demo on a fine grid.
+
+    Parameters
+    ----------
+    spacing : float, optional
+        Grid spacing (km), much finer than the 5 m transition of the disc.
+
+    Returns
+    -------
+    VelocityGrid
+        ``1.75 + 0.25 tanh(200 (0.125 - r))``.
+    """
+    z, x = RectangularDomain(z_min=-1.0, x_min=0.0, x_max=1.0).grid(spacing)
+    Z, X = np.meshgrid(z, x, indexing="ij")
+    r = np.hypot(Z - CENTRE[0], X - CENTRE[1])
+    values = 0.5 * (DISC + BACKGROUND) + 0.5 * (DISC - BACKGROUND) * np.tanh(
+        SHARPNESS * (RADIUS - r))
+    return VelocityGrid(values, z[0], x[0], spacing, spacing)
+
+
+def model_dictionary(args: argparse.Namespace, domain: RectangularDomain) -> dict:
+    """spyro dictionary of the problem.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+    domain : RectangularDomain
+        The square.
+
+    Returns
+    -------
+    dict
+        KMV triangles, first-order absorbing condition on the four sides.
+    """
+    return {
+        "options": {"cell_type": "T", "variant": "lumped",
+                    "degree": args.degree, "dimension": 2},
+        "parallelism": {"type": "spatial"},
+        "mesh": {"length_z": -domain.z_min, "length_x": domain.x_max,
+                 "length_y": 0.0, "mesh_type": "user_mesh"},
+        "acquisition": {"source_type": "ricker", "source_locations": SOURCES,
+                        "frequency": args.frequency, "delay": 1.5,
+                        "delay_type": "multiples_of_minimum",
+                        "receiver_locations": RECEIVERS},
+        "absorving_boundary_conditions": {
+            "status": True, "abc_type": "nrbc", "free_surface": False,
+            "absorb_top": True, "damping_layer": None},
+        "time_axis": {"initial_time": 0.0, "final_time": args.final_time,
+                      "dt": 1e-4, "amplitude": 1, "output_frequency": 10**9,
+                      "gradient_sampling_frequency": 1},
+        "visualization": {"forward_output": False, "forward_output_filename": None,
+                          "fwi_velocity_model_output": False,
+                          "velocity_model_filename": None, "gradient_output": False,
+                          "gradient_filename": None, "adjoint_output": False,
+                          "adjoint_filename": None, "debug_output": False},
+    }
+
+
+def write_demo_mesh(path: Path, cells: int = DATA_CELLS) -> Path:
+    """Write a uniform mesh like the demo's, in spyro's coordinates.
+
+    Parameters
+    ----------
+    path : pathlib.Path
+        Gmsh file to write (format 2.2).
+    cells : int, optional
+        Squares a side. Default: 25, the mesh of the data.
+
+    Returns
+    -------
+    pathlib.Path
+        The file: ``cells`` x ``cells`` squares of ``[-1, 0] x [0, 1]``, each
+        split into two right triangles, with the sides marked as the meshes
+        of :func:`~spyro.adaptivity.generate_mesh` (all absorbing here).
+    """
+    n = cells
+    z, x = np.meshgrid(np.linspace(-1.0, 0.0, n + 1), np.linspace(0.0, 1.0, n + 1),
+                       indexing="ij")
+    points = np.column_stack([z.ravel(), x.ravel(), np.zeros(z.size)])
+    node = np.arange(z.size).reshape(n + 1, n + 1)
+    a, b = node[:-1, :-1].ravel(), node[:-1, 1:].ravel()
+    c, d = node[1:, :-1].ravel(), node[1:, 1:].ravel()
+    triangles = np.vstack([np.column_stack([a, b, d]), np.column_stack([a, d, c])])
+    sides = {TOP: (node[-1, :-1], node[-1, 1:]), BOTTOM: (node[0, :-1], node[0, 1:]),
+             X_MIN: (node[:-1, 0], node[1:, 0]), X_MAX: (node[:-1, -1], node[1:, -1])}
+    lines = np.vstack([np.column_stack(ends) for ends in sides.values()])
+    line_tags = np.concatenate([np.full(n, tag) for tag in sides])
+    tags = [line_tags, np.ones(len(triangles), dtype=int)]
+    meshio.write(path, meshio.Mesh(
+        points, [("line", lines), ("triangle", triangles)],
+        cell_data={"gmsh:physical": tags, "gmsh:geometrical": tags}),
+        file_format="gmsh22", binary=False)
+    return path
+
+
+def grid_models(args: argparse.Namespace, domain: RectangularDomain,
+                comm: fire.MPI.Comm) -> tuple[ParameterGrid, np.ndarray, np.ndarray]:
+    """Parameter grid with the true and starting models on it.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+    domain : RectangularDomain
+        The square.
+    comm : mpi4py.MPI.Comm
+        Communicator of the grid, the spatial one of the ensemble member.
+
+    Returns
+    -------
+    tuple
+        The grid, the true model and the starting model on it.
+    """
+    grid = ParameterGrid(domain, args.grid_spacing, "Q1", comm=comm)
+    z = grid.origin[0] + grid.dz * np.arange(grid.shape[0])
+    x = grid.origin[1] + grid.dx * np.arange(grid.shape[1])
+    Z, X = np.meshgrid(z, x, indexing="ij")
+    return grid, true_velocity()(Z, X), np.full(grid.shape, BACKGROUND)
+
+
+def prepare(args: argparse.Namespace) -> None:
+    """Propagate the observed data on the uniform mesh of the demo.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+
+    Returns
+    -------
+    None
+        The data are written to ``--data``.
+    """
+    domain, _, _ = geometry()
+    ensemble = shot_ensemble(args)
+    pilot = TwoLevelPilot(model_dictionary(args, domain), true_velocity(),
+                          ensemble=ensemble)
+    data = Path(args.data)
+    data.parent.mkdir(parents=True, exist_ok=True)
+    if fire.COMM_WORLD.rank == 0:
+        write_demo_mesh(data.with_suffix(".msh"), args.data_cells)
+    fire.COMM_WORLD.barrier()
+    mesh = pilot.load_meshes(str(data.with_suffix(".msh")))[0]
+    dt = 0.5 * pilot.critical_time_step(mesh)
+    samples = int(round(args.final_time / DEMO_DT))
+    target = (np.arange(samples) + 1) * DEMO_DT
+    start = time.perf_counter()
+    records = []
+    for record in pilot.shot_records(mesh, dt).values():
+        # Sample n of a spyro record is at time (n + 1) dt.
+        times = (np.arange(len(record)) + 1) * dt
+        records.append(CubicSpline(times, record, axis=0)(
+            np.clip(target, times[0], times[-1])))
+    elapsed = time.perf_counter() - start
+    if fire.COMM_WORLD.rank != 0:
+        return
+    np.savez(data, records=np.array(records), dt=DEMO_DT, frequency=args.frequency,
+             final_time=args.final_time, degree=args.degree,
+             mesh=str(data.with_suffix(".msh")),
+             fine_dt=dt)
+    print(f"[prepare] {data}: dt {dt:.3e} s, {len(SOURCES)} shots in "
+          f"{elapsed:.0f} s, resampled at {DEMO_DT} s", flush=True)
+
+
+def invert_on_data_mesh(args: argparse.Namespace, grid: ParameterGrid,
+                        initial_model: np.ndarray, observed: ObservedData,
+                        ensemble: fire.Ensemble, output: Path,
+                        noise_levels: list[float]) -> tuple[dict, np.ndarray]:
+    """Run TAO on the uniform mesh of the data, with no mesh design.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+    grid : ParameterGrid
+        Parameter grid, on the spatial communicator of the ensemble.
+    initial_model : numpy.ndarray
+        Starting model on the grid.
+    observed : ObservedData
+        Observed records.
+    ensemble : firedrake.Ensemble
+        Ensemble of the shots.
+    output : pathlib.Path
+        Directory of the case.
+    noise_levels : list of float
+        Noise level of each shot: with ``--discrepancy`` the inversion stops
+        when :math:`\\sqrt{2J}` falls to that factor of their norm (no
+        modelling error is estimated on this mesh).
+
+    Returns
+    -------
+    tuple
+        The report (``report_fwi.json``, with the same ``history`` and
+        ``events`` as the adaptive cases) and the final model.
+    """
+    # The mesh of the data, or a coarser uniform one (--uniform-cells).
+    domain, _, _ = geometry()
+    if args.uniform_cells is None:
+        mesh = Path(args.data).with_suffix(".msh")
+    else:
+        mesh = output / "meshes" / f"uniform_{args.uniform_cells}.msh"
+        if fire.COMM_WORLD.rank == 0:
+            mesh.parent.mkdir(parents=True, exist_ok=True)
+            write_demo_mesh(mesh, args.uniform_cells)
+        fire.COMM_WORLD.barrier()
+    local = FWIFunctional(model_dictionary(args, domain), str(mesh), grid,
+                          initial_model, observed, TraceOperator(), DISC,
+                          dt_fraction=args.dt_fraction, ensemble=ensemble)
+    functional = EnsembleFWIFunctional(local, ensemble)
+    root = fire.COMM_WORLD.rank == 0
+    start = time.perf_counter()
+    report = {"case": "inversion on the mesh of the data", "events": [],
+              "history": []}
+    models = []
+
+    def save(iteration: int, model: np.ndarray) -> None:
+        """Write a model and the report, as the adaptive loop does.
+
+        Parameters
+        ----------
+        iteration : int
+            Iteration; 0 is the starting model.
+        model : numpy.ndarray
+            Model on the grid.
+
+        Returns
+        -------
+        None
+            The files are written by the first process.
+        """
+        if not root:
+            return
+        output.mkdir(parents=True, exist_ok=True)
+        np.save(output / f"model_iter{iteration:03d}.npy", model)
+        image = write_vti(output / "models" / f"model_iter{iteration:03d}.vti",
+                          grid, model)
+        models.append((iteration, image.relative_to(output)))
+        write_pvd(output / "models.pvd", models)
+        (output / "report_fwi.json").write_text(json.dumps(report, indent=1))
+
+    def record(iteration: int, value: float, controls: list,
+               gradient_norm: float) -> bool:
+        """Keep each accepted iterate.
+
+        Parameters
+        ----------
+        iteration : int
+            TAO iteration.
+        value : float
+            Functional at the iterate.
+        controls : list of firedrake.Function
+            The iterate.
+        gradient_norm : float
+            TAO's norm of the projected gradient at the iterate.
+
+        Returns
+        -------
+        bool
+            Whether the residual reached the discrepancy level.
+        """
+        elapsed = time.perf_counter() - start
+        report["history"].append({"iteration": iteration, "stage": 0,
+                                  "mesh": mesh.name, "dofs": functional.dofs,
+                                  "J": float(value),
+                                  "gradient_norm": float(gradient_norm)})
+        report["events"].append({"event": "iterate", "elapsed_s": round(elapsed, 1),
+                                 "iteration": iteration, "J": float(value)})
+        save(iteration, grid.to_array(controls[0]))
+        stop = (args.discrepancy is not None and np.sqrt(2.0 * value)
+                <= args.discrepancy * np.linalg.norm(noise_levels))
+        if stop:
+            report["events"].append({"event": "discrepancy",
+                                     "elapsed_s": round(elapsed, 1),
+                                     "iteration": iteration})
+        return stop
+
+    save(0, initial_model)
+    report["events"].append({"event": "tao_start", "elapsed_s": 0.0,
+                             "mesh": mesh.name, "dofs": functional.dofs,
+                             "dt": functional.dt, "steps": functional.steps})
+    # TAO restarts at --restarts, as the mesh changes of an adaptive case do.
+    model, done = initial_model, 0
+    for stop in sorted(set(args.restarts) | {args.iterations}):
+        if stop <= done:
+            continue
+        if done:
+            report["events"].append({
+                "event": "tao_start", "elapsed_s": round(time.perf_counter() - start, 1),
+                "mesh": mesh.name, "dofs": functional.dofs, "dt": functional.dt,
+                "steps": functional.steps})
+        offset = done
+        solution = minimize_with_tao(
+            functional, bounds=[(BACKGROUND, DISC)], comm=grid.comm,
+            options={**TAO_OPTIONS, "tao_max_it": stop - done},
+            record=lambda it, value, controls, norm, offset=offset: record(
+                offset + it, value, controls, norm))
+        model = grid.to_array(solution[0])
+        done = len(report["history"])
+        if done < stop or report["events"][-1]["event"] == "discrepancy":
+            break
+        # The next solve starts from the control of the functional.
+        local.controls[0].update(grid.function(model))
+    final_model = model
+    forwards, adjoints = functional.forwards, functional.adjoints
+    report["elapsed_s"] = time.perf_counter() - start
+    report["events"].append({
+        "event": "end", "elapsed_s": round(report["elapsed_s"], 1),
+        "forwards": forwards, "adjoints": adjoints,
+        "work": (forwards + adjoints) * functional.dofs * functional.steps})
+    if root:
+        np.save(output / "model_stage0.npy", final_model)
+    if root:
+        (output / "report_fwi.json").write_text(json.dumps(report, indent=1))
+    return report, final_model
+
+
+def bandlimited_model(model: np.ndarray, spacing: float, wavelength: float
+                      ) -> np.ndarray:
+    """The part of a model the data can resolve.
+
+    The spectrum of the model is cut at the wavenumber :math:`2/\\lambda`
+    (the reflection limit), so the error of the result against the model is
+    the floor of any inversion of the band.
+
+    Parameters
+    ----------
+    model : numpy.ndarray
+        Model on the grid.
+    spacing : float
+        Grid spacing (km).
+    wavelength : float
+        Wavelength at the peak frequency in the background (km).
+
+    Returns
+    -------
+    numpy.ndarray
+        The band-limited model, of the shape of ``model``.
+    """
+    spectrum = np.fft.fft2(model - BACKGROUND)
+    kz = np.fft.fftfreq(model.shape[0], spacing)
+    kx = np.fft.fftfreq(model.shape[1], spacing)
+    keep = np.hypot(*np.meshgrid(kz, kx, indexing="ij")) <= 2.0 / wavelength
+    return BACKGROUND + np.real(np.fft.ifft2(spectrum * keep))
+
+
+def run_case(args: argparse.Namespace) -> None:
+    """Run the inversion of one case and write its summary.
+
+    Parameters
+    ----------
+    args : argparse.Namespace
+        Command-line settings.
+
+    Returns
+    -------
+    None
+        The results are written to ``--output``.
+    """
+    stored = np.load(args.data)
+    for name in ("frequency", "final_time", "degree"):
+        if float(stored[name]) != float(getattr(args, name)):
+            raise ValueError(f"--{name.replace('_', '-')} differs from the one "
+                             f"of {args.data}: prepare the data again.")
+    records = [np.array(record) for record in stored["records"]]
+    dt = float(stored["dt"])
+    norms = [TraceOperator.norm(record, dt) for record in records]
+    if args.noise_seed is not None:
+        # The same seed on every process and in every case: paired replicas.
+        rng = np.random.default_rng(args.noise_seed)
+        for record, norm in zip(records, norms):
+            noise = rng.standard_normal(record.shape)
+            record += args.noise_fraction * norm / TraceOperator.norm(noise, dt) * noise
+    observed = ObservedData(records, dt)
+    domain, _, _ = geometry()
+    ensemble = shot_ensemble(args)
+    grid, true_model, initial_model = grid_models(args, domain, ensemble.comm)
+    policy = MeshPolicy(
+        noise_level=[args.noise_fraction * norm for norm in norms],
+        xi=None if args.xi < 0 else args.xi,
+        strategy=args.strategy, update_during_iterations=not args.fixed_mesh,
+        audit_every=args.audit_every, max_dofs=args.max_dofs,
+        dt_fraction=args.dt_fraction, discrepancy=args.discrepancy,
+        restarts=tuple(args.restarts))
+    output = Path(args.output)
+    if args.strategy == "uniform":
+        report, final_model = invert_on_data_mesh(
+            args, grid, initial_model, observed, ensemble, output,
+            [args.noise_fraction * norm for norm in norms])
+    else:
+        fwi = MeshAdaptiveFWI(
+            model_dictionary(args, domain), domain, grid, initial_model, observed,
+            [Stage(args.iterations)], policy,
+            bounds=(np.full(grid.shape, BACKGROUND), np.full(grid.shape, DISC)),
+            output_dir=output, tao_options=TAO_OPTIONS, ensemble=ensemble)
+        report, final_model = fwi.run(), fwi.model
+
+    def model_error(model: np.ndarray) -> float:
+        """Root mean square error of a model over the square.
+
+        Parameters
+        ----------
+        model : numpy.ndarray
+            Model on the grid.
+
+        Returns
+        -------
+        float
+            Error (km/s).
+        """
+        return float(np.sqrt(np.mean((model - true_model) ** 2)))
+
+    z = grid.origin[0] + grid.dz * np.arange(grid.shape[0])
+    x = grid.origin[1] + grid.dx * np.arange(grid.shape[1])
+    Z, X = np.meshgrid(z, x, indexing="ij")
+    # The disc and its 5 m transition, with a margin of a grid cell or so.
+    inside = np.hypot(Z - CENTRE[0], X - CENTRE[1]) < RADIUS + 0.02
+    error = final_model - true_model
+    floor = model_error(bandlimited_model(
+        true_model, args.grid_spacing, 0.5 * (BACKGROUND + DISC) / args.frequency))
+    initial = model_error(initial_model)
+    final_audits = [e for e in report["events"] if e["event"] == "final_audit"]
+    events, history = report["events"], report["history"]
+    summary = {
+        "case": "circle of Firedrake's FWI demo",
+        "strategy": args.strategy, "update_during_iterations": not args.fixed_mesh,
+        "data": str(args.data), "data_mesh": str(stored["mesh"]),
+        "iterations": len(history),
+        "meshes_used": list(dict.fromkeys(h["mesh"] for h in history)),
+        "final_dofs": history[-1]["dofs"],
+        "J_first": history[0]["J"], "J_last": history[-1]["J"],
+        "model_rms_error_initial": model_error(initial_model),
+        "model_rms_error_final": model_error(final_model),
+        "model_rms_error_inside_disc": float(np.sqrt(np.mean(error[inside] ** 2))),
+        "model_rms_error_outside_disc": float(np.sqrt(np.mean(error[~inside] ** 2))),
+        "bandlimited_floor": floor,
+        "recoverable_gap_closed": (initial - model_error(final_model)) / (initial - floor),
+        "final_audit_E_over_tau": (final_audits[-1]["worst_E_over_tau"]
+                                   if final_audits else None),
+        "final_audit_worst_ratio": (final_audits[-1]["worst_ratio"]
+                                    if final_audits else None),
+        "tao_restarts": sum(e["event"] == "tao_start" for e in events),
+        "noise_seed": args.noise_seed, "noise_fraction": args.noise_fraction,
+        "work_dof_steps": sum(e.get("work", 0) + e.get("work_forwards", 0)
+                              + e.get("work_adjoint", 0) for e in events),
+        "elapsed_s": report["elapsed_s"]}
+    if fire.COMM_WORLD.rank == 0:
+        np.save(output / "model_true.npy", true_model)
+        np.save(output / "model_initial.npy", initial_model)
+        (output / "summary.json").write_text(json.dumps(summary, indent=1))
+        print("[summary] " + json.dumps(summary), flush=True)
+
+
+def main() -> None:
+    """Prepare the data or run one case.
+
+    Returns
+    -------
+    None
+        See :func:`prepare` and :func:`run_case`.
+    """
+    args = parse_arguments()
+    if args.prepare:
+        prepare(args)
+    elif args.output is None:
+        raise SystemExit("--output is required to run a case.")
+    else:
+        run_case(args)
+
+
+if __name__ == "__main__":
+    main()
