+"""Tests for the triangular cell material representation."""
+
+import firedrake as fire
+import numpy as np
+import pytest
+
+from spyro.adaptivity.pilot import (
+    Field,
+    broken_nodes,
+    broken_velocity,
+    cell_averaged_velocity,
+)
+
+
+@pytest.mark.parametrize("interface", [False, True], ids=["smooth", "conforming"])
+@pytest.mark.parametrize("elastic", [False, True], ids=["acoustic", "elastic"])
+def test_resolved_material_preserves_broken_interpolant(
+    interface: bool, elastic: bool,
+) -> None:
+    """Preserve the original interpolant where it resolves the model.
+
+    Parameters
+    ----------
+    interface : bool
+        Use a jump on the vertical cell edges instead of a smooth model.
+    elastic : bool
+        Use three material properties instead of the acoustic velocity alone.
+    """
+    mesh = fire.UnitSquareMesh(2, 2, comm=fire.COMM_SELF)
+    space = fire.FunctionSpace(mesh, "KMV", 4)
+
+    def velocity(z: np.ndarray, x: np.ndarray) -> np.ndarray:
+        """Evaluate the manufactured acoustic velocity.
+
+        Parameters
+        ----------
+        z, x : numpy.ndarray
+            Coordinates at which to evaluate the medium.
+
+        Returns
+        -------
+        numpy.ndarray
+            Velocity at each point.
+        """
+        if interface:
+            return np.where(z > 0.5, 2.0, 3.0)
+        return 2.0 + z + x * x
+
+    def shear(z: np.ndarray, x: np.ndarray) -> np.ndarray:
+        """Evaluate the manufactured shear velocity.
+
+        Parameters
+        ----------
+        z, x : numpy.ndarray
+            Point coordinates.
+
+        Returns
+        -------
+        numpy.ndarray
+            Shear velocity at each point.
+        """
+        return 0.5 * velocity(z, x)
+
+    material = ({"density": velocity, "p_wave_velocity": velocity, "s_wave_velocity": shear}
+                if elastic else {"velocity": velocity})
+    fields, counts = cell_averaged_velocity(space, material)
+    assert counts == (0, 8)
+    for name, sample in material.items():
+        np.testing.assert_array_equal(fields[name].dat.data_ro,
+                                      broken_velocity(space, sample).dat.data_ro)
+
+
+@pytest.mark.parametrize("elastic", [False, True], ids=["acoustic", "elastic"])
+def test_cut_cells_use_effective_material(elastic: bool) -> None:
+    """Check harmonic moduli for triangles bisected by an interface.
+
+    Parameters
+    ----------
+    elastic : bool
+        Test density and the two elastic speeds instead of acoustic speed.
+    """
+    # The line z+x=1 bisects both triangles of the first square. Repeating
+    # the mesh along z adds two triangles entirely in the high layer.
+    mesh = fire.RectangleMesh(2, 1, 2.0, 1.0, diagonal="right", comm=fire.COMM_SELF)
+    space = fire.FunctionSpace(mesh, "KMV", 4)
+    rho_low, rho_high = (2.0, 2.3) if elastic else (1.0, 1.0)
+    rho_mid = (rho_low + rho_high) / 2
+
+    def layer(low: float, high: float, midpoint: float) -> Field:
+        """Construct a sampled two layer property.
+
+        Parameters
+        ----------
+        low, high, midpoint : float
+            Values below, above and exactly on the interface.
+
+        Returns
+        -------
+        callable
+            Two layer material field.
+        """
+        def evaluate(z: np.ndarray, x: np.ndarray) -> np.ndarray:
+            """Evaluate the fixed interface.
+
+            Parameters
+            ----------
+            z, x : numpy.ndarray
+                Point coordinates.
+
+            Returns
+            -------
+            numpy.ndarray
+                Layer values at the points.
+            """
+            offset = z + x - 1.0
+            return np.where(np.abs(offset) < 1e-12, midpoint,
+                            np.where(offset < 0, low, high))
+
+        return evaluate
+
+    expected = {}
+    material = {}
+    if elastic:
+        material["density"] = layer(rho_low, rho_high, rho_mid)
+        expected["density"] = (rho_mid, rho_high)
+        speeds = {"p_wave_velocity": (2.0, 3.0), "s_wave_velocity": (1.0, 1.6)}
+    else:
+        speeds = {"velocity": (2.0, 3.0)}
+    for name, (low, high) in speeds.items():
+        compliance = (1 / (rho_low * low**2) + 1 / (rho_high * high**2)) / 2
+        speed = (rho_mid * compliance)**-0.5
+        material[name] = layer(low, high, speed)
+        expected[name] = (speed, high)
+
+    fields, counts = cell_averaged_velocity(space, material)
+    assert counts == (2, 4)
+    broken, points = broken_nodes(space)
+    nodes = broken.cell_node_map().values
+    cut = np.mean(points[nodes, 0], axis=1) < 1
+    for name, (averaged, unchanged) in expected.items():
+        actual = fields[name].dat.data_ro[nodes]
+        np.testing.assert_allclose(actual[cut], averaged, rtol=1e-12)
+        np.testing.assert_array_equal(actual[~cut], unchanged)
