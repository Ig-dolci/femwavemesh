@@ -0,0 +1,189 @@
+"""Table and figures of the cases of ``run_marmousi_fwi.sh``.
+
+Usage::
+
+    python compare_marmousi_cases.py <directory with one folder per case>
+
+Writes ``comparison.md``, ``comparison_models.png`` and
+``comparison_history.png`` in that directory. Cases without ``summary.json``
+(not finished) are left out.
+"""
+import json
+import sys
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+import numpy as np  # noqa: E402
+
+from marmousi_fwi import geometry  # noqa: E402
+
+CASES = [f"{strategy}_{mode}" for strategy in ("cpw", "gradient", "adjoint")
+         for mode in ("fixed", "update")]
+
+
+def load(root: Path) -> dict:
+    """Read the finished cases.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory with one folder per case.
+
+    Returns
+    -------
+    dict
+        By case: ``summary``, ``report`` and the ``true``, ``initial`` and
+        ``final`` models.
+    """
+    cases = {}
+    for name in CASES:
+        folder = root / name
+        if not (folder / "summary.json").exists():
+            continue
+        cases[name] = {
+            "summary": json.loads((folder / "summary.json").read_text()),
+            "report": json.loads((folder / "report_fwi.json").read_text()),
+            "true": np.load(folder / "model_true.npy"),
+            "initial": np.load(folder / "model_initial.npy"),
+            "final": np.load(folder / "model_stage0.npy")}
+    return cases
+
+
+def write_table(root: Path, cases: dict) -> Path:
+    """Write the table of the cases.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`load`.
+
+    Returns
+    -------
+    pathlib.Path
+        The Markdown file.
+    """
+    lines = [
+        "| case | iterations | meshes | final DOFs | J last / first | "
+        "model RMS error (km/s) | final E/tau | work (DOF-steps) | time (h) |",
+        "|---|---|---|---|---|---|---|---|---|"]
+    for name, case in cases.items():
+        s = case["summary"]
+        lines.append(
+            f"| {name} | {s['iterations']} | {len(s['meshes_used'])} | "
+            f"{s['final_dofs']} | "
+            f"{s['J_last'] / s['J_first']:.2e} | "
+            f"{s['model_rms_error_final']:.4f} (initial "
+            f"{s['model_rms_error_initial']:.4f}) | "
+            f"{s['final_audit_E_over_tau']:.2f} | {s['work_dof_steps']:.3g} | "
+            f"{s['elapsed_s'] / 3600:.2f} |")
+    lines += ["", "J last / first: misfit of the full traces on the mesh of "
+              "each iteration, last over first.",
+              "Final E/tau: two-level estimate of the mesh error of the last "
+              "mesh at the final model, over its tolerance (above 1 fails)."]
+    file = root / "comparison.md"
+    file.write_text("\n".join(lines) + "\n")
+    return file
+
+
+def plot_models(root: Path, cases: dict) -> Path:
+    """True, starting and final models of the cases.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`load`.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    domain, sources, _, _ = geometry()
+    extent = [domain.x_min, domain.x_max, domain.z_min, 0.0]
+    first = next(iter(cases.values()))
+    panels = [("true", first["true"]), ("initial", first["initial"])]
+    panels += [(name, case["final"]) for name, case in cases.items()]
+    columns = 2
+    rows = -(-len(panels) // columns)
+    fig, axes = plt.subplots(rows, columns, figsize=(11, 3.6 * rows),
+                             constrained_layout=True, squeeze=False)
+    limits = (first["true"].min(), first["true"].max())
+    for ax, (title, model) in zip(axes.ravel(), panels):
+        image = ax.imshow(model, origin="lower", extent=extent, cmap="viridis",
+                          vmin=limits[0], vmax=limits[1], aspect="equal")
+        ax.plot([s[1] for s in sources], [s[0] for s in sources], "r*", ms=6)
+        ax.set_title(title)
+        ax.set_xlabel("x (km)")
+        ax.set_ylabel("z (km)")
+    for ax in axes.ravel()[len(panels):]:
+        ax.axis("off")
+    fig.colorbar(image, ax=axes, label="velocity (km/s)", shrink=0.6)
+    file = root / "comparison_models.png"
+    fig.savefig(file, dpi=130)
+    return file
+
+
+def plot_history(root: Path, cases: dict) -> Path:
+    """Misfit and degrees of freedom along the iterations of the cases.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Directory of the cases.
+    cases : dict
+        Output of :func:`load`.
+
+    Returns
+    -------
+    pathlib.Path
+        File of the figure.
+    """
+    colors = {"cpw": "C0", "gradient": "C2", "adjoint": "C3"}
+    fig, (top, bottom) = plt.subplots(2, 1, figsize=(8, 7), sharex=True,
+                                      constrained_layout=True)
+    for name, case in cases.items():
+        strategy, mode = name.split("_")
+        history = case["report"]["history"]
+        iteration = [h["iteration"] for h in history]
+        style = dict(color=colors[strategy], ls="-" if mode == "update" else "--",
+                     label=name)
+        top.semilogy(iteration, [h["J"] for h in history], marker=".", **style)
+        bottom.step(iteration, [h["dofs"] for h in history], where="post", **style)
+    top.set_ylabel("J on the mesh of the iteration")
+    top.legend(ncol=2, fontsize=8)
+    top.grid(alpha=0.3)
+    bottom.set_ylabel("degrees of freedom")
+    bottom.set_xlabel("iteration")
+    bottom.grid(alpha=0.3)
+    file = root / "comparison_history.png"
+    fig.savefig(file, dpi=130)
+    return file
+
+
+def main() -> None:
+    """Write the table and the figures of the directory of the command line.
+
+    Returns
+    -------
+    None
+        The files are written in that directory.
+    """
+    root = Path(sys.argv[1])
+    cases = load(root)
+    if not cases:
+        raise SystemExit(f"No finished case in {root}.")
+    table = write_table(root, cases)
+    print(table.read_text())
+    for file in (table, plot_models(root, cases), plot_history(root, cases)):
+        print(file)
+
+
+if __name__ == "__main__":
+    main()
