+++ b/demos/mesh_adaptive_fwi/compare_circle_protocol.py
@@ -0,0 +1,395 @@
+"""Tables and figures of the comparison protocol of ``run_circle_protocol.sh``.
+
+It reads the results of ``run_marmousi_protocol.sh`` too: the errors are
+then measured in the region of ``model_region.npy`` (below the sea floor and
+outside the pad), and the table has the shallow and deep errors instead of
+those inside and outside the disc. ``--reference`` is for the circle only.
+
+Usage::
+
+    python compare_circle_protocol.py <protocol directory>
+    mpiexec -n 3 python compare_circle_protocol.py <protocol directory> --reference
+
+The first form reads ``seed<k>/<case>/`` and writes, in the protocol
+directory:
+
+- ``protocol.md``: per case, the mean and the standard deviation over the
+  seeds of the iterations, the model errors (whole square, inside and outside
+  the disc), the fraction of the band-limited recoverable gap closed, the
+  distance to the oracle model, the work, the wall time and the final audit;
+  then the paired differences between cases (same noise realization), with
+  a 95 % confidence interval;
+- ``protocol_oracle.png``: distance of each case's model to the oracle's at
+  the same iteration;
+- ``protocol_cost.png``: model error against wall time.
+
+The second form evaluates the final model of every case on a common
+reference discretization (the mesh of the data refined once, at a quarter of
+the usual time step) against the noise-free data, and writes
+``reference_misfit.json``, which the first form then adds to the table: the
+misfits of the cases are otherwise measured on their own meshes and cannot be
+compared.
+
+AI assistance: written by Claude (Anthropic), reviewed by the author.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+# This checkout of spyro, not an installed one, and the demo next to it.
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+CASES = ["oracle", "uniform", "undersized", "cpw_fixed", "cpw_update",
+         "gradient_fixed", "gradient_update", "adjoint_fixed", "adjoint_update",
+         "restart_control"]
+#: Paired comparisons: (case, reference case).
+PAIRS = [("cpw_update", "cpw_fixed"), ("gradient_update", "gradient_fixed"),
+         ("adjoint_update", "adjoint_fixed"), ("adjoint_update", "restart_control"),
+         ("restart_control", "adjoint_fixed"), ("adjoint_fixed", "uniform"),
+         ("adjoint_update", "uniform"), ("undersized", "uniform"),
+         ("uniform", "oracle")]
+#: Two-sided 97.5 % quantiles of Student's t, by degrees of freedom.
+T_975 = {1: 12.71, 2: 4.303, 3: 3.182, 4: 2.776, 5: 2.571, 6: 2.447, 7: 2.365,
+         8: 2.306, 9: 2.262, 10: 2.228}
+
+
+def load(root: Path) -> dict:
+    """Every finished case of every seed.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Protocol directory.
+
+    Returns
+    -------
+    dict
+        ``{seed: {case: {"summary", "report", "models"}}}``, with the models
+        of the iterations in order.
+    """
+    runs = {}
+    for seed_dir in sorted(root.glob("seed*")):
+        seed = int(seed_dir.name[4:])
+        for case in CASES:
+            folder = seed_dir / case
+            if not (folder / "summary.json").exists():
+                continue
+            models = sorted(folder.glob("model_iter*.npy"))
+            runs.setdefault(seed, {})[case] = {
+                "summary": json.loads((folder / "summary.json").read_text()),
+                "report": json.loads((folder / "report_fwi.json").read_text()),
+                "models": [np.load(m) for m in models],
+                "true": np.load(folder / "model_true.npy"),
+                "region": (np.load(folder / "model_region.npy")
+                           if (folder / "model_region.npy").exists() else None)}
+    return runs
+
+
+def rms(a: np.ndarray, b: np.ndarray, region: np.ndarray | None = None) -> float:
+    """Root mean square difference.
+
+    Parameters
+    ----------
+    a, b : numpy.ndarray
+        Models on the grid.
+    region : numpy.ndarray or None, optional
+        Mask of the values compared; ``None`` (the default) compares all.
+
+    Returns
+    -------
+    float
+        :math:`\\sqrt{\\mathrm{mean}((a - b)^2)}` over the region.
+    """
+    difference = a - b if region is None else (a - b)[region]
+    return float(np.sqrt(np.mean(difference ** 2)))
+
+
+def metrics(run: dict, oracle: dict | None, reference: dict) -> dict:
+    """Numbers of one case of one seed.
+
+    Parameters
+    ----------
+    run : dict
+        The case (see :func:`load`).
+    oracle : dict or None
+        The oracle case of the same seed.
+    reference : dict
+        Misfits on the reference discretization, by case directory.
+
+    Returns
+    -------
+    dict
+        The metrics of the table.
+    """
+    summary, events = run["summary"], run["report"]["events"]
+    final = run["models"][-1]
+    values = {
+        "iterations": summary["iterations"],
+        "rms": summary["model_rms_error_final"],
+        "gap_closed": summary["recoverable_gap_closed"],
+        "work": summary["work_dof_steps"],
+        "minutes": summary["elapsed_s"] / 60.0,
+        "restarts": summary.get("tao_restarts", 1) - 1,
+        "final_ratio": summary.get("final_audit_worst_ratio") or math.nan,
+        "stopped_by_discrepancy": float(any(
+            e["event"] == "discrepancy" or e.get("reason") == "discrepancy"
+            for e in events)),
+    }
+    # Regional errors: the disc of the circle, or the depth of the Marmousi.
+    for column, key in (("rms_inside", "model_rms_error_inside_disc"),
+                        ("rms_outside", "model_rms_error_outside_disc"),
+                        ("rms_shallow", "model_rms_error_shallow"),
+                        ("rms_deep", "model_rms_error_deep")):
+        if key in summary:
+            values[column] = summary[key]
+    if oracle is not None:
+        values["to_oracle"] = rms(final, oracle["models"][-1], run["region"])
+    if run["dir"] in reference:
+        values["J_reference"] = reference[run["dir"]]
+    return values
+
+
+def mean_std(samples: list[float]) -> tuple[float, float]:
+    """Mean and sample standard deviation.
+
+    Parameters
+    ----------
+    samples : list of float
+        Values over the seeds.
+
+    Returns
+    -------
+    tuple of float
+        Mean and standard deviation (NaN with fewer than two values).
+    """
+    data = np.array(samples, dtype=float)
+    std = float(data.std(ddof=1)) if len(data) > 1 else math.nan
+    return float(data.mean()), std
+
+
+def write_tables(root: Path, runs: dict, reference: dict) -> Path:
+    """Write ``protocol.md``.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Protocol directory.
+    runs : dict
+        See :func:`load`.
+    reference : dict
+        Misfits on the reference discretization.
+
+    Returns
+    -------
+    pathlib.Path
+        The file written.
+    """
+    table = {}
+    for seed, cases in runs.items():
+        for case, run in cases.items():
+            run["dir"] = f"seed{seed}/{case}"
+            table.setdefault(case, {})[seed] = metrics(run, cases.get("oracle"),
+                                                       reference)
+    columns = ["iterations", "rms", "rms_inside", "rms_outside", "rms_shallow",
+               "rms_deep", "gap_closed",
+               "to_oracle", "J_reference", "work", "minutes", "restarts",
+               "final_ratio", "stopped_by_discrepancy"]
+    lines = ["# Comparison protocol: circle of Firedrake's FWI demo", "",
+             f"Seeds: {sorted(runs)}. Mean ± standard deviation over the seeds "
+             "(n per case in the first column).", "",
+             "| case (n) | " + " | ".join(columns) + " |",
+             "|---" * (len(columns) + 1) + "|"]
+    for case in CASES:
+        if case not in table:
+            continue
+        cells = []
+        for column in columns:
+            samples = [m[column] for m in table[case].values() if column in m]
+            if not samples:
+                cells.append("")
+                continue
+            mean, std = mean_std(samples)
+            scale = "{:.3e}" if column in ("work", "J_reference") else "{:.4g}"
+            cells.append(scale.format(mean) + ("" if math.isnan(std)
+                                               else " ± " + scale.format(std)))
+        lines.append(f"| {case} ({len(table[case])}) | " + " | ".join(cells) + " |")
+    lines += ["", "## Paired differences (same noise realization)", "",
+              "Difference of the final model error, case minus reference; "
+              "95 % interval from Student's t. The effect in units of the "
+              "standard deviation of the differences is the paired effect "
+              "size.", "",
+              "| case − reference | n | mean (km/s) | sd | 95 % interval | effect (sd) |",
+              "|---|---|---|---|---|---|"]
+    for case, base in PAIRS:
+        seeds = sorted(set(table.get(case, {})) & set(table.get(base, {})))
+        if not seeds:
+            continue
+        differences = [table[case][s]["rms"] - table[base][s]["rms"] for s in seeds]
+        mean, std = mean_std(differences)
+        if len(seeds) > 1:
+            half = T_975.get(len(seeds) - 1, 1.96) * std / math.sqrt(len(seeds))
+            interval = f"[{mean - half:.4f}, {mean + half:.4f}]"
+            effect = f"{mean / std:.2f}" if std > 0 else ""
+        else:
+            interval = effect = ""
+        lines.append(f"| {case} − {base} | {len(seeds)} | {mean:.4f} | "
+                     f"{'' if math.isnan(std) else f'{std:.4f}'} | {interval} | {effect} |")
+    path = root / "protocol.md"
+    path.write_text("\n".join(lines) + "\n")
+    return path
+
+
+def plot(root: Path, runs: dict) -> list[Path]:
+    """Distance to the oracle by iteration, and error against wall time.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Protocol directory.
+    runs : dict
+        See :func:`load`.
+
+    Returns
+    -------
+    list of pathlib.Path
+        The figures written.
+    """
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    colours = plt.get_cmap("tab10")
+    paths = []
+    figure, axis = plt.subplots(figsize=(7, 4.5))
+    for index, case in enumerate(CASES[1:]):
+        for seed, cases in runs.items():
+            if case not in cases or "oracle" not in cases:
+                continue
+            oracle = cases["oracle"]["models"]
+            models = cases[case]["models"]
+            steps = min(len(oracle), len(models))
+            region = cases[case]["region"]
+            axis.plot(range(steps), [rms(models[k], oracle[k], region)
+                                     for k in range(steps)],
+                      color=colours(index), alpha=0.8,
+                      label=case if seed == min(runs) else None)
+    axis.set_xlabel("iteration")
+    axis.set_ylabel("RMS of the model minus the oracle's (km/s)")
+    axis.legend(fontsize=7)
+    figure.tight_layout()
+    paths.append(root / "protocol_oracle.png")
+    figure.savefig(paths[-1], dpi=150)
+    plt.close(figure)
+
+    figure, axis = plt.subplots(figsize=(7, 4.5))
+    for index, case in enumerate(CASES):
+        for seed, cases in runs.items():
+            if case not in cases:
+                continue
+            run = cases[case]
+            times = [0.0] + [e["elapsed_s"] / 60.0 for e in run["report"]["events"]
+                             if e["event"] == "iterate"]
+            steps = min(len(times), len(run["models"]))
+            axis.plot(times[:steps], [rms(m, run["true"], run["region"])
+                                      for m in run["models"][:steps]],
+                      color=colours(index), alpha=0.8,
+                      label=case if seed == min(runs) else None)
+    axis.set_xlabel("wall time (min)")
+    axis.set_ylabel("model RMS error (km/s)")
+    axis.legend(fontsize=7)
+    figure.tight_layout()
+    paths.append(root / "protocol_cost.png")
+    figure.savefig(paths[-1], dpi=150)
+    plt.close(figure)
+    return paths
+
+
+def reference_misfits(root: Path) -> None:
+    """Misfit of every final model on the reference discretization.
+
+    Run under MPI with one process per shot. The reference is the mesh of
+    the data refined once, at a quarter of the usual time step, against the
+    noise-free data.
+
+    Parameters
+    ----------
+    root : pathlib.Path
+        Protocol directory.
+
+    Returns
+    -------
+    None
+        ``reference_misfit.json`` is written by the first process.
+    """
+    import firedrake as fire
+
+    import circle_fwi
+    from spyro.adaptivity import (EnsembleFWIFunctional, FWIFunctional,
+                                  ObservedData, TraceOperator)
+
+    first = next(root.glob("seed*/*/summary.json"))
+    data_file = Path(json.loads(first.read_text())["data"])
+    stored = np.load(data_file)
+    settings = argparse.Namespace(frequency=float(stored["frequency"]),
+                                  final_time=float(stored["final_time"]),
+                                  degree=int(stored["degree"]),
+                                  grid_spacing=1.0 / circle_fwi.DEMO_CELLS)
+    observed = ObservedData(list(stored["records"]), float(stored["dt"]))
+    domain, _, _ = circle_fwi.geometry()
+    ensemble = fire.Ensemble(fire.COMM_WORLD, 1)
+    grid, _, initial = circle_fwi.grid_models(settings, domain, ensemble.comm)
+    local = FWIFunctional(circle_fwi.model_dictionary(settings, domain),
+                          str(data_file.with_suffix(".msh")), grid, initial,
+                          observed, TraceOperator(), circle_fwi.DISC,
+                          dt_fraction=0.35, ensemble=ensemble, refinements=1,
+                          # Only the misfit is needed: storing the forward
+                          # states of the refined mesh ran out of 16 GiB.
+                          store_forward=False)
+    functional = EnsembleFWIFunctional(local, ensemble)
+    values = {}
+    for folder in sorted(root.glob("seed*/*")):
+        if not (folder / "summary.json").exists():
+            continue
+        model = np.load(sorted(folder.glob("model_iter*.npy"))[-1])
+        values[f"{folder.parent.name}/{folder.name}"] = float(
+            functional(grid.function(model)))
+        fire.PETSc.Sys.Print(f"[reference] {folder}: {values[str(folder.relative_to(root))]:.4e}")
+    if fire.COMM_WORLD.rank == 0:
+        (root / "reference_misfit.json").write_text(json.dumps(values, indent=1))
+
+
+def main() -> None:
+    """Write the tables and figures, or the reference misfits.
+
+    Returns
+    -------
+    None
+        See the module's docstring.
+    """
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    parser.add_argument("root", type=Path)
+    parser.add_argument("--reference", action="store_true",
+                        help="evaluate the final models on the reference "
+                             "discretization (under MPI, one process per shot)")
+    args = parser.parse_args()
+    if args.reference:
+        reference_misfits(args.root)
+        return
+    runs = load(args.root)
+    reference_file = args.root / "reference_misfit.json"
+    reference = (json.loads(reference_file.read_text())
+                 if reference_file.exists() else {})
+    print(write_tables(args.root, runs, reference))
+    for path in plot(args.root, runs):
+        print(path)
+
+
+if __name__ == "__main__":
+    main()
